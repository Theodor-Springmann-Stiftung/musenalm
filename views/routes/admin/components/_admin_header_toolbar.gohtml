{{- $isNew := index . "is_new" -}}
{{- $actions := index . "actions" -}}
{{- $prevHref := index . "prev_href" -}}
{{- $prevLabel := index . "prev_label" -}}
{{- $nextHref := index . "next_href" -}}
{{- $nextLabel := index . "next_label" -}}
{{- $showAZNav := index . "show_az_nav" -}}
{{- $headerDataID := index . "header_data_id" -}}
{{- $dbID := index . "db_id" -}}
{{- $musenalmID := index . "musenalm_id" -}}
{{- $updated := index . "updated" -}}
{{- $editorUser := index . "editor_user" -}}
{{- $prevMusenalmHref := index . "prev_musenalm_href" -}}
{{- $prevMusenalmLabel := index . "prev_musenalm_label" -}}
{{- $nextMusenalmHref := index . "next_musenalm_href" -}}
{{- $nextMusenalmLabel := index . "next_musenalm_label" -}}
{{- $hasActions := gt (len $actions) 0 -}}

{{- if or $hasActions (and (not $isNew) $showAZNav) (not $isNew) -}}
	<div class="admin-list-toolbar">
		<div class="admin-list-toolbar-primary simple-entity-header-actions">
			{{- range $action := $actions -}}
				{{- $tooltip := index $action "tooltip" -}}
				{{- $label := index $action "label" -}}
				{{- $badge := index $action "badge" -}}
				{{- $iconClass := "simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip" -}}
				{{- if $label -}}
					{{- $iconClass = "simple-entity-header-button simple-entity-header-chip" -}}
				{{- end -}}
				{{- if index $action "disabled" -}}
					<span class="{{ $iconClass }} simple-entity-header-chip-disabled" aria-label="{{ $tooltip }}" aria-disabled="true">
						<i class="{{ index $action "icon" }}"></i>
						{{- if $label -}}
							<span>{{ $label }}</span>
						{{- end -}}
						{{- if $badge -}}
							<span class="admin-list-badge">{{ $badge }}</span>
						{{- end -}}
					</span>
				{{- else -}}
					<span class="inline" data-tippy-placement="top" data-tippy-content='{{ $tooltip }}'>
						<a
							href="{{ index $action "href" }}"
							class="{{ $iconClass }}"
							{{- if index $action "target_blank" }} target="_blank" rel="noopener"{{- end -}}
							aria-label="{{ $tooltip }}">
							<i class="{{ index $action "icon" }}"></i>
							{{- if $label -}}
								<span>{{ $label }}</span>
							{{- end -}}
							{{- if $badge -}}
								<span class="admin-list-badge">{{ $badge }}</span>
							{{- end -}}
						</a>
					</span>
				{{- end -}}
			{{- end -}}
			{{- if and (not $isNew) $showAZNav -}}
				{{- if $prevHref -}}
					<span class="inline" data-tippy-placement="top" data-tippy-content='{{ $prevLabel }}'>
						<a href="{{ $prevHref }}" class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip" aria-label="Vorheriger Eintrag">
							<i class="ri-arrow-left-s-line"></i>
						</a>
					</span>
				{{- else -}}
					<span class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip simple-entity-header-chip-disabled" aria-hidden="true">
						<i class="ri-arrow-left-s-line"></i>
					</span>
				{{- end -}}
				<span class="simple-entity-header-az">A&thinsp;&ndash;&thinsp;Z</span>
				{{- if $nextHref -}}
					<span class="inline" data-tippy-placement="top" data-tippy-content='{{ $nextLabel }}'>
						<a href="{{ $nextHref }}" class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip" aria-label="Nächster Eintrag">
							<i class="ri-arrow-right-s-line"></i>
						</a>
					</span>
				{{- else -}}
					<span class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip simple-entity-header-chip-disabled" aria-hidden="true">
						<i class="ri-arrow-right-s-line"></i>
					</span>
				{{- end -}}
			{{- end -}}
		</div>

		{{- if not $isNew -}}
			<div class="admin-list-toolbar-secondary simple-entity-meta-inline"{{ if $headerDataID }} id="{{ $headerDataID }}"{{ end }}>
				<span class="simple-entity-meta-item">
					{{- if $prevMusenalmHref -}}
						<span class="inline" data-tippy-placement="top" data-tippy-content='{{ $prevMusenalmLabel }}'>
							<a href="{{ $prevMusenalmHref }}" class="simple-entity-meta-nav" aria-label="Vorherige Musenalm-ID">
								<i class="ri-arrow-left-s-line"></i>
							</a>
						</span>
					{{- else -}}
						<span class="simple-entity-meta-nav simple-entity-meta-nav-disabled" aria-hidden="true">
							<i class="ri-arrow-left-s-line"></i>
						</span>
					{{- end -}}
					<span class="inline" data-tippy-placement="top" data-tippy-content="Musenalm-ID">
						<span class="simple-entity-meta-icon" aria-hidden="true">
							<i class="ri-fingerprint-line"></i>
						</span>
					</span>
					<span class="simple-entity-meta-item-value tabular-nums">{{ $musenalmID }}</span>
					{{- if $nextMusenalmHref -}}
						<span class="inline" data-tippy-placement="top" data-tippy-content='{{ $nextMusenalmLabel }}'>
							<a href="{{ $nextMusenalmHref }}" class="simple-entity-meta-nav" aria-label="Nächste Musenalm-ID">
								<i class="ri-arrow-right-s-line"></i>
							</a>
						</span>
					{{- else -}}
						<span class="simple-entity-meta-nav simple-entity-meta-nav-disabled" aria-hidden="true">
							<i class="ri-arrow-right-s-line"></i>
						</span>
					{{- end -}}
				</span>
				<span class="simple-entity-meta-sep">|</span>
				<span class="simple-entity-meta-item">
					<span class="inline" data-tippy-placement="top" data-tippy-content="Datenbank-ID">
						<span class="simple-entity-meta-icon" aria-hidden="true">
							<i class="ri-database-2-line"></i>
						</span>
					</span>
					<span class="simple-entity-meta-item-value tabular-nums">{{ $dbID }}</span>
				</span>
				<span class="simple-entity-meta-sep">|</span>
				<span class="simple-entity-meta-item items-end">
					<span class="inline" data-tippy-placement="top" data-tippy-content="Zuletzt bearbeitet">
						<span class="simple-entity-meta-icon" aria-hidden="true">
							<i class="ri-calendar-line"></i>
						</span>
					</span>
					<span class="flex flex-col text-left leading-tight">
						<span class="simple-entity-meta-item-value tabular-nums">{{ GermanShortDateTime $updated }}</span>
						{{- if $editorUser -}}
							<span class="simple-entity-meta-item-value">{{ $editorUser.Name }}</span>
						{{- end -}}
					</span>
				</span>
			</div>
		{{- end -}}
	</div>
{{- end -}}
