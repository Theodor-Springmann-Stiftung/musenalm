{{ $updated := .updated }}
{{ $editorUser := .editor_user }}
{{ $comment := .comment }}

<div class="admin-list-meta flex flex-col gap-1.5">
	{{- if or $updated $editorUser -}}
		<div>
			<div class="text-base font-semibold text-gray-500">Bearbeitet</div>
			{{- if $updated -}}
				<div class="tabular-nums mt-0.5 font-medium text-slate-800">{{ GermanShortDateTime $updated }}</div>
			{{- end -}}
			{{- if $editorUser -}}
				<div class="font-semibold text-slate-900">{{ $editorUser.Name }}</div>
			{{- end -}}
		</div>
	{{- end -}}
	{{- if $comment -}}
		<div>
			<div class="text-base font-semibold text-gray-500">Vermerk</div>
			<div class="annotation-content mt-0.5 hyphens-auto font-sans text-base leading-snug italic text-gray-700">{{- Safe (ReplaceSlashParen $comment) -}}</div>
		</div>
	{{- end -}}
</div>
