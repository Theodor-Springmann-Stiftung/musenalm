{{ $model := . }}

<div x-data="{
	search: '{{ $model.search }}',
	offset: {{ if $model.next_offset }}{{ $model.next_offset }}{{ else }}0{{ end }},
	hasMore: {{ if $model.has_more }}true{{ else }}false{{ end }},
	loading: false,
	alphabetOpen: false,
	searchOpen: false,
	selectedLetter: '{{ $model.letter }}',
	corp: '{{ $model.corp }}',
	profession: '{{ $model.profession }}',
	professionLabels: {
		{{- range $k, $v := $model.filter_profession_labels -}}
		{{ printf "%q" $k }}: {{ printf "%q" $v }},
		{{- end -}}
	},
	appendFilters(params) {
		if (this.corp) params.set('corp', this.corp);
		if (this.profession) params.set('profession', this.profession);
	},
	buildResultsUrl(overrides = {}) {
		const params = new URLSearchParams();
		const next = {
			search: this.search,
			letter: this.selectedLetter,
			corp: this.corp,
			profession: this.profession,
			offset: 0,
			...overrides,
		};
		Object.entries(next).forEach(([key, value]) => {
			if (value !== '' && value !== null && value !== undefined) {
				params.set(key, value);
			}
		});
		return `/admin/personen/results/?${params.toString()}`;
	},
	buildPageUrl(overrides = {}) {
		const params = new URLSearchParams();
		const next = {
			search: this.search,
			letter: this.selectedLetter,
			corp: this.corp,
			profession: this.profession,
			offset: this.offset,
			...overrides,
		};
		Object.entries(next).forEach(([key, value]) => {
			if (value !== '' && value !== null && value !== undefined) {
				params.set(key, value);
			}
		});
		const query = params.toString();
		return query ? `/admin/personen/?${params.toString()}` : '/admin/personen/';
	},
	applyFilter(overrides = {}, indicator = 'body', sourceEl = null) {
		Object.entries(overrides).forEach(([key, value]) => {
			this[key] = value;
		});
		this.offset = 0;
		this.hasMore = true;
		htmx.ajax('GET', this.buildResultsUrl(), {
			target: '#personen-admin-results',
			swap: 'outerHTML',
			indicator,
			source: sourceEl || (indicator && document.querySelector(indicator)) || undefined,
		});
	},
	clearFilters() {
		this.corp = '';
		this.profession = '';
	},
	clearAllFilters(sourceEl = null) {
		this.clearFilters();
		this.search = '';
		this.selectedLetter = '';
		this.searchOpen = false;
		this.offset = 0;
		this.hasMore = true;
		htmx.ajax('GET', this.buildResultsUrl({
			search: '',
			letter: '',
			corp: '',
			profession: '',
			offset: 0,
		}), {
			target: '#personen-admin-results',
			swap: 'outerHTML',
			source: sourceEl || undefined,
		});
	},
	openSearch() {
		this.searchOpen = true;
		this.$nextTick(() => this.$refs.personenAdminSearchInput?.focus());
	},
	closeOtherDropdowns(current) {
		const scope = current?.closest('.admin-page-shell') || document;
		scope.querySelectorAll('details').forEach((d) => {
			if (d !== current) d.open = false;
		});
	},
	updateUrl() {
		const params = new URLSearchParams();
		params.set('offset', this.offset);
		this.appendFilters(params);
		if (this.search) params.set('search', this.search);
		if (this.selectedLetter) params.set('letter', this.selectedLetter);
		const query = params.toString();
		const newUrl = query ? `/admin/personen/?${query}` : '/admin/personen/';
		window.history.replaceState(null, '', newUrl);
	},
	loadMoreUrl() {
		const params = new URLSearchParams();
		params.set('offset', this.offset);
		this.appendFilters(params);
		if (this.search) params.set('search', this.search);
		if (this.selectedLetter) params.set('letter', this.selectedLetter);
		return `/admin/personen/more/?${params.toString()}`;
	}
}"
@htmx:after-swap.window="
	if ($event.detail.target && $event.detail.target.id === 'personen-admin-results') {
		const responseUrl = $event.detail.xhr?.responseURL || window.location.href;
		const params = new URL(responseUrl).searchParams;
		corp = params.get('corp') || '';
		profession = params.get('profession') || '';
		search = params.get('search') || '';
		selectedLetter = params.get('letter') || '';
		updateUrl();
	}
"
class="admin-page-shell font-sans pt-0 pb-8">
	<header class="admin-page-header">
		<div class="admin-page-heading">
			<div class="flex w-full flex-wrap items-start justify-between gap-x-4 gap-y-3">
				<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
					<h1 class="admin-page-title">Personen &amp; K&ouml;rperschaften</h1>
					<button
						type="button"
						x-cloak
						x-show="search || selectedLetter || corp || profession"
						@click="clearAllFilters($el)"
						class="inline-flex items-center gap-1.5 rounded-md bg-orange-100 px-2 py-0.75 text-[0.85rem] font-semibold text-orange-800 transition-colors hover:bg-orange-200">
						<i class="ri-filter-off-line text-sm"></i>
						<span>Alle anzeigen</span>
					</button>
				</div>
				{{- if (IsAdminOrEditor $model.request.user) -}}
					<a href="/admin/personen/new/" class="inline-flex items-center gap-1.5 rounded-xs bg-slate-800 px-3 py-1.5 font-sans text-[0.98rem] font-semibold text-stone-50 no-underline transition-colors hover:bg-slate-900 hover:text-white">
						<i class="ri-add-line"></i>
						<span>Neu</span>
					</a>
				{{- end -}}
			</div>
		</div>
		<div class="mt-5 flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
			<div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-2 gap-y-3" hx-boost="false">
				<div class="relative">
					<details class="font-sans text-base list-none" data-role="personen-admin-alphabet-toggle" @toggle="alphabetOpen = $el.open; if ($el.open) { closeOtherDropdowns($el); }">
						<summary class="cursor-pointer select-none rounded-md bg-gray-100 px-3 py-1.5 text-gray-700 hover:text-slate-900 flex items-center gap-2"
							:class="selectedLetter ? 'font-semibold text-slate-900 ring-1 ring-slate-300' : ''">
							<span x-text="selectedLetter ? `Alphabet: ${selectedLetter}` : 'Alphabet'"></span>
							<i class="ri-arrow-down-s-line transform origin-center transition-transform" :class="{ 'rotate-180': alphabetOpen }"></i>
							<span id="personen-admin-alphabet-spinner" class="htmx-indicator text-slate-900">
								<i class="ri-loader-4-line spinning" aria-hidden="true"></i>
							</span>
						</summary>
						<div class="absolute left-0 z-10 mt-2 rounded-md border border-gray-200 bg-white shadow-lg">
							<div class="w-[26rem] p-2">
								<a :href="buildPageUrl({ letter: '', offset: 0 })"
								   hx-indicator="#personen-admin-alphabet-spinner"
								   @click.prevent="alphabetOpen = false; $el.closest('details').open = false; applyFilter({ selectedLetter: '' }, '#personen-admin-alphabet-spinner', $el)"
								   x-show="selectedLetter"
								   class="mb-2 inline-flex w-full items-center justify-center gap-2 rounded bg-orange-100 px-2 py-1 text-sm font-semibold text-orange-800 hover:bg-orange-200 no-underline transition-colors">
									<i class="ri-filter-off-line text-base"></i>
									<span>Alle</span>
								</a>
								<div class="grid grid-cols-13 gap-1 text-sm text-gray-700" x-effect="
									const active = selectedLetter || '';
									$el.querySelectorAll('[data-letter]').forEach((el) => {
										const isActive = el.dataset.letter === active;
										el.classList.toggle('bg-stone-200', isActive);
										el.classList.toggle('font-bold', isActive);
									});
								">
									{{- range $_, $ch := $model.letters -}}
										<a :href="buildPageUrl({ letter: '{{ $ch }}', offset: 0 })"
										   hx-indicator="#personen-admin-alphabet-spinner"
										   @click.prevent="alphabetOpen = false; $el.closest('details').open = false; applyFilter({ selectedLetter: '{{ $ch }}' }, '#personen-admin-alphabet-spinner', $el)"
										   data-letter="{{ $ch }}"
										   class="rounded px-2 py-1 text-center hover:bg-gray-100 no-underline transition-colors">
											{{ $ch }}
										</a>
									{{- end -}}
								</div>
							</div>
						</div>
					</details>
				</div>

				<div class="relative" x-data="{ open: false }">
					<details class="font-sans text-base list-none" @toggle="open = $el.open; if ($el.open) { closeOtherDropdowns($el); }">
						<summary class="cursor-pointer select-none rounded-md bg-gray-100 px-3 py-1.5 text-gray-700 hover:text-slate-900 flex items-center gap-2"
							:class="corp ? 'font-semibold text-slate-900 ring-1 ring-slate-300' : ''">
							<span x-text="corp === 'org' ? 'Körperschaft: Ja' : corp === 'person' ? 'Körperschaft: Nein' : 'Körperschaft'"></span>
							<i class="ri-arrow-down-s-line transform origin-center transition-transform" :class="{ 'rotate-180': open }"></i>
						</summary>
						<div class="absolute left-0 z-10 mt-2 w-56 rounded-md border border-gray-200 bg-white shadow-lg">
							<div class="flex flex-col gap-1 p-3 text-sm text-gray-700">
								<button
									type="button"
									x-show="corp"
									@click="open = false; $el.closest('details').open = false; applyFilter({ corp: '' }, 'body', $el)"
									class="mb-2 inline-flex w-full items-center justify-center gap-2 rounded bg-orange-100 px-2 py-1 text-sm font-semibold text-orange-800 hover:bg-orange-200 transition-colors">
									<i class="ri-filter-off-line text-base"></i>
									<span>Alle</span>
								</button>
								<button
									type="button"
									@click="open = false; $el.closest('details').open = false; applyFilter({ corp: 'person' }, 'body', $el)"
									:class="corp === 'person' ? 'bg-stone-100 font-semibold' : ''"
									class="rounded-sm px-2 py-1 text-left hover:bg-stone-100">
									Nur Personen
								</button>
								<button
									type="button"
									@click="open = false; $el.closest('details').open = false; applyFilter({ corp: 'org' }, 'body', $el)"
									:class="corp === 'org' ? 'bg-stone-100 font-semibold' : ''"
									class="rounded-sm px-2 py-1 text-left hover:bg-stone-100">
									Nur K&ouml;rperschaften
								</button>
							</div>
						</div>
					</details>
				</div>

				<div class="relative" x-data="{ open: false }">
					<details class="font-sans text-base list-none" @toggle="open = $el.open; if ($el.open) { closeOtherDropdowns($el); }">
						<summary class="cursor-pointer select-none rounded-md bg-gray-100 px-3 py-1.5 text-gray-700 hover:text-slate-900 flex items-center gap-2"
							:class="profession ? 'font-semibold text-slate-900 ring-1 ring-slate-300' : ''">
							<span x-text="profession ? `Beruf: ${professionLabels[profession] || profession}` : 'Beruf'"></span>
							<i class="ri-arrow-down-s-line transform origin-center transition-transform" :class="{ 'rotate-180': open }"></i>
						</summary>
						<div class="absolute left-0 z-10 mt-2 w-56 rounded-md border border-gray-200 bg-white shadow-lg">
							<div class="flex flex-col gap-1 p-3 text-sm text-gray-700">
								<button
									type="button"
									x-show="profession"
									@click="open = false; $el.closest('details').open = false; applyFilter({ profession: '' }, 'body', $el)"
									class="mb-2 inline-flex w-full items-center justify-center gap-2 rounded bg-orange-100 px-2 py-1 text-sm font-semibold text-orange-800 hover:bg-orange-200 transition-colors">
									<i class="ri-filter-off-line text-base"></i>
									<span>Alle</span>
								</button>
								{{- range $_, $filter := $model.filter_professions -}}
									<button
										type="button"
										@click="open = false; $el.closest('details').open = false; applyFilter({ profession: '{{ $filter.Value }}' }, 'body', $el)"
										:class="profession === '{{ $filter.Value }}' ? 'bg-stone-100 font-semibold' : ''"
										class="rounded-sm px-2 py-1 text-left hover:bg-stone-100">
										{{ $filter.Label }}
									</button>
								{{- end -}}
							</div>
						</div>
					</details>
				</div>

				<div class="relative" @click.outside="searchOpen = false">
					<button
						type="button"
						x-cloak
						x-show="!searchOpen"
						@click="openSearch()"
						class="cursor-pointer select-none rounded-md bg-gray-100 px-3 py-1.5 text-gray-700 hover:text-slate-900 flex items-center gap-2"
						:class="search ? 'font-semibold text-slate-900 ring-1 ring-slate-300' : ''">
						<span class="max-w-[18rem] truncate" x-text="search ? `Suche: ${search}` : 'Suche'"></span>
						<i class="ri-search-line"></i>
					</button>

					<form
						x-cloak
						x-show="searchOpen"
						method="GET"
						action="/admin/personen/"
						hx-get="/admin/personen/results/"
						hx-push-url="false"
						hx-swap="outerHTML"
						hx-target="#personen-admin-results"
						role="search"
						@submit="searchOpen = false; offset = 0; hasMore = true"
						@keydown.escape.prevent.stop="searchOpen = false"
						aria-label="Personensuche"
						class="flex min-w-[18rem] max-w-[24rem] items-center gap-2 rounded-md bg-gray-100 px-3 py-1.5">
						<input type="hidden" name="corp" :value="corp" />
						<input type="hidden" name="profession" :value="profession" />
						<input type="hidden" name="letter" :value="selectedLetter" />
						<div class="relative min-w-0 flex-1">
							<input
								x-ref="personenAdminSearchInput"
								class="search-input-no-native-clear w-full bg-transparent pr-7 font-sans text-base text-slate-900 placeholder:italic focus:outline-none"
								type="search"
								name="search"
								value="{{ $model.search }}"
								placeholder="Name oder Suchbegriff"
								x-model="search"
								autocomplete="off" />
						</div>
						<button
							type="button"
							@click="
								search = '';
								searchOpen = false;
								offset = 0;
								hasMore = true;
								htmx.ajax('GET', buildResultsUrl({ search: '' }), {
									target: '#personen-admin-results',
									swap: 'outerHTML',
									source: $el,
								});
							"
							class="text-gray-500 hover:text-slate-900"
							aria-label="Suche leeren">
							<i class="ri-close-line"></i>
						</button>
						<button x-show="false">Suchen</button>
					</form>
				</div>
			</div>

			<div class="flex shrink-0 items-center justify-end gap-3 self-start">
				<div class="relative" x-data="{ open: false }">
					<details class="font-sans text-base list-none" data-role="personen-admin-column-toggle" @toggle="open = $el.open; if ($el.open) { closeOtherDropdowns($el); }">
						<summary class="cursor-pointer select-none rounded-xs px-2 py-1 text-lg font-semibold font-sans text-gray-600 hover:text-slate-900 flex items-center gap-2">
							<i class="ri-eye-line"></i>
							<span>Spalten</span>
							<i class="ri-arrow-down-s-line transform origin-center transition-transform" :class="{ 'rotate-180': open }"></i>
						</summary>
						<div class="absolute right-0 z-10 mt-2 w-60 rounded-md border border-gray-200 bg-white shadow-lg">
							<div class="flex flex-col gap-2 p-4 text-sm text-gray-700">
								<label class="inline-flex items-center gap-2"><input type="checkbox" data-col="title" checked /> Name</label>
								<label class="inline-flex items-center gap-2"><input type="checkbox" data-col="profession" checked /> Beruf</label>
								<label class="inline-flex items-center gap-2"><input type="checkbox" data-col="life" checked /> Lebensdaten</label>
								<label class="inline-flex items-center gap-2"><input type="checkbox" data-col="counts" checked /> Verkn&uuml;pfungen</label>
							</div>
						</div>
					</details>
				</div>

				<div id="personen-admin-count" class="whitespace-nowrap text-lg font-semibold font-sans text-gray-600">
					{{ if $model.current_count }}{{ $model.current_count }}&thinsp;/&thinsp;{{ end }}{{ if $model.total_count }}{{ $model.total_count }}{{ else }}{{ len $model.result.Agents }}{{ end }} Personen
				</div>
			</div>
		</div>
	</header>

	<div class="admin-page-body admin-page-body-wide admin-page-body-flush pt-0">
		<div id="personen-admin-results" data-next-offset="{{ $model.next_offset }}">
			{{ template "_personen_admin_table" $model }}

			<div class="mt-6 flex justify-center" x-show="hasMore">
				<button
					type="button"
					class="content-action-button"
					:hx-get="loadMoreUrl()"
					hx-select="#personen-admin-more-rows > *"
					hx-target="#personen-admin-table-body"
					hx-swap="beforeend"
					hx-indicator="this"
					@htmx:before-request="loading = true"
					@htmx:after-request="
						loading = false;
						hasMore = $event.detail.xhr.getResponseHeader('X-Has-More') === 'true';
						const nextOffsetHeader = Number($event.detail.xhr.getResponseHeader('X-Next-Offset'));
						if (!Number.isNaN(nextOffsetHeader)) {
							offset = nextOffsetHeader;
						}
						updateUrl();
					"
					:disabled="loading">
					<i class="ri-arrow-down-line" :class="{ 'spinning': loading }"></i>
					<span x-text="loading ? 'Lädt...' : 'Weitere 80 laden'"></span>
				</button>
			</div>

			{{ if $model.search }}
				<script type="module">
					let elements = document.querySelectorAll('.agent-admin-search-text');
					let mark_instance = new Mark(elements);
					setTimeout(() => {
						mark_instance.mark('{{ $model.search }}', {
							"seperateWordSearch": true,
						});
					}, 200);
				</script>
			{{ end }}
		</div>
	</div>
</div>

<dialog data-role="personen-admin-delete-dialog" class="dbform fixed inset-0 m-auto rounded-md border border-slate-200 p-0 shadow-xl backdrop:bg-black/40">
	<div class="w-[26rem] p-5">
		<div class="text-base font-bold text-gray-900">Eintrag löschen?</div>
		<div data-role="personen-admin-delete-title" class="mt-1 text-sm font-bold text-gray-900"></div>
		<div data-role="personen-admin-delete-impacts" class="mt-2 text-sm text-gray-700">
			Lade Informationen …
		</div>
		<div data-role="personen-admin-delete-error" class="mt-2 hidden text-sm text-red-700"></div>
		<div class="mt-4 flex items-center justify-end gap-3">
			<button type="button" class="resetbutton w-auto px-3 py-1 text-sm" data-role="personen-admin-delete-cancel">Abbrechen</button>
			<button type="button" class="submitbutton w-auto bg-red-700 px-3 py-1 text-sm hover:bg-red-800" data-role="personen-admin-delete-confirm">Löschen</button>
		</div>
		<input type="hidden" data-role="personen-admin-delete-csrf" value="{{ $model.csrf_token }}" />
	</div>
</dialog>

<script>
	(() => {
		const dialog = document.querySelector("[data-role='personen-admin-delete-dialog']");
		if (!dialog) return;
		const titleEl = dialog.querySelector("[data-role='personen-admin-delete-title']");
		const impactsEl = dialog.querySelector("[data-role='personen-admin-delete-impacts']");
		const errorEl = dialog.querySelector("[data-role='personen-admin-delete-error']");
		const cancelBtn = dialog.querySelector("[data-role='personen-admin-delete-cancel']");
		const confirmBtn = dialog.querySelector("[data-role='personen-admin-delete-confirm']");
		const csrfInput = dialog.querySelector("[data-role='personen-admin-delete-csrf']");

		let currentAgentId = "";
		let currentDeleteEndpoint = "";
		let currentLastEdited = "";

		const closeDialog = (event) => {
			if (event) event.preventDefault();
			if (dialog.open) dialog.close();
		};

		const openDialog = () => {
			if (typeof dialog.showModal === "function") dialog.showModal();
		};

		const setError = (message) => {
			if (!errorEl) return;
			if (message) {
				errorEl.textContent = message;
				errorEl.classList.remove("hidden");
			} else {
				errorEl.textContent = "";
				errorEl.classList.add("hidden");
			}
		};

		document.body.addEventListener("click", async (event) => {
			const button = event.target.closest("[data-role='personen-admin-delete']");
			if (!button) return;
			event.preventDefault();
			event.stopPropagation();

			currentAgentId = button.getAttribute("data-agent-id") || "";
			currentDeleteEndpoint = button.getAttribute("data-delete-endpoint") || "";
			currentLastEdited = button.getAttribute("data-last-edited") || "";
			const currentTitle = button.getAttribute("data-agent-title") || "";

			if (titleEl) titleEl.textContent = currentTitle;
			if (impactsEl) impactsEl.innerHTML = "Lade Informationen …";
			setError("");
			openDialog();

			try {
				const response = await fetch(`/admin/personen/delete-info/${encodeURIComponent(currentAgentId)}`, {
					headers: { "HX-Request": "true" },
				});
				const html = await response.text();
				if (!response.ok) {
					throw new Error("Informationen konnten nicht geladen werden.");
				}
				if (impactsEl) impactsEl.innerHTML = html;
			} catch (error) {
				setError(error instanceof Error ? error.message : "Informationen konnten nicht geladen werden.");
			}
		});

		cancelBtn?.addEventListener("click", closeDialog);
		dialog?.addEventListener("cancel", closeDialog);

		if (confirmBtn) {
			confirmBtn.addEventListener("click", async () => {
				if (!currentDeleteEndpoint) return;
				setError("");
				try {
					const response = await fetch(currentDeleteEndpoint, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"X-Requested-With": "XMLHttpRequest",
						},
						body: JSON.stringify({
							csrf_token: csrfInput?.value || "",
							last_edited: currentLastEdited,
						}),
					});
					let data = null;
					try {
						data = await response.clone().json();
					} catch {
						data = null;
					}
					if (!response.ok) {
						throw new Error(data?.error || "Löschen fehlgeschlagen.");
					}
					closeDialog();
					if (currentAgentId) {
						const row = document.querySelector(`[data-agent-id='${CSS.escape(currentAgentId)}']`);
						row?.remove();
						const countEl = document.getElementById("personen-admin-count");
						if (countEl) {
							const raw = countEl.textContent || "";
							const hasSlash = raw.includes("/");
							const nums = raw.match(/\d+/g) || [];
							if (nums.length > 0) {
								let current = parseInt(nums[0], 10);
								let total = nums.length > 1 ? parseInt(nums[1], 10) : null;
								if (!Number.isNaN(current) && current > 0) current -= 1;
								if (total !== null && !Number.isNaN(total) && total > 0) total -= 1;
								if (hasSlash && total !== null) {
									countEl.textContent = `${current} / ${total} Personen`;
								} else {
									countEl.textContent = `${current} Personen`;
								}
							}
						}
					}
				} catch (error) {
					setError(error instanceof Error ? error.message : "Löschen fehlgeschlagen.");
				}
			});
		}
	})();
</script>
