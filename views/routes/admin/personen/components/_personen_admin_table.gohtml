{{ $model := . }}

<div class="admin-list-table-shell">
	<table id="personen-admin-table" class="admin-list-table table-fixed">
		<colgroup>
			<col style="width: 9rem;" />
			<col style="width: 30rem;" />
			<col style="width: 10rem;" />
			<col style="width: 12rem;" />
			<col style="width: 8rem;" />
			<col style="width: 8.5rem;" />
		</colgroup>
		<thead class="admin-list-head">
			<tr>
				<th class="w-[9rem] whitespace-nowrap py-2 pr-4 pl-4 align-bottom">
					<div class="flex flex-col items-start gap-0.5 leading-tight">
						<span class="font-semibold tracking-wide">Nachweis</span>
					</div>
				</th>
				<th class="col-title w-[30rem] whitespace-nowrap py-2 pr-4 align-bottom">
					<div class="flex flex-col items-start gap-0.5 leading-tight">
						<span class="font-semibold tracking-wide">Name</span>
						<span class="font-semibold tracking-wide">Annotation</span>
					</div>
				</th>
				<th class="col-profession whitespace-nowrap py-2 pr-4 align-bottom">
					<div class="flex flex-col items-start gap-0.5 leading-tight">
						<span class="font-semibold tracking-wide">Beruf</span>
					</div>
				</th>
				<th class="col-life py-2 pr-4 align-bottom">
					<div class="flex flex-col items-start gap-0.5 leading-tight">
						<span class="font-semibold tracking-wide">Lebensdaten</span>
					</div>
				</th>
				<th class="col-counts whitespace-nowrap py-2 pr-4 align-bottom">
					<div class="flex flex-col items-start gap-0.5 leading-tight">
						<span class="font-semibold tracking-wide">Bände / Beiträge</span>
					</div>
				</th>
				<th class="whitespace-nowrap py-2 pr-8 text-right align-bottom">
					<div class="flex flex-col items-end gap-0.5 leading-tight">
						<span class="font-semibold tracking-wide">Aktionen</span>
					</div>
				</th>
			</tr>
		</thead>
		<tbody id="personen-admin-table-body">
			{{ template "_personen_admin_rows" $model }}
			{{- if not (len $model.result.Agents) -}}
				<tr>
					<td colspan="6" class="py-6 text-center text-base text-gray-500">
						Keine Personen gefunden.
					</td>
				</tr>
			{{- end -}}
		</tbody>
	</table>
</div>

<script>
	(() => {
		const toggleRoot = document.querySelector('[data-role="personen-admin-column-toggle"]');
		if (!toggleRoot) return;
		const storageKey = "personen-admin-columns-v1";
		let saved = null;
		try {
			saved = JSON.parse(localStorage.getItem(storageKey) || "null");
		} catch {
			saved = null;
		}
		const checkboxes = toggleRoot.querySelectorAll('input[type="checkbox"][data-col]');
		const applyColumnVisibility = () => {
			checkboxes.forEach((checkbox) => {
				const col = checkbox.getAttribute("data-col");
				const visible = checkbox.checked;
				document.querySelectorAll(`.col-${col}`).forEach((el) => {
					el.classList.toggle("hidden", !visible);
				});
			});
		};
		window.applyPersonenAdminColumnVisibility = applyColumnVisibility;

		checkboxes.forEach((checkbox) => {
			const col = checkbox.getAttribute("data-col");
			if (saved && typeof saved[col] === "boolean") {
				checkbox.checked = saved[col];
			}
			checkbox.addEventListener("change", () => {
				const nextState = {};
				checkboxes.forEach((cb) => {
					const key = cb.getAttribute("data-col");
					nextState[key] = cb.checked;
				});
				localStorage.setItem(storageKey, JSON.stringify(nextState));
				applyColumnVisibility();
			});
		});
		applyColumnVisibility();
		if (!document.body.dataset.personenAdminColumnsBound) {
			document.body.dataset.personenAdminColumnsBound = "true";
			document.body.addEventListener("htmx:afterSwap", () => {
				window.applyPersonenAdminColumnVisibility?.();
			});
		}
	})();
</script>
