{{ $model := . }}

{{- range $_, $agent := $model.result.Agents -}}
	{{- $bandCount := index $model.result.BandCounts $agent.Id -}}
	{{- $contentCount := index $model.result.ContentCounts $agent.Id -}}
	<tr
		data-agent-id="{{ $agent.Id }}"
		class="admin-list-row">
		<td class="col-reference admin-col-nachweis-personen admin-col-wrap py-2 pr-4 pl-4">
			<div class="flex flex-col gap-1">
				{{- if $agent.References -}}
					<span class="agent-admin-search-text admin-list-reference" title="{{ $agent.References }}">{{ $agent.References }}</span>
				{{- end -}}
			</div>
		</td>
		<td class="col-title py-2 pr-4">
			<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
				<div class="agent-admin-search-text text-lg font-semibold leading-snug text-slate-900">{{ $agent.Name }}</div>
				{{- if $agent.CorporateBody -}}
					<span class="admin-list-badge">Körperschaft</span>
				{{- end -}}
			</div>
			{{- if $agent.Annotation -}}
				<div class="agent-admin-search-text annotation-content mt-1 font-sans text-base leading-snug text-gray-700">{{- Safe (ReplaceSlashParen $agent.Annotation) -}}</div>
			{{- end -}}
		</td>
		<td class="col-life admin-col-life py-2 pr-4 text-base leading-snug text-gray-700">
			{{- if $agent.BiographicalData -}}
				<div class="agent-admin-search-text text-base leading-snug">{{ $agent.BiographicalData }}</div>
			{{- end -}}
		</td>
		<td class="col-profession admin-col-profession py-2 pr-4 text-base text-gray-700">
			{{- if $agent.Profession -}}
				<div class="agent-admin-search-text text-base leading-snug">{{ $agent.Profession }}</div>
			{{- end -}}
		</td>
			<td class="py-2 pr-4 whitespace-nowrap text-right w-px">
				<div class="admin-list-actions items-center gap-3">
					<div class="admin-list-count flex items-center justify-end gap-2 whitespace-nowrap">
						{{- if gt $bandCount 0 -}}
							<a
								href="/admin/baende/?offset=0&sort=title&order=asc&person={{ $agent.Id }}"
								onclick="event.stopPropagation();"
								hx-target="#admin-main-content"
								hx-swap="innerHTML"
								hx-push-url="true"
								hx-indicator="#admin-main-loading"
								hx-headers='{"X-Admin-Main-Nav":"true"}'
								class="admin-list-chip"
								title="Bände anzeigen"
								aria-label="Bände anzeigen">
								<i class="ri-book-line"></i>
								<span>{{ $bandCount }}</span>
							</a>
						{{- else -}}
							<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60" title="Keine Bände verknüpft" aria-label="Keine Bände verknüpft">
								<i class="ri-book-line"></i>
								<span>0</span>
							</span>
						{{- end -}}
						{{- if gt $contentCount 0 -}}
							<a
								href="/admin/beitraege/?offset=0&person={{ $agent.Id }}"
								onclick="event.stopPropagation();"
								hx-target="#admin-main-content"
								hx-swap="innerHTML"
								hx-push-url="true"
								hx-indicator="#admin-main-loading"
								hx-headers='{"X-Admin-Main-Nav":"true"}'
								class="admin-list-chip"
								title="Beiträge anzeigen"
								aria-label="Beiträge anzeigen">
								<i class="ri-article-line"></i>
								<span>{{ $contentCount }}</span>
							</a>
						{{- else -}}
							<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60" title="Keine Beiträge verknüpft" aria-label="Keine Beiträge verknüpft">
								<i class="ri-article-line"></i>
								<span>0</span>
							</span>
						{{- end -}}
					</div>
					<span
						class="col-status inline-flex"
						title="{{- if eq $agent.EditState "Unknown" -}}Unbekannt{{- else if eq $agent.EditState "ToDo" -}}Zu erledigen{{- else if eq $agent.EditState "Review" -}}Überprüfen{{- else if eq $agent.EditState "Seen" -}}Gesichtet{{- else if eq $agent.EditState "Edited" -}}Erfasst{{- else -}}{{ $agent.EditState }}{{- end -}}"
						aria-label="{{- if eq $agent.EditState "Unknown" -}}Unbekannt{{- else if eq $agent.EditState "ToDo" -}}Zu erledigen{{- else if eq $agent.EditState "Review" -}}Überprüfen{{- else if eq $agent.EditState "Seen" -}}Gesichtet{{- else if eq $agent.EditState "Edited" -}}Erfasst{{- else -}}{{ $agent.EditState }}{{- end -}}">
						<span class="status-badge admin-status-chip" data-status="{{ $agent.EditState }}">
							<i class="status-icon {{- if eq $agent.EditState "Edited" }} ri-checkbox-circle-line{{- else if eq $agent.EditState "Seen" }} ri-information-line{{- else if eq $agent.EditState "Review" }} ri-search-line{{- else if eq $agent.EditState "ToDo" }} ri-list-check{{- else }} ri-forbid-2-line{{- end }}"></i>
						</span>
					</span>
					<div class="admin-list-action-stack">
						<div class="admin-list-chip-pair">
							<a href="/person/{{ $agent.MusenalmID }}" class="admin-list-chip" title="Anzeigen" aria-label="Anzeigen">
								<i class="ri-eye-line"></i>
							</a>
							<a href="/person/{{ $agent.MusenalmID }}" target="_blank" rel="noopener" class="admin-list-chip" title="In neuem Tab öffnen" aria-label="In neuem Tab öffnen">
								<i class="ri-external-link-line"></i>
							</a>
						</div>
						{{- if (IsAdminOrEditor $model.request.user) -}}
							<a href="/admin/person/{{ $agent.Id }}/edit/" class="admin-list-chip admin-list-chip-edit" title="Bearbeiten" aria-label="Bearbeiten">
								<i class="ri-edit-line"></i>
							</a>
							<button
								type="button"
								data-role="personen-admin-delete"
								data-agent-id="{{ $agent.Id }}"
								data-agent-title="{{ $agent.Name }}"
								data-last-edited="{{ $agent.Updated }}"
								data-delete-endpoint="/admin/person/{{ $agent.Id }}/edit/delete"
								class="admin-list-chip-danger"
								title="Löschen"
								aria-label="Löschen">
								<i class="ri-delete-bin-line"></i>
							</button>
						{{- end -}}
					</div>
				</div>
			</td>
	</tr>
{{- end -}}
