{{ $model := . }}

{{- range $_, $agent := $model.result.Agents -}}
	{{- $bandCount := index $model.result.BandCounts $agent.Id -}}
	{{- $contentCount := index $model.result.ContentCounts $agent.Id -}}
	<tr
		data-agent-id="{{ $agent.Id }}"
		class="admin-list-row{{ if eq $agent.EditState "ToDo" }} border-l-4 border-red-500{{ else if eq $agent.EditState "Review" }} border-l-4 border-amber-500{{ end }}">
		<td class="col-reference admin-col-nachweis-personen admin-col-wrap py-2 pr-4 pl-4">
			<div class="flex flex-col gap-1">
				{{- if $agent.References -}}
					<span class="agent-admin-search-text admin-list-reference" title="{{ $agent.References }}">{{ $agent.References }}</span>
				{{- end -}}
			</div>
		</td>
		<td class="col-title py-2 pr-4">
			<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
				<div class="agent-admin-search-text text-lg font-semibold leading-snug text-slate-900">{{ $agent.Name }}</div>
				{{- if $agent.CorporateBody -}}
					<span class="admin-list-badge">Körperschaft</span>
				{{- end -}}
			</div>
			{{- if $agent.Annotation -}}
				<div class="agent-admin-search-text annotation-content mt-1 font-sans text-base leading-snug text-gray-700">{{- Safe (ReplaceSlashParen $agent.Annotation) -}}</div>
			{{- end -}}
		</td>
		<td class="col-life admin-col-life py-2 pr-4 text-base leading-snug text-gray-700">
			{{- if $agent.BiographicalData -}}
				<div class="agent-admin-search-text text-base leading-snug">{{ $agent.BiographicalData }}</div>
			{{- end -}}
		</td>
		<td class="col-profession admin-col-profession py-2 pr-4 text-base text-gray-700">
			{{- if $agent.Profession -}}
				<div class="agent-admin-search-text text-base leading-snug">{{ $agent.Profession }}</div>
			{{- end -}}
		</td>
		<td class="col-verweise py-2 pr-4 whitespace-nowrap text-right w-px">
			<div class="admin-list-count flex items-center justify-end gap-2 whitespace-nowrap">
				{{- if gt $bandCount 0 -}}
					<tool-tip position="top" class="inline">
						<a
							href="/admin/baende/?offset=0&sort=title&order=asc&person={{ $agent.Id }}"
							onclick="event.stopPropagation();"
							hx-target="#admin-main-content"
							hx-swap="innerHTML"
							hx-push-url="true"
							hx-indicator="#admin-main-loading"
							hx-headers='{"X-Admin-Main-Nav":"true"}'
							class="admin-list-chip">
							<i class="ri-book-line"></i>
							<span>{{ $bandCount }}</span>
						</a>
						<div class="data-tip">Bände anzeigen</div>
					</tool-tip>
				{{- else -}}
					<tool-tip position="top" class="inline">
						<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60">
							<i class="ri-book-line"></i>
							<span>0</span>
						</span>
						<div class="data-tip">Keine Bände verknüpft</div>
					</tool-tip>
				{{- end -}}
				<tool-tip position="top" class="inline">
					<span class="admin-list-chip{{ if eq $contentCount 0 }} pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60{{ end }}">
						<i class="ri-article-line"></i>
						<span>{{ $contentCount }}</span>
					</span>
					<div class="data-tip">Inhalte</div>
				</tool-tip>
			</div>
		</td>
		<td class="py-2 pr-4">
			<div class="admin-list-actions">
				<div class="admin-list-action-stack">
					<tool-tip position="top" class="inline">
						<a href="/person/{{ $agent.MusenalmID }}" target="_blank" rel="noopener" class="admin-list-chip">
							<i class="ri-external-link-line"></i>
						</a>
						<div class="data-tip">In neuem Tab öffnen</div>
					</tool-tip>
					{{- if (IsAdminOrEditor $model.request.user) -}}
						<tool-tip position="top" class="inline">
							<a href="/admin/person/{{ $agent.Id }}/edit/" class="admin-list-chip">
								<i class="ri-edit-line"></i>
							</a>
							<div class="data-tip">Bearbeiten</div>
						</tool-tip>
						<tool-tip position="top" class="inline">
							<button
								type="button"
								data-role="personen-admin-delete"
								data-agent-id="{{ $agent.Id }}"
								data-agent-title="{{ $agent.Name }}"
								data-last-edited="{{ $agent.Updated }}"
								data-delete-endpoint="/admin/person/{{ $agent.Id }}/edit/delete"
								class="admin-list-chip-danger">
								<i class="ri-delete-bin-line"></i>
							</button>
							<div class="data-tip">Löschen</div>
						</tool-tip>
					{{- end -}}
				</div>
			</div>
		</td>
	</tr>
{{- end -}}
