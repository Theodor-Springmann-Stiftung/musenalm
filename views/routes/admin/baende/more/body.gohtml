{{ $model := . }}

{{- range $_, $entry := $model.result.Entries -}}
	{{- template "_baende_row_group" (Dict
		"entry" $entry
		"items" (index $model.result.Items $entry.Id)
		"editor_user" (index $model.result.Users $entry.Editor)
		"contents_count" (index $model.result.ContentsCount $entry.Id)
		"series_links" (index $model.result.SeriesLinks $entry.Id)
		"can_edit" (IsAdminOrEditor $model.request.user)
		"expanded" false
		"details" nil
	) -}}
{{- end -}}
