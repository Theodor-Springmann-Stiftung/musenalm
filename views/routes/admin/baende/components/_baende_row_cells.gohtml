{{ $entry := .entry }}
	<td class="pt-2 pb-2 pr-4 pl-4 admin-col-nachweis-baende admin-col-wrap{{ if eq $entry.EditState "ToDo" }} border-l-4 border-red-500{{ else if eq $entry.EditState "Review" }} border-l-4 border-amber-500{{ end }}">
			<div class="flex flex-col">
				<div class="px-2.5 text-base font-semibold leading-snug text-slate-900">Alm {{ $entry.MusenalmID }}</div>
				{{- if $entry.References -}}
					<div class="mt-1 px-2.5 font-sans text-base leading-snug text-gray-700" title="{{ $entry.References }}">{{ $entry.References }}</div>
				{{- end -}}
				<div class="ml-2.5 flex flex-nowrap items-center gap-1.5 pt-1">
					<a href="/almanach/{{ $entry.MusenalmID }}" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip" title="Anzeigen" aria-label="Anzeigen">
						<i class="ri-eye-line"></i>
					</a>
					<a href="/almanach/{{ $entry.MusenalmID }}" target="_blank" rel="noopener" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip" title="In neuem Tab öffnen" aria-label="In neuem Tab öffnen">
						<i class="ri-external-link-line"></i>
					</a>
				{{- if .can_edit -}}
					<a href="/admin/almanach/{{ $entry.MusenalmID }}/edit" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip" title="Bearbeiten" aria-label="Bearbeiten">
						<i class="ri-edit-line"></i>
					</a>
					<button
						type="button"
						onclick="event.stopPropagation();"
						data-role="baende-delete"
						data-entry-id="{{ $entry.MusenalmID }}"
						data-entry-title="{{- if $entry.PreferredTitle -}}{{ $entry.PreferredTitle }}{{- else if ne $entry.Year 0 -}}{{ $entry.Year }}{{- else -}}[o.J.]{{- end -}}"
						data-delete-endpoint="/admin/almanach/{{ $entry.MusenalmID }}/edit/delete"
						class="admin-list-chip-danger"
						title="Löschen"
						aria-label="Löschen">
						<i class="ri-delete-bin-line"></i>
					</button>
					{{- end -}}
				</div>
			<div class="ml-2.5 flex flex-nowrap items-center gap-1.5 pt-1">
				{{- if gt .contents_count 0 -}}
					<a
						href="/admin/almanach/{{ $entry.MusenalmID }}/contents/edit"
						onclick="event.stopPropagation();"
						hx-target="body"
						class="admin-list-chip"
						title="Beiträge anzeigen"
						aria-label="Beiträge anzeigen">
						<i class="ri-file-list-3-line"></i>
						<span>{{ .contents_count }}</span>
					</a>
				{{- else -}}
					<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60" title="Keine Inhalte" aria-label="Keine Inhalte">
						<i class="ri-file-list-3-line"></i>
						<span>0</span>
					</span>
				{{- end -}}
				{{- if gt (len .series_links) 0 -}}
					<a
						href="/admin/reihen/?entry={{ $entry.Id }}"
						onclick="event.stopPropagation();"
						hx-target="#admin-main-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						hx-indicator="#admin-main-loading"
						hx-headers='{"X-Admin-Main-Nav":"true"}'
						class="admin-list-chip"
						title="Reihen anzeigen"
						aria-label="Reihen anzeigen">
						<i class="ri-book-shelf-fill"></i>
						<span>{{ len .series_links }}</span>
					</a>
				{{- else -}}
					<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60" title="Keine Reihen verknüpft" aria-label="Keine Reihen verknüpft">
						<i class="ri-book-shelf-fill"></i>
						<span>0</span>
					</span>
				{{- end -}}
			</div>
		</div>
	</td>
<td class="pt-2 pb-2 pr-4 col-title">
	<div class="font-semibold text-slate-900 text-base leading-snug">
		{{- if $entry.PreferredTitle -}}
			<span class="inline">{{ $entry.PreferredTitle }}</span>
		{{- else if ne $entry.Year 0 -}}
			<span class="inline">{{ $entry.Year }}</span>
		{{- else -}}
			<span class="inline">[o.J.]</span>
		{{- end -}}
			<span
				class="inline-block align-middle ml-1"
				title="{{- if eq $entry.EditState "Unknown" -}}Gesucht{{- else if eq $entry.EditState "ToDo" -}}Zu erledigen{{- else if eq $entry.EditState "Review" -}}Überprüfen{{- else if eq $entry.EditState "Seen" -}}Autopsiert{{- else if eq $entry.EditState "Edited" -}}Vollständig Erfasst{{- else -}}{{ $entry.EditState }}{{- end -}}"
				aria-label="{{- if eq $entry.EditState "Unknown" -}}Gesucht{{- else if eq $entry.EditState "ToDo" -}}Zu erledigen{{- else if eq $entry.EditState "Review" -}}Überprüfen{{- else if eq $entry.EditState "Seen" -}}Autopsiert{{- else if eq $entry.EditState "Edited" -}}Vollständig Erfasst{{- else -}}{{ $entry.EditState }}{{- end -}}">
				<i class="status-icon align-middle {{- if eq $entry.EditState "Edited" }} ri-checkbox-circle-line{{- else if eq $entry.EditState "Seen" }} ri-information-line{{- else if eq $entry.EditState "Review" }} ri-search-line{{- else if eq $entry.EditState "ToDo" }} ri-list-check{{- else }} ri-forbid-2-line{{- end }}" data-status="{{ $entry.EditState }}"></i>
			</span>
	</div>
	{{- if $entry.TitleStmt -}}
		<div class="text-gray-700 text-base mt-1 leading-snug">
			{{ $entry.TitleStmt }}
		</div>
	{{- end -}}
	{{- if $entry.Annotation -}}
		<div class="col-annotations baende-inline-annotation annotation-content mt-4 hidden hyphens-auto text-slate-800 text-base leading-snug font-sans">
			<span class="mr-1 inline-block rounded-xs bg-stone-100 px-1.5 py-0.5 text-[0.72rem]
			font-semibold text-slate-700 align-middle">Anm.</span>
			<span>{{- Safe (ReplaceSlashParenSlash $entry.Annotation) -}}</span>
		</div>
	{{- end -}}
	{{- if or $entry.SubtitleStmt $entry.VariantTitle $entry.ParallelTitle $entry.IncipitStmt -}}
		<div class="flex flex-col gap-1 text-base text-gray-700 mt-1">
			{{- if $entry.SubtitleStmt -}}
				<div><span class="font-semibold text-gray-500">Untertitel:</span> {{ $entry.SubtitleStmt }}</div>
			{{- end -}}
			{{- if $entry.VariantTitle -}}
				<div><span class="font-semibold text-gray-500">Varianten:</span> {{ $entry.VariantTitle }}</div>
			{{- end -}}
			{{- if $entry.ParallelTitle -}}
				<div><span class="font-semibold text-gray-500">Parallel:</span> {{ $entry.ParallelTitle }}</div>
			{{- end -}}
			{{- if $entry.IncipitStmt -}}
				<div><span class="font-semibold text-gray-500">Incipit:</span> {{ $entry.IncipitStmt }}</div>
			{{- end -}}
		</div>
	{{- end -}}
</td>
<td class="pt-2 pb-2 pr-4 whitespace-nowrap col-year hidden admin-col-year">
	{{- if ne $entry.Year 0 -}}
		<a
			href="/admin/baende/?offset=0&sort=title&order=asc&year={{ $entry.Year }}"
			onclick="event.stopPropagation();"
			hx-target="#admin-main-content"
			hx-swap="innerHTML"
			hx-push-url="true"
			hx-indicator="#admin-main-loading"
			hx-headers='{"X-Admin-Main-Nav":"true"}'
			class="text-slate-700 underline decoration-dotted hover:text-slate-900 hover:decoration-solid underline-offset-3">
			{{ $entry.Year }}
		</a>
	{{- end -}}
</td>
<td class="pt-2 pb-2 pr-4 col-appearance admin-col-appearance">
	{{- if or $entry.ResponsibilityStmt $entry.PublicationStmt $entry.PlaceStmt -}}
		<div class="flex flex-col gap-2 text-base text-gray-700">
			{{- if and $entry.ResponsibilityStmt (not (eq $entry.ResponsibilityStmt "unbezeichnet")) -}}
				<div>
					<div class="text-base font-semibold text-gray-500">Herausgaberangabe</div>
					<div class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 leading-snug text-slate-800">
						<span>{{ $entry.ResponsibilityStmt }}</span>
						{{- if $entry.Pseudonym -}}
							<span class="inline-flex items-center rounded-xs bg-slate-200 px-1.5 py-0.5 font-sans text-[0.72rem] font-semibold text-slate-700">Pseudonym</span>
						{{- end -}}
					</div>
				</div>
			{{- end -}}
			{{- if $entry.PublicationStmt -}}
				<div>
					<div class="text-base font-semibold text-gray-500">Publikationsangabe</div>
					<div class="mt-0.5 leading-snug text-slate-800">{{ $entry.PublicationStmt }}</div>
				</div>
			{{- end -}}
			{{- if $entry.PlaceStmt -}}
				<div>
					<div class="text-base font-semibold text-gray-500">Ortsangabe</div>
					<div class="mt-0.5 leading-snug text-slate-800">{{ $entry.PlaceStmt }}</div>
				</div>
			{{- end -}}
		</div>
	{{- end -}}
</td>
<td class="pt-2 pb-2 pr-4 col-extent admin-col-extent">
	{{- if or $entry.Extent $entry.Dimensions $entry.Language -}}
		<div class="flex flex-col gap-2 text-base text-gray-700">
			{{- if $entry.Extent -}}
				<div>
					<div class="text-base font-semibold text-gray-500">Struktur</div>
					<div class="mt-0.5 leading-snug text-slate-800">{{ $entry.Extent }}</div>
				</div>
			{{- end -}}
			{{- if $entry.Dimensions -}}
				<div>
					<div class="text-base font-semibold text-gray-500">Maße</div>
					<div class="mt-0.5 leading-snug text-slate-800">{{ $entry.Dimensions }}</div>
				</div>
			{{- end -}}
			{{- if $entry.Language -}}
				<div>
					<div class="text-base font-semibold text-gray-500">Sprache</div>
					<div class="mt-0.5 flex flex-wrap gap-x-2 gap-y-1 font-sans text-base italic text-gray-700">
						{{- range $i, $lang := $entry.Language -}}
							<span>{{ LanguageNameGerman $lang }}</span>
						{{- end -}}
					</div>
				</div>
			{{- end -}}
		</div>
	{{- end -}}
</td>
<td class="pt-2 pb-2 pr-4 col-signatures admin-col-signatures">
	{{- if .items -}}
		<div class="flex flex-col gap-2 text-base text-gray-700">
			{{- range $_, $item := .items -}}
				<div class="inline-flex flex-col items-center justify-center rounded-xs border border-slate-200 bg-white text-base">
					{{- if $item.Identifier -}}
						<div class="px-2 py-1 font-semibold text-slate-900 text-center">{{ $item.Identifier }}</div>
					{{- end -}}
					{{- if $item.Media -}}
						<div class="w-full border-t border-slate-200 px-2 py-1 text-gray-600 text-center leading-snug text-base">
							{{- range $i, $media := $item.Media -}}{{- if $i }}, {{ end -}}{{ $media }}{{- end -}}
						</div>
					{{- end -}}
				</div>
			{{- end -}}
		</div>
	{{- end -}}
</td>
<td class="pt-2 pb-2 pr-4 col-series hidden admin-col-series-wide">
	{{- if .series_links -}}
		<div class="flex flex-col gap-1.5 text-base text-gray-700">
			{{- range $_, $link := .series_links -}}
				{{- $series := seriesDisplay $link.Series.Id -}}
				<div>
					<a
						href="/admin/baende/?offset=0&sort=title&order=asc&series={{ $series.ID }}"
						onclick="event.stopPropagation();"
						hx-target="#admin-main-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						hx-indicator="#admin-main-loading"
						hx-headers='{"X-Admin-Main-Nav":"true"}'
						class="text-slate-700 underline decoration-dotted hover:text-slate-900 hover:decoration-solid underline-offset-3">
						{{ $series.Name }}
					</a>
				</div>
			{{- end -}}
		</div>
	{{- end -}}
</td>
<td class="pt-2 pb-2 pr-4 col-linked-places hidden admin-col-linked">
	{{- if $entry.Places -}}
		<div class="flex flex-col gap-1.5 text-base text-gray-700">
			{{- range $_, $placeID := $entry.Places -}}
				{{- $place := placeDisplay $placeID -}}
				<div>
					<a
						href="/admin/baende/?offset=0&sort=title&order=asc&place={{ $place.ID }}"
						onclick="event.stopPropagation();"
						hx-target="#admin-main-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						hx-indicator="#admin-main-loading"
						hx-headers='{"X-Admin-Main-Nav":"true"}'
						class="text-slate-700 underline decoration-dotted hover:text-slate-900 hover:decoration-solid underline-offset-3">
						{{ $place.Name }}
					</a>
				</div>
			{{- end -}}
		</div>
	{{- end -}}
</td>
<td class="pt-2 pb-2 pr-4 col-linked-persons hidden admin-col-linked">
	{{- if .agent_rels -}}
		<div class="flex flex-col gap-1.5 text-base text-gray-700">
			{{- range $_, $rel := .agent_rels -}}
				{{- $agent := agentDisplay $rel.Agent -}}
				<div>
					<a
						href="/admin/baende/?offset=0&sort=title&order=asc&person={{ $agent.ID }}"
						onclick="event.stopPropagation();"
						hx-target="#admin-main-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						hx-indicator="#admin-main-loading"
						hx-headers='{"X-Admin-Main-Nav":"true"}'
						class="text-slate-700 underline decoration-dotted hover:text-slate-900 hover:decoration-solid underline-offset-3">
						{{ $agent.Name }}
					</a>
				</div>
			{{- end -}}
		</div>
	{{- end -}}
</td>
<td class="pt-2 pb-2 pr-4 col-modified admin-col-modified-baende">
	{{ template "_modified_notes_cell" (Dict
		"updated" $entry.Updated
		"editor_user" .editor_user
		"comment" $entry.Comment
	) }}
</td>
