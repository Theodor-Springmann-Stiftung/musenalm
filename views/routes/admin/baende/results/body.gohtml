{{ $model := . }}

<div id="baenderesults"
     x-data="{ 
        hasMore: {{ if $model.has_more }}true{{ else }}false{{ end }}, 
        offset: {{ if $model.next_offset }}{{ $model.next_offset }}{{ else }}0{{ end }}, 
        loading: false,
        search: '{{ $model.search }}',
        letter: '{{ $model.letter }}',
        status: '{{ $model.status }}',
        person: '{{ $model.person }}',
        user: '{{ $model.user }}',
        year: '{{ $model.year }}',
        place: '{{ $model.place }}',
        series: '{{ $model.series }}',
        sortField: '{{ if $model.sort_field }}{{ $model.sort_field }}{{ else }}title{{ end }}',
        sortOrder: '{{ if $model.sort_order }}{{ $model.sort_order }}{{ else }}asc{{ end }}',
        buildMoreVals() {
            const values = { offset: this.offset };
            if (this.search) values.search = this.search;
            if (this.letter) values.letter = this.letter;
            if (this.status) values.status = this.status;
            if (this.person) values.person = this.person;
            if (this.user) values.user = this.user;
            if (this.year) values.year = this.year;
            if (this.place) values.place = this.place;
            if (this.series) values.series = this.series;
            if (this.sortField) values.sort = this.sortField;
            if (this.sortOrder) values.order = this.sortOrder;
            return JSON.stringify(values);
        }
     }">

	<span id="baende-count"
		  hx-swap-oob="outerHTML"
		  data-current-count="{{ $model.current_count }}"
		  data-total-count="{{ if $model.total_count }}{{ $model.total_count }}{{ else }}{{ len $model.result.Entries }}{{ end }}"
		  class="text-lg font-semibold font-sans text-gray-600 whitespace-nowrap">
		{{ if $model.current_count }}{{ GermanInt $model.current_count }}&thinsp;/&thinsp;{{ end }}{{ if $model.total_count }}{{ GermanInt $model.total_count }}{{ else }}{{ GermanInt (len $model.result.Entries) }}{{ end }} Bände
	</span>

	{{ template "_baende_table" $model }}

	<!-- Load More Button -->
	<div class="mt-6 flex justify-center" x-show="hasMore">
		<button
			type="button"
			class="content-action-button"
			hx-get="/admin/baende/more/"
			:hx-vals="buildMoreVals()"
			hx-select="#baende-more-rows > *"
			hx-target="#baende-table-body"
			hx-swap="beforeend"
			hx-indicator="this"
			@htmx:before-request="loading = true"
			@htmx:after-request="
                loading = false;
                hasMore = $event.detail.xhr.getResponseHeader('X-Has-More') === 'true';
                offset = parseInt($event.detail.xhr.getResponseHeader('X-Next-Offset') || '0');
                const currentCount = parseInt($event.detail.xhr.getResponseHeader('X-Current-Count') || '0');
                const totalCount = parseInt($event.detail.xhr.getResponseHeader('X-Total-Count') || '0');
                const countEl = document.getElementById('baende-count');
                if (countEl && !Number.isNaN(currentCount) && !Number.isNaN(totalCount)) {
                    const format = (value) => new Intl.NumberFormat('de-DE').format(value);
                    countEl.dataset.currentCount = String(currentCount);
                    countEl.dataset.totalCount = String(totalCount);
                    countEl.innerHTML = `${format(currentCount)}&thinsp;/&thinsp;${format(totalCount)} Bände`;
                }
            "
			:disabled="loading">
			<i class="ri-arrow-down-line" :class="{ 'spinning': loading }"></i>
			<span x-text="loading ? 'Lädt...' : 'Weitere Einträge laden'">Weitere Einträge laden</span>
		</button>
	</div>

	{{ if $model.search }}
		<script type="module">
			let elements = document.querySelectorAll('.baende-text');
			let mark_instance = new Mark(elements);
			setTimeout(() => {
				mark_instance.mark('{{ $model.search }}', {
					"seperateWordSearch": true,
				});
			}, 200);
		</script>
	{{ end }}
</div>
