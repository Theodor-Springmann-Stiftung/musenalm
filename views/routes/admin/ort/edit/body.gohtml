{{ $model := . }}
{{ $place := $model.result.Place }}
{{- $placeTitle := $place.Name -}}
{{- if $model.is_new -}}
	{{- $placeTitle = "Neuer Ort" -}}
{{- end -}}
{{- $placeActions := Arr -}}
{{- if not $model.is_new -}}
	{{- $placeActions = Arr
		(Dict "href" (printf "/reihen/?place=%d" $place.MusenalmID) "icon" "ri-eye-line" "tooltip" "Anschauen")
		(Dict "href" (printf "/reihen/?place=%d" $place.MusenalmID) "icon" "ri-external-link-line" "tooltip" "In neuem Tab öffnen" "target_blank" true)
		(Dict "href" "/admin/orte/" "icon" "ri-list-check-2" "tooltip" "Liste aller Orte")
	-}}
{{- end -}}
{{- $placePrevHref := "" -}}
{{- $placePrevLabel := "" -}}
{{- if $model.result.Prev -}}
	{{- $placePrevHref = printf "/admin/ort/%s/edit" $model.result.Prev.Id -}}
	{{- $placePrevLabel = $model.result.Prev.Name -}}
{{- end -}}
{{- $placeNextHref := "" -}}
{{- $placeNextLabel := "" -}}
{{- if $model.result.Next -}}
	{{- $placeNextHref = printf "/admin/ort/%s/edit" $model.result.Next.Id -}}
	{{- $placeNextLabel = $model.result.Next.Name -}}
{{- end -}}
{{- $placePrevMusenalmHref := "" -}}
{{- $placePrevMusenalmLabel := "" -}}
{{- if $model.result.PrevMusenalm -}}
	{{- $placePrevMusenalmHref = printf "/admin/ort/%s/edit" $model.result.PrevMusenalm.Id -}}
	{{- $placePrevMusenalmLabel = printf "%d: %s" $model.result.PrevMusenalm.MusenalmID $model.result.PrevMusenalm.Name -}}
{{- end -}}
{{- $placeNextMusenalmHref := "" -}}
{{- $placeNextMusenalmLabel := "" -}}
{{- if $model.result.NextMusenalm -}}
	{{- $placeNextMusenalmHref = printf "/admin/ort/%s/edit" $model.result.NextMusenalm.Id -}}
	{{- $placeNextMusenalmLabel = printf "%d: %s" $model.result.NextMusenalm.MusenalmID $model.result.NextMusenalm.Name -}}
{{- end -}}
{{- $placeCancelHref := "/admin/orte/" -}}
{{- $hasPlaceEntries := gt (len $model.result.Entries) 0 -}}

<edit-page>
<duplicate-warning-checker></duplicate-warning-checker>
<div class="simple-entity-page">
	{{ template "_simple_entity_edit_header" (Dict
		"is_new" $model.is_new
		"type_label" "Ort"
		"type_icon" "ri-map-pin-line"
		"title" $placeTitle
		"actions" $placeActions
		"db_id" $place.Id
		"musenalm_id" $place.MusenalmID
		"updated" $place.Updated
		"editor_user" $model.result.User
		"prev_href" $placePrevHref
		"prev_label" $placePrevLabel
		"next_href" $placeNextHref
		"next_label" $placeNextLabel
		"prev_musenalm_href" $placePrevMusenalmHref
		"prev_musenalm_label" $placePrevMusenalmLabel
		"next_musenalm_href" $placeNextMusenalmHref
		"next_musenalm_label" $placeNextMusenalmLabel
	) }}

	<div class="simple-entity-body">
		{{/* usermessage moved into action bar */}}
	<form
		autocomplete="off"
		class="w-full dbform form-with-action-bar simple-entity-form"
		id="changeplaceform"
		method="POST"
		action="{{ if $model.is_new }}/admin/orte/new/{{ else }}/admin/ort/{{ $place.Id }}/edit{{ end }}"
		{{- if not $model.is_new -}}
			data-delete-endpoint="/admin/ort/{{ $place.Id }}/edit/delete"
		{{- end -}}>
		<input type="hidden" name="csrf_token" value="{{ $model.csrf_token }}" />
		<input type="hidden" name="last_edited" value="{{ if not $model.is_new }}{{ $place.Updated }}{{ end }}" />

		<div class="simple-entity-form-grid">
			<div class="simple-entity-main-column">
				<div class="ui form">
					<div class="flex flex-row gap-2 items-start">
						<div class="field grow">
							<label for="name">
								Name
								<tool-tip position="top" class="!inline">
									<div class="data-tip">{{ help "places" "name" }}</div>
									<i class="ri-question-line"></i>
								</tool-tip>
							</label>
							<lookup-field
								id="place-name-field"
								name="name"
								data-multiline="true"
								data-no-enter="true"
								data-required="true"
								data-autocomplete="false"
								data-valid-fn="lookupRequiredText"
								data-dup-endpoint="/admin/api/places/search"
								data-dup-result-key="places"
								data-dup-current-id="{{ if not $model.is_new }}{{ $place.Id }}{{ end }}"
								value="{{- $place.Name -}}">
							</lookup-field>
						</div>
						<div class="ui checkbox shrink-0" style="padding-top: 2rem;">
							<input type="checkbox" name="fictional" id="fictional" {{ if $place.Fictional }}checked{{ end }} data-boolean-checkbox />
							<label for="fictional">
								Fiktional
								<tool-tip position="top" class="!inline">
									<div class="data-tip">{{ help "places" "fictional" }}</div>
									<i class="ri-question-line"></i>
								</tool-tip>
							</label>
						</div>
					</div>
					<div class="field">
						<label for="pseudonyms">
							Alternativnamen
							<tool-tip position="top" class="!inline">
								<div class="data-tip">{{ help "places" "pseudonyms" }}</div>
								<i class="ri-question-line"></i>
							</tool-tip>
						</label>
						<textarea name="pseudonyms" id="pseudonyms" autocomplete="off" rows="1">{{- $place.Pseudonyms -}}</textarea>
					</div>
					<div class="field">
						<label for="uri">
							URL
							<tool-tip position="top" class="!inline">
								<div class="data-tip">{{ help "places" "uri" }}</div>
								<i class="ri-question-line"></i>
							</tool-tip>
						</label>
						<input name="uri" id="uri" autocomplete="off" value="{{ $place.URI }}" />
					</div>
				</div>
				{{ template "_annotation_field" (Arr $place.Annotation "Annotation") }}
			</div>

			<div class="simple-entity-side-column">
				{{ template "_status_edit" (Arr $place "status" "status" "places") }}
				{{- if $hasPlaceEntries -}}
					<div class="mt-2">
					{{ template "_simple_entity_related_items" (Dict
						"title" "Verknüpfte Bände"
						"entries" $model.result.Entries
						"contents" ""
						"entry_types" ""
						"content_types" ""
						"content_entries" ""
						"entry_controls" true
						"csrf_token" $model.csrf_token
					) }}
					</div>
				{{- end -}}
			</div>
		</div>

		{{ template "_simple_entity_action_bar" (Dict
			"message_id" "place-save-feedback"
			"error" $model.error
			"success" $model.success
			"cancel_href" $placeCancelHref
			"cancel_url" $model.cancel_url
			"show_delete" (not $model.is_new)
			"delete_label" "Ort löschen"
			"show_view_action" (not $model.is_new)
		) }}
		{{- if not $model.is_new -}}
		<dialog data-role="edit-delete-dialog" class="fixed inset-0 m-auto rounded-md border border-slate-200 p-0 shadow-xl backdrop:bg-black/40">
			<div class="p-5 w-[22rem]">
				<div class="text-base font-bold text-gray-900">Ort löschen?</div>
				<div class="text-sm font-bold text-gray-900 mt-1">{{ $place.Name }}</div>
				<p class="text-sm text-gray-700 mt-2">
					Der Ort wird gelöscht und aus allen verknüpften Bänden entfernt.
				</p>
				<div class="mt-3">
					<div class="text-sm font-semibold text-gray-700">Betroffene Bände</div>
					<div class="mt-2 max-h-40 overflow-auto pr-1">
						{{- if $model.result.Entries -}}
							<ul class="flex flex-col gap-2 pl-0 pr-0 m-0 list-none">
								{{- range $entry := $model.result.Entries -}}
									<li class="flex items-baseline justify-between gap-3 ml-0 pl-0 text-sm text-gray-700">
										<span>{{ $entry.PreferredTitle }}</span>
										<span class="text-xs text-gray-500">{{ $entry.Year }}</span>
									</li>
								{{- end -}}
							</ul>
						{{- else -}}
							<div class="italic text-gray-500">Keine Bände betroffen.</div>
						{{- end -}}
					</div>
				</div>
				<div class="flex items-center justify-end gap-3 mt-4">
					<button type="button" class="resetbutton w-auto px-3 py-1 text-sm" data-role="edit-delete-cancel">Abbrechen</button>
					<button
						type="button"
						class="submitbutton w-auto bg-red-700 hover:bg-red-800 px-3 py-1 text-sm"
						data-role="edit-delete-confirm">
						Löschen
					</button>
				</div>
			</div>
		</dialog>
		<div class="ui small modal" id="baende-delete-modal">
			<div class="header">Band löschen?</div>
			<div class="content">
				<p id="baende-delete-title" class="text-sm font-bold text-gray-900 mb-2"></p>
				<div id="baende-delete-impacts" class="text-sm text-gray-700">Lade Informationen …</div>
				<div id="baende-delete-error" class="text-sm text-red-700 hidden mt-2"></div>
			</div>
			<div class="actions">
				<button class="ui cancel button">Abbrechen</button>
				<button class="ui red ok button">Löschen</button>
			</div>
			<input type="hidden" id="baende-delete-csrf" value="{{ $model.csrf_token }}" />
		</div>
		<div class="ui small modal" id="content-delete-modal">
			<div class="header">Beitrag löschen?</div>
			<div class="content">
				<p id="content-delete-title" class="text-sm font-bold text-gray-900 mb-2"></p>
				<div id="content-delete-error" class="text-sm text-red-700 hidden mt-2"></div>
			</div>
			<div class="actions">
				<button class="ui cancel button">Abbrechen</button>
				<button class="ui red ok button">Löschen</button>
			</div>
			<input type="hidden" id="content-delete-csrf" value="{{ $model.csrf_token }}" />
		</div>
		<script>
			(function() {
				var currentEntryId = '';
				var currentEntryEndpoint = '';
				var $baende = $('#baende-delete-modal');

				$baende.modal({
					closable: false,
					onShow: function() {
						$('#baende-delete-impacts').text('Lade Informationen …');
						$('#baende-delete-error').addClass('hidden').text('');
						if (!currentEntryId) return;
						fetch('/admin/baende/delete-info/' + encodeURIComponent(currentEntryId))
							.then(function(r) { return r.text(); })
							.then(function(html) { $('#baende-delete-impacts').html(html); })
							.catch(function() { $('#baende-delete-impacts').text('Infos konnten nicht geladen werden.'); });
					},
					onApprove: function() {
						if (!currentEntryEndpoint) return false;
						$('#baende-delete-error').addClass('hidden').text('');
						var csrf = $('#baende-delete-csrf').val() || '';
						fetch(currentEntryEndpoint, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
							body: JSON.stringify({ csrf_token: csrf })
						})
						.then(function(r) {
							return r.json().then(function(d) { return { ok: r.ok, data: d }; }).catch(function() { return { ok: r.ok, data: null }; });
						})
						.then(function(result) {
							if (!result.ok) throw new Error((result.data && result.data.error) || 'Löschen fehlgeschlagen.');
							$baende.modal('hide');
							if (currentEntryId) {
								document.querySelectorAll('[data-entry-id="' + CSS.escape(currentEntryId) + '"]')
									.forEach(function(el) { var row = el.closest('li'); if (row) row.remove(); });
							}
						})
						.catch(function(err) {
							$('#baende-delete-error').text(err.message || 'Löschen fehlgeschlagen.').removeClass('hidden');
						});
						return false;
					}
				});

				document.addEventListener('click', function(event) {
					var path = typeof event.composedPath === 'function' ? event.composedPath() : [];
					var btn = null;
					for (var i = 0; i < path.length; i++) {
						if (path[i].getAttribute && path[i].getAttribute('data-role') === 'baende-delete') { btn = path[i]; break; }
					}
					if (!btn && event.target && event.target.closest) { btn = event.target.closest('[data-role="baende-delete"]'); }
					if (!btn) return;
					event.preventDefault();
					event.stopPropagation();
					currentEntryId = btn.getAttribute('data-entry-id') || '';
					currentEntryEndpoint = btn.getAttribute('data-delete-endpoint') || '';
					$('#baende-delete-title').text(btn.getAttribute('data-entry-title') || 'Unbekannter Eintrag');
					$baende.modal('show');
				}, true);

				var currentContentId = '';
				var currentContentEndpoint = '';
				var $content = $('#content-delete-modal');

				$content.modal({
					closable: false,
					onApprove: function() {
						if (!currentContentEndpoint || !currentContentId) return false;
						$('#content-delete-error').addClass('hidden').text('');
						var csrf = $('#content-delete-csrf').val() || '';
						var payload = new URLSearchParams();
						payload.set('csrf_token', csrf);
						payload.set('content_id', currentContentId);
						fetch(currentContentEndpoint, {
							method: 'POST',
							headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'HX-Request': 'true' },
							body: payload.toString()
						})
						.then(function(r) {
							if (!r.ok) throw new Error('Löschen fehlgeschlagen.');
							$content.modal('hide');
							document.querySelectorAll('[data-content-id="' + CSS.escape(currentContentId) + '"]')
								.forEach(function(el) { var row = el.closest('li'); if (row) row.remove(); });
						})
						.catch(function(err) {
							$('#content-delete-error').text(err.message || 'Löschen fehlgeschlagen.').removeClass('hidden');
						});
						return false;
					}
				});

				document.addEventListener('click', function(event) {
					var path = typeof event.composedPath === 'function' ? event.composedPath() : [];
					var btn = null;
					for (var i = 0; i < path.length; i++) {
						if (path[i].getAttribute && path[i].getAttribute('data-role') === 'content-delete') { btn = path[i]; break; }
					}
					if (!btn && event.target && event.target.closest) { btn = event.target.closest('[data-role="content-delete"]'); }
					if (!btn) return;
					event.preventDefault();
					event.stopPropagation();
					currentContentId = btn.getAttribute('data-content-id') || '';
					currentContentEndpoint = btn.getAttribute('data-delete-endpoint') || '';
					$('#content-delete-title').text(btn.getAttribute('data-content-title') || 'Unbekannter Beitrag');
					$content.modal('show');
				}, true);
			})();
		</script>
		{{- end -}}
	</form>
	</div>
</div>
</edit-page>
