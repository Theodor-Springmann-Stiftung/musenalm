{{ $model := . }}
<!-- Data:
type AlmanachResult struct {
	Entry          *dbmodels.Entry
	Places         []*dbmodels.Place
	Series         []*dbmodels.Series
	Contents       []*dbmodels.Content
	Items          []*dbmodels.Item
	Agents         map[string]*dbmodels.Agent          // <- Key is agent id
	EntriesSeries  map[string]*dbmodels.REntriesSeries // <- Key is series id
	EntriesAgents  []*dbmodels.REntriesAgents
	ContentsAgents map[string][]*dbmodels.RContentsAgents // <- Key is content id
	User					 *dbmodels.User

	Types    []string
	HasScans bool
}
-->

{{- $preferredSeriesTitle := "" -}}
{{- $preferredSeriesId := $model.result.Entry.Series -}}
{{- $preferredSeriesMusenalmID := "" -}}
{{- if $preferredSeriesId -}}
	{{- $preferredSeries := seriesDisplay $preferredSeriesId -}}
	{{- if $preferredSeries -}}
		{{- $preferredSeriesTitle = $preferredSeries.Name -}}
		{{- $preferredSeriesMusenalmID = $preferredSeries.MusenalmID -}}
	{{- end -}}
{{- end -}}
{{- $bandTitle := "Neuer Band" -}}
{{- if not $model.is_new -}}
	{{- $bandTitle = $model.result.Entry.PreferredTitle -}}
{{- end -}}
{{- $contentCount := 0 -}}
{{- if and $model.result $model.result.Contents -}}
	{{- $contentCount = len $model.result.Contents -}}
{{- end -}}
{{- $bandActions := Arr -}}
{{- if not $model.is_new -}}
	{{- $publicDisabled := eq ($model.result.Entry.EditState) "ToDo" -}}
	{{- $bandActions = Arr
		(Dict "href" (printf "/admin/almanach/%d/contents/edit" $model.result.Entry.MusenalmID) "icon" "ri-article-line" "label" "Beiträge bearbeiten" "badge" $contentCount "tooltip" (printf "%d Beiträge bearbeiten" $contentCount))
		(Dict "href" (printf "/almanach/%d" $model.result.Entry.MusenalmID) "icon" "ri-eye-line" "tooltip" "Anschauen" "disabled" $publicDisabled)
		(Dict "href" (printf "/almanach/%d" $model.result.Entry.MusenalmID) "icon" "ri-external-link-line" "tooltip" "In neuem Tab öffnen" "target_blank" true "disabled" $publicDisabled)
		(Dict "href" "/admin/baende/" "icon" "ri-list-check-2" "tooltip" "Liste aller Bände")
	-}}
{{- end -}}
{{- $bandPrevHref := "" -}}
{{- $bandPrevLabel := "" -}}
{{- if and (not $model.is_new) $model.result.PrevByTitle -}}
	{{- $bandPrevHref = printf "/admin/almanach/%d/edit/" $model.result.PrevByTitle.MusenalmID -}}
	{{- $bandPrevLabel = $model.result.PrevByTitle.PreferredTitle -}}
{{- end -}}
{{- $bandNextHref := "" -}}
{{- $bandNextLabel := "" -}}
{{- if and (not $model.is_new) $model.result.NextByTitle -}}
	{{- $bandNextHref = printf "/admin/almanach/%d/edit/" $model.result.NextByTitle.MusenalmID -}}
	{{- $bandNextLabel = $model.result.NextByTitle.PreferredTitle -}}
{{- end -}}
{{- $bandPrevMusenalmHref := "" -}}
{{- $bandPrevMusenalmLabel := "" -}}
{{- if and (not $model.is_new) $model.result.PrevByID -}}
	{{- $bandPrevMusenalmHref = printf "/admin/almanach/%d/edit/" $model.result.PrevByID.MusenalmID -}}
	{{- $bandPrevMusenalmLabel = printf "%d: %s" $model.result.PrevByID.MusenalmID $model.result.PrevByID.PreferredTitle -}}
{{- end -}}
{{- $bandNextMusenalmHref := "" -}}
{{- $bandNextMusenalmLabel := "" -}}
{{- if and (not $model.is_new) $model.result.NextByID -}}
	{{- $bandNextMusenalmHref = printf "/admin/almanach/%d/edit/" $model.result.NextByID.MusenalmID -}}
	{{- $bandNextMusenalmLabel = printf "%d: %s" $model.result.NextByID.MusenalmID $model.result.NextByID.PreferredTitle -}}
{{- end -}}

<almanach-edit-page>
<duplicate-warning-checker></duplicate-warning-checker>
<div class="simple-entity-page">

<header class="admin-page-header simple-entity-header">
	<div class="simple-entity-title-row">
		<span class="inline" data-tippy-placement="top" data-tippy-content="Band">
			<span class="simple-entity-title-icon" aria-label="Band">
				<i class="ri-book-line"></i>
			</span>
		</span>
		<h1 class="simple-entity-title">{{ $bandTitle }}</h1>
	</div>
	{{ template "_admin_header_toolbar" (Dict
		"is_new" $model.is_new
		"actions" $bandActions
		"show_az_nav" true
		"prev_href" $bandPrevHref
		"prev_label" $bandPrevLabel
		"next_href" $bandNextHref
		"next_label" $bandNextLabel
		"header_data_id" "almanach-header-data"
		"db_id" $model.result.Entry.Id
		"musenalm_id" $model.result.Entry.MusenalmID
		"updated" $model.result.Entry.Updated
		"editor_user" $model.result.User
		"prev_musenalm_href" $bandPrevMusenalmHref
		"prev_musenalm_label" $bandPrevMusenalmLabel
		"next_musenalm_href" $bandNextMusenalmHref
		"next_musenalm_label" $bandNextMusenalmLabel
	) }}
</header>

<div class="edit-content-shell">
	{{/* usermessage moved into action bar */}}
		<form
			autocomplete="off"
			class="w-full dbform form-with-action-bar"
			id="changealmanachform"
			x-target="changealmanachform user-message almanach-header-data"
			hx-boost="false"
			method="POST"
			data-save-endpoint="{{ if $model.is_new }}/admin/almanach-new/save{{ else }}/admin/almanach/{{ $model.result.Entry.MusenalmID }}/edit/save{{ end }}"
			{{- if not $model.is_new -}}
				data-delete-endpoint="/admin/almanach/{{ $model.result.Entry.MusenalmID }}/edit/delete"
			{{- end -}}>
		<input type="hidden" name="csrf_token" value="{{ $model.csrf_token }}" />
		<input type="hidden" name="last_edited" value="{{ if not $model.is_new }}{{ $model.result.Entry.Updated }}{{ end }}" />

		<div class="flex gap-8">
		<!-- Left Column -->
		<div class="flex-1 flex flex-col gap-2">
			<!-- Kurztitel -->
			<div class="inputwrapper">
				<div class="inputlabelrow">
					<div class="flex items-center gap-1">
						<label for="preferred-title-field-input" class="inputlabel">Kurztitel</label>
						<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "preferred_title" }}'>
							<i class="ri-question-line"></i>
						</span>
					</div>
				</div>
				<lookup-field
					id="preferred-title-field"
					name="preferred_title"
					data-multiline="true"
					data-no-enter="true"
					data-required="true"
					data-autocomplete="false"
					data-valid-fn="lookupRequiredText"
					data-dup-endpoint="/admin/api/entries/search"
					data-dup-result-key="entries"
					data-dup-current-id="{{ if not $model.is_new }}{{ $model.result.Entry.Id }}{{ end }}"
					value="{{- $model.result.Entry.PreferredTitle -}}">
				</lookup-field>
			</div>

			<div class="flex items-start gap-2">
				<div class="inputwrapper basis-[70%] min-w-0">
					<div class="inputlabelrow">
						<div class="flex items-center gap-1">
							<label for="preferred-series-field-input" class="inputlabel">Reihentitel</label>
							<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ helpOr "entries" "series" "Bevorzugter Reihentitel für diesen Almanach." }}'>
								<i class="ri-question-line"></i>
							</span>
						</div>
						<div class="flex items-center gap-3 ml-auto pr-2">
							<a href="/admin/reihen/new/" class="text-sm font-bold text-gray-700 hover:text-slate-950 no-underline" target="_blank" rel="noreferrer">
								<i class="ri-add-line"></i> Neue Reihe anlegen
							</a>
						</div>
					</div>
					<lookup-field
						id="preferred-series-field"
						name="preferred_series_id"
						data-value-name="preferred_series_id"
						data-text-name=""
						data-valid-fn="lookupRequiredId"
						data-endpoint="/admin/api/series/search"
						data-result-key="series"
						data-minchars="1"
						data-limit="15"
						data-link-fn="lookupSeriesLink"
						data-value-fn="lookupSeriesValue"
						data-required="true"
						data-initial-id="{{ $preferredSeriesId }}"
						data-initial-name="{{ $preferredSeriesTitle }}"
						data-initial-musenalm-id="{{ $preferredSeriesMusenalmID }}">
					</lookup-field>
				</div>

				<div class="inputwrapper basis-[10%] min-w-[4.5rem]">
					<div class="inputlabelrow">
						<div class="flex items-center gap-1">
							<label for="year" class="inputlabel">Jahr</label>
							<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "year" }}'>
								<i class="ri-question-line"></i>
							</span>
						</div>
					</div>
					<input type="number" name="year" id="year" class="inputinput" placeholder="" autocomplete="off" value="{{ if not $model.is_new }}{{ $model.result.Entry.Year }}{{ end }}" />
				</div>

				<div class="inputwrapper basis-[30%] min-w-0">
					<div class="inputlabelrow">
						<div class="flex items-center gap-1">
							<label for="edition" class="inputlabel">Ausgabebezeichnung</label>
							<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ helpOr "entries" "edition" "Hinweis zur Ausgabe oder Edition." }}'>
								<i class="ri-question-line"></i>
							</span>
						</div>
					</div>
					<textarea name="edition" id="edition" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.Edition -}}</textarea>
				</div>
			</div>

			<content-series-relations
				data-prefix="entries_series"
				data-endpoint="/admin/api/series/search"
				data-link-base="/reihe/"
				data-error-duplicate="Diese Reihe ist bereits verknüpft."
				class="block">
				<div class="inputwrapper">
					<div class="inputlabelrow">
						<div class="flex items-center gap-1">
							<label class="inputlabel" for="series-section">Reihen</label>
							<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ helpOr "entries" "series" "Verknüpfte Reihen für diesen Almanach." }}'>
								<i class="ri-question-line"></i>
							</span>
						</div>
						<div class="flex items-center gap-3">
							<button type="button" id="series-add-toggle" data-role="content-series-add-toggle" class="text-sm font-bold text-gray-700 hover:text-slate-950 no-underline pr-3">
								<i class="ri-link"></i> Reihe verlinken
							</button>
						</div>
					</div>

					<div id="series-section">
						{{- $hasNonPreferredSeries := false -}}
						<div class="overflow-hidden rounded-xs bg-white">
							<table class="min-w-full table-fixed text-sm">
								<tbody data-role="content-series-table-body" class="divide-y divide-stone-200">
									{{- if $model.result.Series -}}
										{{- range $_, $s := $model.result.Series -}}
											{{- $rel := index $model.result.EntriesSeries $s.Id -}}
											{{- if $rel -}}
												{{- $hasNonPreferredSeries = true -}}
												<tr data-role="content-series-row" data-kind="existing" class="align-middle">
													<td class="px-3 py-2 align-middle">
														<a
															data-role="content-series-link"
															href="/reihe/{{ $s.MusenalmID }}"
															target="_blank"
															rel="noreferrer"
															class="font-semibold text-slate-900 no-underline hover:text-slate-700">
															<span data-role="content-series-name">{{ $s.Title }}</span>
														</a>
														<input type="hidden" name="entries_series_id[{{ $rel.Id }}]" value="{{ $rel.Id }}" />
														<input type="hidden" name="entries_series_series[{{ $rel.Id }}]" value="{{ $rel.Series }}" />
														<input type="hidden" name="entries_series_annotation[{{ $rel.Id }}]" value="{{ $rel.Annotation }}" />
													</td>
													<td class="px-3 py-2 text-right align-middle">
														<button type="button" data-role="content-series-delete" class="inline-flex items-center justify-center rounded-xs border border-red-300 bg-red-50 px-2.5 py-1.5 text-red-700 transition-colors hover:border-red-400 hover:bg-red-100 hover:text-red-900" aria-label="Entfernen">
															<i class="ri-delete-bin-line"></i>
														</button>
														<input data-role="content-series-delete-input" type="checkbox" class="hidden" name="entries_series_delete[{{ $rel.Id }}]" />
													</td>
												</tr>
											{{- end -}}
										{{- end -}}
									{{- end -}}
								</tbody>
							</table>
						</div>

						<div data-role="content-series-empty" class="px-3 py-2 text-sm text-slate-600 {{ if $hasNonPreferredSeries }}hidden{{ end }}">
							Keine Reihen verknüpft.
						</div>
						<div data-role="content-series-add-panel" class="hidden bg-stone-50 px-3 py-3">
							<div class="relative flex items-start gap-2">
								<div class="flex min-w-0 flex-1 items-start gap-2">
									<div class="min-w-0 flex-1">
										<label for="series-add-search" class="sr-only">Reihe suchen</label>
										<input
											id="series-add-search"
											data-role="content-series-add-input"
											type="text"
											autocomplete="off"
											class="h-9 w-full rounded-xs border border-stone-300 bg-white px-3 py-2 text-sm text-slate-900 focus:outline-none"
											placeholder="Reihe suchen..." />
										<div data-role="content-series-add-results" class="absolute left-0 right-0 top-full z-20 mt-1 hidden overflow-hidden rounded-xs border border-stone-200 bg-white shadow-lg"></div>
										<div data-role="content-series-add-error" class="mt-2 hidden text-xs font-semibold text-red-700"></div>
									</div>
									<a href="/admin/reihen/new/" target="_blank" rel="noreferrer" class="inline-flex h-9 items-center justify-center rounded-xs border border-stone-300 bg-white px-3 text-base text-slate-700 no-underline transition-colors hover:bg-stone-100" aria-label="Neue Reihe anlegen">
										<i class="ri-add-line"></i>
									</a>
								</div>
								<button type="button" data-role="content-series-add-confirm" class="inline-flex h-9 items-center justify-center rounded-xs bg-slate-800 px-3 text-base text-stone-50 transition-colors hover:bg-slate-900 disabled:cursor-not-allowed disabled:opacity-50" aria-label="Bestätigen" disabled>
									<i class="ri-check-line"></i>
								</button>
								<button type="button" data-role="content-series-add-abort" class="inline-flex h-9 items-center justify-center rounded-xs border border-stone-300 bg-white px-3 text-base text-slate-700 transition-colors hover:bg-stone-100" aria-label="Abbrechen">
									<i class="ri-close-line"></i>
								</button>
							</div>
						</div>
					</div>

					<template data-role="content-series-new-row-template">
						<tr data-role="content-series-row" data-kind="new" class="align-middle bg-orange-50/40">
							<td class="px-3 py-2 align-middle">
								<a data-role="content-series-link" target="_blank" rel="noreferrer" class="font-semibold text-slate-900 no-underline hover:text-slate-700">
									<span data-role="content-series-name"></span>
								</a>
								<input data-role="content-series-new-id" type="hidden" />
								<input data-role="content-series-new-annotation" type="hidden" />
							</td>
							<td class="px-3 py-2 text-right align-middle">
								<button type="button" data-role="content-series-delete" class="inline-flex items-center justify-center rounded-xs border border-red-300 bg-red-50 px-2.5 py-1.5 text-red-700 transition-colors hover:border-red-400 hover:bg-red-100 hover:text-red-900" aria-label="Entfernen">
									<i class="ri-delete-bin-line"></i>
								</button>
							</td>
						</tr>
					</template>
				</div>
			</content-series-relations>

			<div>
				<div class="inputwrapper">
					<div class="inputlabelrow">
						<div class="flex items-center gap-1">
						<label for="title" class="inputlabel">Titel</label>
						<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "title_statement" }}'>
							<i class="ri-question-line"></i>
						</span>
					</div>
					</div>

					<textarea name="title" id="title" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.TitleStmt -}}</textarea>
				</div>

				<div class="almanach-title-optionals mt-2 flex flex-col gap-2">
					<div id="titles"></div>
				</div>

				<div-manager dm-target="titles" class="flex flex-col items-end gap-2">
						<button class="dm-menu-button inline-flex items-center self-end leading-none text-right cursor-pointer whitespace-nowrap"><i class="ri-add-line"></i>
							Felder hinzufügen</button>

						<div class="inputwrapper {{ if eq $model.result.Entry.ParallelTitle "" }}hidden{{ end }}" data-dm-target="titles">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="paralleltitle" class="inputlabel menu-label">Titel
										(übersetzt)</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "parallel_title" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
								<div class="pr-2">
									<button class="dm-close-button font-bold input-label">
										<i class="ri-close-line"></i>
									</button>
								</div>
							</div>

							<textarea name="paralleltitle" id="paralleltitle" class="inputinput" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.ParallelTitle -}}</textarea>
						</div>

						<div class="inputwrapper {{ if eq $model.result.Entry.SubtitleStmt "" }}hidden{{ end }}" data-dm-target="titles">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="subtitle" class="inputlabel menu-label">Untertitel</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "subtitle_statement" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
								<div class="pr-2">
									<button class="dm-close-button font-bold input-label">
										<i class="ri-close-line"></i>
									</button>
								</div>
							</div>

							<textarea name="subtitle" id="subtitle" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.SubtitleStmt -}}</textarea>
						</div>

						<div class="inputwrapper {{ if eq $model.result.Entry.VariantTitle "" }}hidden{{ end }}" data-dm-target="titles">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="varianttitle" class="inputlabel menu-label">Titelvarianten</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "variant_title" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
								<div class="pr-2">
									<button class="dm-close-button font-bold input-label">
										<i class="ri-close-line"></i>
									</button>
								</div>
							</div>

							<textarea name="varianttitle" id="varianttitle" class="inputinput" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.VariantTitle -}}</textarea>
						</div>

						<div class="inputwrapper {{ if eq $model.result.Entry.IncipitStmt "" }}hidden{{ end }}" data-dm-target="titles">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="incipit" class="inputlabel menu-label">Incipit</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "incipit_statement" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
								<div class="pr-2">
									<button class="dm-close-button font-bold input-label">
										<i class="ri-close-line"></i>
									</button>
								</div>
							</div>

							<textarea name="incipit" id="incipit" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.IncipitStmt -}}</textarea>
						</div>

						<div class="inputwrapper {{ if eq $model.result.Entry.PublicationStmt "" }}hidden{{ end }}" data-dm-target="titles">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="publication_statement" class="inputlabel menu-label">Publikationsangabe</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "publication_statement" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
								<div class="pr-2">
									<button class="dm-close-button font-bold input-label">
										<i class="ri-close-line"></i>
									</button>
								</div>
							</div>

							<textarea name="publication_statement" id="publication_statement" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.PublicationStmt -}}</textarea>
						</div>
					</div-manager>

				<div class="mt-3 grid w-full grid-cols-2 gap-4 items-start">
					<div class="flex min-w-0 gap-2">
						<div class="inputwrapper min-w-0 flex-1">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="responsibility_statement" class="inputlabel">Herausgeberangabe</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "responsibility_statement" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
							</div>
							<textarea name="responsibility_statement" id="responsibility_statement" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.ResponsibilityStmt -}}</textarea>
						</div>

						<div class="inputwrapper shrink-0 self-end">
							<div class="px-3 py-2 flex flex-row gap-2 font-bold">
								<input type="checkbox" name="pseudonym" id="pseudonym" {{ if $model.result.Entry.Pseudonym }}checked{{ end }} data-boolean-checkbox />
								<label class="flex items-center gap-1 text-gray-700" for="pseudonym">
									<span>Pseudonym</span>
								</label>
							</div>
						</div>
					</div>

					<div class="inputwrapper min-w-0">
						<div class="inputlabelrow">
							<div class="flex items-center gap-1">
								<label for="place_statement" class="inputlabel">Ortsangabe</label>
								<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "place_statement" }}'>
									<i class="ri-question-line"></i>
								</span>
							</div>
						</div>

						<textarea name="place_statement" id="place_statement" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.PlaceStmt -}}</textarea>
					</div>
				</div>

				<div class="mt-3 grid w-full grid-cols-2 gap-4 items-start">
					<div class="min-w-0">
						<content-person-relations
							data-prefix="entries_agents"
							data-endpoint="/admin/api/agents/search"
							data-link-base="/person/"
							data-default-relation="Herausgeber:in"
							class="block">
							<div class="inputwrapper">
								<div class="inputlabelrow">
									<div class="flex items-center gap-1">
										<label class="inputlabel" for="agents-section">Verknüpfte Personen</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ helpOr "entries" "agents" "Beteiligte Personen oder Körperschaften." }}'>
											<i class="ri-question-line"></i>
										</span>
									</div>
									<div class="flex items-center gap-3">
										<button type="button" id="agents-add-toggle" data-role="content-person-add-toggle" class="text-sm font-bold text-gray-700 hover:text-slate-950 no-underline pr-3">
											<i class="ri-link"></i> Person verlinken
										</button>
									</div>
								</div>

								<div id="agents-section">
									<div class="overflow-hidden rounded-xs bg-white">
										<table class="min-w-full table-fixed text-sm">
											<tbody data-role="content-person-table-body" class="divide-y divide-stone-200">
												{{- if $model.result.EntriesAgents -}}
													{{- range $_, $r := $model.result.EntriesAgents -}}
														{{- $a := index $model.result.Agents $r.Agent -}}
														<tr data-role="content-person-row" data-kind="existing" class="align-middle">
															<td class="px-3 py-2 align-middle">
																{{- if $a -}}
																	<a
																		data-role="content-person-link"
																		href="/person/{{ $a.MusenalmID }}"
																		target="_blank"
																		rel="noreferrer"
																		class="font-semibold text-slate-900 no-underline hover:text-slate-700">
																		<span data-role="content-person-name">{{ $a.Name }}</span>
																	</a>
																{{- else -}}
																	<span data-role="content-person-name" class="font-semibold text-slate-900">Unbekannte Person</span>
																{{- end -}}
																{{- if and $a $a.BiographicalData -}}
																	<span data-role="content-person-life" class="ml-1.5 inline-block whitespace-nowrap italic text-slate-600">{{ $a.BiographicalData }}</span>
																{{- else -}}
																	<span data-role="content-person-life" class="ml-1.5 inline-block whitespace-nowrap italic text-slate-600"></span>
																{{- end -}}
																<input type="hidden" name="entries_agents_id[{{ $r.Id }}]" value="{{ $r.Id }}" />
																<input type="hidden" name="entries_agents_agent[{{ $r.Id }}]" value="{{ $r.Agent }}" />
															</td>
															<td class="px-3 py-2 align-middle">
																<select data-role="content-person-type" name="entries_agents_type[{{ $r.Id }}]" autocomplete="off" class="content-editor-meta-select min-w-[12rem] w-full">
																	{{- range $t := $model.agent_relations -}}
																		<option value="{{ $t }}" {{ if eq $r.Type $t }}selected{{ end }}>{{ $t }}</option>
																	{{- end -}}
																</select>
															</td>
															<td class="w-24 px-3 py-2 align-middle">
																<label class="inline-flex items-center gap-1 text-sm text-slate-700">
																	<input data-role="content-person-uncertain" type="checkbox" name="entries_agents_uncertain[{{ $r.Id }}]" {{ if $r.Uncertain }}checked{{ end }} />
																	<span>Unsicher</span>
																</label>
															</td>
															<td class="px-3 py-2 text-right align-middle">
																<button type="button" data-role="content-person-delete" class="inline-flex items-center justify-center rounded-xs border border-red-300 bg-red-50 px-2.5 py-1.5 text-red-700 transition-colors hover:border-red-400 hover:bg-red-100 hover:text-red-900" aria-label="Entfernen">
																	<i class="ri-delete-bin-line"></i>
																</button>
																<input data-role="content-person-delete-input" type="checkbox" class="hidden" name="entries_agents_delete[{{ $r.Id }}]" />
															</td>
														</tr>
													{{- end -}}
												{{- end -}}
											</tbody>
										</table>
									</div>

									<div data-role="content-person-empty" class="px-3 py-2 text-sm text-slate-600 {{ if $model.result.EntriesAgents }}hidden{{ end }}">
										Keine Personen verknüpft.
									</div>

									<div data-role="content-person-add-panel" class="hidden bg-stone-50 px-3 py-3">
										<div class="relative flex items-start gap-2">
											<div class="flex min-w-0 flex-1 items-start gap-2">
												<div class="min-w-0 flex-1">
													<label for="agents-add-search" class="sr-only">Person suchen</label>
													<input
														id="agents-add-search"
														data-role="content-person-add-input"
														type="text"
														autocomplete="off"
														class="h-9 w-full rounded-xs border border-stone-300 bg-white px-3 py-2 text-sm text-slate-900 focus:outline-none"
														placeholder="Person suchen..." />
													<div data-role="content-person-add-results" class="absolute left-0 right-0 top-full z-20 mt-1 hidden overflow-hidden rounded-xs border border-stone-200 bg-white shadow-lg"></div>
													<div data-role="content-person-add-error" class="mt-2 hidden text-xs font-semibold text-red-700"></div>
												</div>
												<a href="/admin/personen/new/" target="_blank" rel="noreferrer" class="inline-flex h-9 items-center justify-center rounded-xs border border-stone-300 bg-white px-3 text-base text-slate-700 no-underline transition-colors hover:bg-stone-100" aria-label="Neue Person anlegen">
													<i class="ri-add-line"></i>
												</a>
											</div>
											<button type="button" data-role="content-person-add-confirm" class="inline-flex h-9 items-center justify-center rounded-xs bg-slate-800 px-3 text-base text-stone-50 transition-colors hover:bg-slate-900 disabled:cursor-not-allowed disabled:opacity-50" aria-label="Bestätigen" disabled>
												<i class="ri-check-line"></i>
											</button>
											<button type="button" data-role="content-person-add-abort" class="inline-flex h-9 items-center justify-center rounded-xs border border-stone-300 bg-white px-3 text-base text-slate-700 transition-colors hover:bg-stone-100" aria-label="Abbrechen">
												<i class="ri-close-line"></i>
											</button>
										</div>
									</div>
								</div>

								<template data-role="content-person-new-row-template">
									<tr data-role="content-person-row" data-kind="new" class="align-middle bg-orange-50/40">
										<td class="px-3 py-2 align-middle">
											<a data-role="content-person-link" target="_blank" rel="noreferrer" class="font-semibold text-slate-900 no-underline hover:text-slate-700">
												<span data-role="content-person-name"></span>
											</a>
											<span data-role="content-person-life" class="ml-1.5 inline-block whitespace-nowrap italic text-slate-600"></span>
											<input data-role="content-person-new-id" type="hidden" />
										</td>
										<td class="px-3 py-2 align-middle">
											<select data-role="content-person-type" autocomplete="off" class="content-editor-meta-select min-w-[12rem] w-full">
												{{- range $t := $model.agent_relations -}}
													<option value="{{ $t }}" {{ if eq $t "Herausgeber:in" }}selected{{ end }}>{{ $t }}</option>
												{{- end -}}
											</select>
										</td>
										<td class="w-24 px-3 py-2 align-middle">
											<label class="inline-flex items-center gap-1 text-sm text-slate-700">
												<input data-role="content-person-uncertain" type="checkbox" />
												<span>Unsicher</span>
											</label>
										</td>
										<td class="px-3 py-2 text-right align-middle">
											<button type="button" data-role="content-person-delete" class="inline-flex items-center justify-center rounded-xs border border-red-300 bg-red-50 px-2.5 py-1.5 text-red-700 transition-colors hover:border-red-400 hover:bg-red-100 hover:text-red-900" aria-label="Entfernen">
												<i class="ri-delete-bin-line"></i>
											</button>
										</td>
									</tr>
								</template>
							</div>
						</content-person-relations>
					</div>

					<div class="min-w-0">
						<div class="inputwrapper">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="places" class="inputlabel">Verknüpfte Orte</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "places" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
								<div class="flex items-center gap-3">
									<a href="/admin/orte/new/" class="text-sm font-bold text-gray-700 hover:text-slate-950 no-underline" target="_blank" rel="noreferrer">
										<i class="ri-add-line"></i> Neuer Ort
									</a>
									<button type="button" id="places-add-toggle" class="text-sm font-bold text-gray-700 hover:text-slate-950 no-underline pr-3">
										<i class="ri-link"></i> Ort verlinken
									</button>
								</div>
							</div>
							<div class="px-2">
							<multi-select-simple
								id="places"
								name="places[]"
								data-external-toggle-id="places-add-toggle"
								value='[{{- range $i, $place := $model.result.Places -}}{{- if $i }},{{ end -}}"{{ $place.Id }}"{{- end -}}]'
									placeholder="Orte suchen..."
										data-toggle-label='<i class="ri-add-circle-line"></i>'
										data-empty-text="Keine Orte verknüpft"
										show-create-button="false"
										data-endpoint="/admin/api/places/search"
										data-result-key="places"
										data-minchars="1"
										data-limit="15"
										data-initial-options='[{{- range $i, $place := $model.result.Places -}}{{- if $i }},{{ end -}}{{ printf "{\"id\":%q,\"name\":%q,\"additional_data\":%q}" $place.Id $place.Name $place.Pseudonyms }}{{- end -}}]'
										data-initial-values='[{{- range $i, $place := $model.result.Places -}}{{- if $i }},{{ end -}}{{ printf "%q" $place.Id }}{{- end -}}]'>
								</multi-select-simple>
								</div>
						</div>
					</div>
				</div>
				<div class="flex flex-col gap-2 mt-4">
					<!-- Annotationen -->
					{{ template "_annotation_field" (Arr $model.result.Entry.Annotation "Annotationen") }}
				</div>
			</div>

		</div>
		<!-- End Left Column -->

		<!-- Right Column -->
		<div class="w-[28rem] shrink-0 flex flex-col gap-3">
			<div>
				{{ template "_status_edit" (Arr $model.result.Entry "type" "type" "entries" "almanach") }}
			</div>

			<div>
				<div class="flex flex-col gap-2 mt-4">
					<!-- Languages -->
					<div class="inputwrapper">
						<div class="inputlabelrow">
							<div class="flex items-center gap-1">
								<label for="languages" class="inputlabel">Sprachen</label>
								<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "language" }}'>
									<i class="ri-question-line"></i>
								</span>
							</div>
							<button type="button" id="languages-add-toggle" class="text-sm font-bold text-gray-700 hover:text-slate-950 no-underline pr-3">
								<i class="ri-link"></i> Sprache verlinken
							</button>
						</div>
						<div class="px-2">
						<multi-select-simple
							id="languages"
							name="languages[]"
							show-create-button="false"
							placeholder="Sprachen suchen..."
							data-toggle-label='<i class="ri-add-circle-line"></i>'
							data-empty-text="Keine Sprachen verknüpft"
							data-external-toggle-id="languages-add-toggle"
							value='[{{- range $i, $lang := $model.result.Entry.Language -}}{{- if $i }},{{ end -}}"{{ $lang }}"{{- end -}}]'></multi-select-simple>
							</div>
					</div>

					<!-- Nachweise - Always visible -->
					<div class="inputwrapper">
						<div class="inputlabelrow">
							<div class="flex items-center gap-1">
							<label for="refs" class="inputlabel">Nachweise</label>
							<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "refs" }}'>
								<i class="ri-question-line"></i>
							</span>
						</div>
						</div>
						<textarea name="refs" id="refs" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.References -}}</textarea>
					</div>

					<div-manager class="flex flex-col gap-2">
						<div class="inputwrapper {{ if eq $model.result.Entry.Extent "" }}hidden{{ end }}">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="extent" class="inputlabel menu-label">Struktur/Umfang</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "extent" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
								<div class="pr-2">
									<button class="dm-close-button font-bold input-label">
										<i class="ri-close-line"></i>
									</button>
								</div>
							</div>

							<textarea name="extent" id="extent" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.Extent -}}</textarea>
						</div>

						<div class="inputwrapper {{ if eq $model.result.Entry.Dimensions "" }}hidden{{ end }}">
							<div class="inputlabelrow">
								<div class="flex items-center gap-1">
									<label for="dimensions" class="inputlabel menu-label">Maße</label>
									<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "entries" "dimensions" }}'>
										<i class="ri-question-line"></i>
									</span>
								</div>
								<div class="pr-2">
									<button class="dm-close-button font-bold input-label">
										<i class="ri-close-line"></i>
									</button>
								</div>
							</div>

							<textarea name="dimensions" id="dimensions" class="inputinput no-enter" placeholder="" autocomplete="off" rows="1">{{- $model.result.Entry.Dimensions -}}</textarea>
						</div>

						<button class="dm-menu-button order-last text-right w-full cursor-pointer"><i class="ri-add-line"></i>
							Physische Beschreibung hinzufügen</button>
					</div-manager>
				</div>
			</div>
			{{- $deprecated := $model.result.Entry.Deprecated -}}
			{{- if or $deprecated.Reihentitel $deprecated.Norm (gt $deprecated.BiblioID 0) $deprecated.Status $deprecated.Gesichtet $deprecated.Erfasst -}}
			<details class="mt-2">
				<summary class="flex items-center gap-2 text-base font-bold text-stone-700 cursor-pointer select-none rounded-xs py-0.5 hover:bg-stone-50 hover:text-stone-900">
					<i class="ri-history-line"></i>
					<span>Abgekündigte Access-DB-Felder</span>
					<i class="ri-arrow-down-s-line text-base legacy-toggle-icon"></i>
				</summary>
				<hr class="border-slate-400 mt-1 mb-2" />
				<div class="text-xs leading-relaxed font-mono bg-slate-50 text-gray-600 border border-slate-200 rounded-xs px-3 py-2">
					<div class="grid grid-cols-[7.5rem_1fr] gap-x-3 gap-y-1">
						{{- if $deprecated.Reihentitel -}}
							<div class="text-gray-500">Reihentitel</div>
							<div>{{ $deprecated.Reihentitel }}</div>
						{{- end -}}
						{{- if $deprecated.Norm -}}
							<div class="text-gray-500">Norm</div>
							<div>{{ $deprecated.Norm }}</div>
						{{- end -}}
						{{- if gt $deprecated.BiblioID 0 -}}
							<div class="text-gray-500">Biblio-ID</div>
							<div>{{ $deprecated.BiblioID }}</div>
						{{- end -}}
						{{- if $deprecated.Status -}}
							<div class="text-gray-500">Status</div>
							<div>{{- range $i, $s := $deprecated.Status -}}{{- if $i }}, {{ end -}}{{- $s -}}{{- end -}}</div>
						{{- end -}}
						<div class="text-gray-500">Gesichtet</div>
						<div>{{ if $deprecated.Gesichtet }}Ja{{ else }}Nein{{ end }}</div>
						<div class="text-gray-500">Erfasst</div>
						<div>{{ if $deprecated.Erfasst }}Ja{{ else }}Nein{{ end }}</div>
					</div>
				</div>
			</details>
			{{- end -}}
			<!-- Exemplare -->
			<div class="">
				<items-editor class="block mt-2">
					<div class="flex items-center justify-between gap-4">
						<div class="flex items-center gap-2 text-base font-bold text-gray-700">
							<i class="ri-archive-line"></i>
							<span>Exemplare</span>
						</div>
						<button type="button" class="items-add-button text-gray-700 hover:text-gray-900">
							<i class="ri-add-line"></i> Exemplar hinzufügen
						</button>
					</div>
					<hr class="border-slate-400 mt-2 mb-3" />

					<div class="items-list flex flex-col gap-3">
						{{- range $i, $item := $model.result.Items -}}
							<div class="items-row border border-stone-200 rounded-xs bg-stone-50 flex flex-col gap-3 shadow-sm" data-item-id="{{ $item.Id }}">
								<input type="hidden" name="items_id[]" value="{{ $item.Id }}" />
								<div class="items-summary flex flex-col gap-2">
									<div class="flex items-center justify-between bg-stone-100 px-3 py-2 rounded-xs">
									<div class="text-base font-bold" data-summary-container>
											<span data-items-strike data-summary-field="owner" data-summary-hide-empty="true">{{ $item.Owner }}</span>
											<span data-new-badge class="items-new-badge hidden text-sm text-gray-600 ml-1">(Neu)</span>
										</div>
										<div class="px-2 py-0.5 bg-stone-200 text-sm font-bold rounded-sm" data-summary-container>
											<span data-items-strike data-summary-field="identifier" data-summary-hide-empty="true">{{ $item.Identifier }}</span>
										</div>
									</div>
									<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 px-3
									py-1">
										<div class="text-sm text-gray-700">
											<div class="flex flex-col gap-1 text-base">
												<div class="grid grid-cols-[6rem_1fr] gap-x-4 items-baseline" data-summary-container>
													<span class="text-xs uppercase tracking-wide text-gray-500">Standort</span>
													<span class="items-summary-value" data-items-strike data-summary-field="location" data-summary-hide-empty="true">{{ $item.Location }}</span>
												</div>
												<div class="grid grid-cols-[6rem_1fr] gap-x-4 items-baseline" data-summary-container>
													<span class="text-xs uppercase tracking-wide text-gray-500">Vorhanden als</span>
													<span class="items-summary-value" data-items-strike data-summary-field="media" data-summary-hide-empty="true">
														{{- range $j, $m := $item.Media -}}{{- if $j -}}, {{- end -}}{{- $m -}}{{- end -}}
													</span>
												</div>
												<div class="grid grid-cols-[6rem_1fr] gap-x-4 items-baseline" data-summary-container>
													<span class="text-xs uppercase tracking-wide text-gray-500">URL</span>
													<span class="items-summary-value" data-items-strike data-summary-field="uri" data-summary-hide-empty="true">
														<a class="no-underline" data-summary-link href="{{ $item.Uri }}" target="_blank" rel="noopener">{{ $item.Uri }}</a>
													</span>
												</div>
												<div class="grid grid-cols-[6rem_1fr] gap-x-4 items-baseline" data-summary-container>
													<span class="text-xs uppercase tracking-wide text-gray-500">Annotationen</span>
													<span class="items-summary-value" data-items-strike data-summary-field="annotation" data-summary-hide-empty="true">{{ $item.Annotation }}</span>
												</div>
											</div>
										</div>
									</div>
									<div class="flex justify-end mt-2 px-3">
										<div class="flex flex-row gap-3 text-lg">
											<button type="button" class="items-edit-button text-gray-700 hover:text-gray-900" aria-label="Bearbeiten">
												<i class="ri-edit-line"></i>
											</button>
											<button type="button" class="items-remove-button" aria-label="Entfernen">
												<i class="ri-delete-bin-line"></i>
												<span class="ml-1 text-sm no-underline" data-delete-label data-delete-default="Entfernen" data-delete-active="Wird entfernt" data-delete-hover="Rückgängig">Entfernen</span>
											</button>
										</div>
									</div>
								</div>
								<div class="items-edit-panel hidden">
								<!-- This gets used when editing an item -->
								<div class="flex flex-col gap-3 mt-3">
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="owner">Besitzer</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "owner" }}'>
											<i class="ri-question-line"></i>
										</span>
										<input class="inputinput" data-items-strike data-field="owner" name="items_owner[]" autocomplete="off" value="{{ $item.Owner }}" />
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="identifier">Signatur</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "identifier" }}'>
											<i class="ri-question-line"></i>
										</span>
										<input class="inputinput" data-items-strike data-field="identifier" name="items_identifier[]" autocomplete="off" value="{{ $item.Identifier }}" />
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="location">Standort</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "location" }}'>
											<i class="ri-question-line"></i>
										</span>
										<input class="inputinput" data-items-strike data-field="location" name="items_location[]" autocomplete="off" value="{{ $item.Location }}" />
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="media">Vorhanden als</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "media" }}'>
											<i class="ri-question-line"></i>
										</span>
										<select class="inputselect" data-items-strike data-field="media" name="items_media[]" autocomplete="off" required>
											{{- range $t := $model.item_types -}}
												<option value="{{- $t -}}" {{ if Contains $item.Media $t }}selected{{ end }}>{{- $t -}}</option>
											{{- end -}}
										</select>
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="annotation">Annotationen</label>
										<textarea class="inputtextarea min-h-[8rem]" data-items-strike data-field="annotation" name="items_annotation[]" autocomplete="off">{{- $item.Annotation -}}</textarea>
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="uri">URI</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "uri" }}'>
											<i class="ri-question-line"></i>
										</span>
										<input class="inputinput" data-items-strike data-field="uri" name="items_uri[]" autocomplete="off" value="{{ $item.Uri }}" />
									</div>
								</div>
								<div class="flex justify-end gap-3 mt-3 px-3 py-2">
									<button type="button" class="items-close-button resetbutton w-auto px-2 py-1 text-base">
										<i class="ri-check-line mr-2"></i> Fertig
									</button>
									<button type="button" class="items-cancel-button resetbutton w-auto px-2 py-1 text-base">
										<i class="ri-close-line mr-2"></i> Abbrechen
									</button>
									<button type="button" class="items-remove-button resetbutton w-auto px-2 py-1 text-base">
										<i class="ri-delete-bin-line mr-2"></i>
										<span class="no-underline" data-delete-label data-delete-default="Entfernen" data-delete-active="Wird entfernt" data-delete-hover="Rückgängig">Entfernen</span>
									</button>
								</div>
							</div>
							</div>
						{{- end -}}
					</div>
					<template class="items-template">
					<!-- This gets used when adding an item -->
						<div class="items-row border border-stone-200 rounded-xs bg-stone-50 flex flex-col gap-3 shadow-sm">
							<input type="hidden" name="items_id[]" value="" />
							<div class="items-summary hidden flex flex-col gap-2">
								<div class="flex items-center justify-between bg-stone-100 px-3 py-2 rounded-xs">
									<div class="text-base font-bold" data-summary-container>
										<span data-items-strike data-summary-field="owner" data-summary-hide-empty="true">—</span>
										<span data-new-badge class="items-new-badge hidden text-sm text-gray-600 ml-1">(Neu)</span>
									</div>
									<div class="px-2 py-0.5 bg-stone-200 text-sm font-bold rounded-sm" data-summary-container>
										<span data-items-strike data-summary-field="identifier" data-summary-hide-empty="true">—</span>
									</div>
								</div>
								<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 px-3 py-1">
									<div class="text-sm text-gray-700">
										<div class="flex flex-col gap-1 text-base">
											<div class="grid grid-cols-[6rem_1fr] gap-x-4 items-baseline" data-summary-container>
												<span class="text-xs uppercase tracking-wide text-gray-500">Standort</span>
												<span class="items-summary-value" data-items-strike data-summary-field="location" data-summary-hide-empty="true">—</span>
											</div>
											<div class="grid grid-cols-[6rem_1fr] gap-x-4 items-baseline" data-summary-container>
												<span class="text-xs uppercase tracking-wide text-gray-500">Vorh. als</span>
												<span class="items-summary-value" data-items-strike data-summary-field="media" data-summary-hide-empty="true">—</span>
											</div>
											<div class="grid grid-cols-[6rem_1fr] gap-x-4 items-baseline" data-summary-container>
												<span class="text-xs uppercase tracking-wide text-gray-500">URL</span>
												<span class="items-summary-value" data-items-strike data-summary-field="uri" data-summary-hide-empty="true">
													<a class="no-underline" data-summary-link href="#" target="_blank" rel="noopener">—</a>
												</span>
											</div>
											<div class="grid grid-cols-[6rem_1fr] gap-x-4 items-baseline" data-summary-container>
												<span class="text-xs uppercase tracking-wide text-gray-500">Annotationen</span>
												<span class="items-summary-value" data-items-strike data-summary-field="annotation" data-summary-hide-empty="true">—</span>
											</div>
										</div>
									</div>
								</div>
								<div class="flex justify-end mt-2 px-3">
									<div class="flex flex-row gap-3 text-lg">
										<button type="button" class="items-edit-button text-gray-700 hover:text-gray-900" aria-label="Bearbeiten">
											<i class="ri-edit-line"></i>
										</button>
										<button type="button" class="items-remove-button" aria-label="Entfernen">
											<i class="ri-delete-bin-line"></i>
											<span class="ml-1 text-sm no-underline" data-delete-label data-delete-default="Entfernen" data-delete-active="Wird entfernt" data-delete-hover="Rückgängig">Entfernen</span>
										</button>
									</div>
								</div>
							</div>
							<div class="items-edit-panel">
								<div class="flex flex-col gap-3 mt-3">
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="owner">Besitzer</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "owner" }}'>
											<i class="ri-question-line"></i>
										</span>
										<input class="inputinput" data-items-strike data-field="owner" name="items_owner[]" autocomplete="off" value="" />
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="identifier">Signatur</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "identifier" }}'>
											<i class="ri-question-line"></i>
										</span>
										<input class="inputinput" data-items-strike data-field="identifier" name="items_identifier[]" autocomplete="off" value="" />
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="location">Standort</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "location" }}'>
											<i class="ri-question-line"></i>
										</span>
										<input class="inputinput" data-items-strike data-field="location" name="items_location[]" autocomplete="off" value="" />
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="media">Vorhanden als</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "media" }}'>
											<i class="ri-question-line"></i>
										</span>
										<select class="inputselect" data-items-strike data-field="media" name="items_media[]" autocomplete="off" required>
											{{- range $t := $model.item_types -}}
												<option value="{{- $t -}}">{{- $t -}}</option>
											{{- end -}}
										</select>
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="annotation">Annotationen</label>
										<textarea class="inputtextarea min-h-[8rem]" data-items-strike data-field="annotation" name="items_annotation[]" autocomplete="off"></textarea>
									</div>
									<div class="inputwrapper">
										<label class="inputlabel" data-field-label="uri">URI</label>
										<span class="!inline" data-tippy-placement="top" data-tippy-content='{{ help "items" "uri" }}'>
											<i class="ri-question-line"></i>
										</span>
										<input class="inputinput" data-items-strike data-field="uri" name="items_uri[]" autocomplete="off" value="" />
									</div>
								</div>
								<div class="flex justify-end gap-3 mt-3 px-3 py-1">
									<button type="button" class="items-close-button resetbutton w-auto px-2 py-1 text-base">
										<i class="ri-check-line mr-2"></i> Fertig
									</button>
									<button type="button" class="items-cancel-button resetbutton w-auto px-2 py-1 text-base">
										<i class="ri-close-line mr-2"></i> Abbrechen
									</button>
								</div>
							</div>
						</div>
					</template>


				</items-editor>
			</div>
		</div>
		<!-- End Right Column -->
		</div>
		<div class="form-action-bar">
			<div class="form-action-bar-inner simple-entity-action-bar-inner">
				<div id="user-message" class="form-action-bar-message">
					<p
						id="almanach-save-feedback"
						class="save-feedback {{ if $model.error }}save-feedback-error text-red-700{{ else if $model.success }}save-feedback-success text-green-700{{ else }}hidden{{ end }}"
						{{ if $model.success }}data-autohide="true"{{ end }}
						aria-live="polite">
						{{- if $model.error -}}
							{{ $model.error }}
						{{- else if $model.success -}}
							{{ $model.success }}
						{{- end -}}
					</p>
				</div>
				<div class="form-action-bar-actions">
					<a href="{{ if $model.is_new }}/suche/baende{{ else }}/almanach/{{ $model.result.Entry.MusenalmID }}{{ end }}" class="simple-entity-button simple-entity-button-secondary w-40" data-role="cancel-link" data-cancel-url="{{ $model.cancel_url }}">
						<i class="ri-close-line"></i>
						<span>Abbrechen</span>
					</a>
					{{- if not $model.is_new -}}
						<button
							type="button"
							class="simple-entity-button simple-entity-button-danger w-40"
							data-role="almanach-delete">
							<i class="ri-delete-bin-line"></i>
							<span>Eintrag löschen</span>
						</button>
					{{- end -}}
					{{- if not $model.is_new -}}
						<button type="button" class="simple-entity-button simple-entity-button-primary w-40" data-role="almanach-save">
							<i class="ri-save-line"></i>
							<span>Speichern</span>
						</button>
						<button
							type="button"
							class="simple-entity-button simple-entity-button-primary"
							data-role="almanach-save-view"
							data-redirect-url="/almanach/{{ $model.result.Entry.MusenalmID }}">
							<i class="ri-eye-line"></i>
							<span>Speichern &amp; Anzeigen</span>
						</button>
					{{- end -}}
					{{- if $model.is_new -}}
						<button type="button" class="simple-entity-button simple-entity-button-primary w-40" data-role="almanach-save">
							<i class="ri-save-line"></i>
							<span>Speichern</span>
						</button>
					{{- end -}}
				</div>
			</div>
		</div>
		{{- if not $model.is_new -}}
		<dialog data-role="almanach-delete-dialog" class="fixed inset-0 m-auto rounded-md border border-slate-200 p-0 shadow-xl backdrop:bg-black/40">
			<div class="p-5 w-[22rem]">
					<div class="text-base font-bold text-gray-900">Eintrag löschen?</div>
					<div class="text-sm font-bold text-gray-900 mt-1">{{ $model.result.Entry.PreferredTitle }}</div>
					<p class="text-sm text-gray-700 mt-2">
						Der Eintrag wird dauerhaft gelöscht. Verknüpfungen, Exemplare und Beiträge werden entfernt.
					</p>
					<div class="flex items-center justify-end gap-3 mt-4">
						<button type="button" class="resetbutton w-auto px-3 py-1 text-sm" data-role="almanach-delete-cancel">Abbrechen</button>
						<button
							type="button"
							class="submitbutton w-auto bg-red-700 hover:bg-red-800 px-3 py-1 text-sm"
							data-role="almanach-delete-confirm">
							Löschen
						</button>
					</div>
			</div>
		</dialog>
		<dialog data-role="content-delete-dialog" class="dbform fixed inset-0 m-auto rounded-md border border-slate-200 p-0 shadow-xl backdrop:bg-black/40">
			<div class="p-5 w-[26rem]">
				<div class="text-base font-bold text-gray-900">Beitrag löschen?</div>
				<div data-role="content-delete-title" class="text-sm font-bold text-gray-900 mt-1"></div>
				<div data-role="content-delete-error" class="mt-2 text-sm text-red-700 hidden"></div>
				<div class="flex items-center justify-end gap-3 mt-4">
					<button type="button" class="resetbutton w-auto px-3 py-1 text-sm" data-role="content-delete-cancel">Abbrechen</button>
					<button
						type="button"
						class="submitbutton w-auto bg-red-700 hover:bg-red-800 px-3 py-1 text-sm"
						data-role="content-delete-confirm">
						Löschen
					</button>
				</div>
				<input type="hidden" data-role="content-delete-csrf" value="{{ $model.csrf_token }}" />
			</div>
		</dialog>
		<script>
			(() => {
				const dialog = document.querySelector("[data-role='content-delete-dialog']");
				if (!dialog) return;
				const titleEl = dialog.querySelector("[data-role='content-delete-title']");
				const errorEl = dialog.querySelector("[data-role='content-delete-error']");
				const cancelBtn = dialog.querySelector("[data-role='content-delete-cancel']");
				const confirmBtn = dialog.querySelector("[data-role='content-delete-confirm']");
				const csrfInput = dialog.querySelector("[data-role='content-delete-csrf']");

				let currentContentId = "";
				let currentDeleteEndpoint = "";

				const closeDialog = (event) => {
					if (event) {
						event.preventDefault();
					}
					if (dialog.open) {
						dialog.close();
					}
				};

				const openDialog = () => {
					if (typeof dialog.showModal === "function") {
						dialog.showModal();
					}
				};

				const setError = (message) => {
					if (!errorEl) return;
					if (message) {
						errorEl.textContent = message;
						errorEl.classList.remove("hidden");
					} else {
						errorEl.textContent = "";
						errorEl.classList.add("hidden");
					}
				};

				const handleDeleteClick = (event) => {
					let button = null;
					const path = typeof event.composedPath === "function" ? event.composedPath() : [];
					for (const node of path) {
						if (node && node.getAttribute && node.getAttribute("data-role") === "content-delete") {
							button = node;
							break;
						}
					}
					if (!button && event.target && event.target.closest) {
						button = event.target.closest("[data-role='content-delete']");
					}
					if (!button) return;
					event.preventDefault();
					event.stopPropagation();

					currentContentId = button.getAttribute("data-content-id") || "";
					currentDeleteEndpoint = button.getAttribute("data-delete-endpoint") || "";
					const contentTitle = button.getAttribute("data-content-title") || "";

					if (titleEl) {
						titleEl.textContent = contentTitle ? contentTitle : "Unbekannter Beitrag";
					}
					setError("");
					openDialog();
				};

				document.addEventListener("click", handleDeleteClick, true);

				if (cancelBtn) {
					cancelBtn.addEventListener("click", closeDialog);
				}
				dialog.addEventListener("cancel", closeDialog);

				if (confirmBtn) {
					confirmBtn.addEventListener("click", async (event) => {
						event.preventDefault();
						if (!currentDeleteEndpoint || !csrfInput || !currentContentId) return;
						setError("");
						const payload = new URLSearchParams();
						payload.set("csrf_token", csrfInput.value || "");
						payload.set("content_id", currentContentId);
						try {
							const response = await fetch(currentDeleteEndpoint, {
								method: "POST",
								headers: {
									"Content-Type": "application/x-www-form-urlencoded",
									"HX-Request": "true",
								},
								body: payload.toString(),
							});
							if (!response.ok) {
								throw new Error("Löschen fehlgeschlagen.");
							}
							closeDialog();
							if (currentContentId) {
								const items = document.querySelectorAll(`[data-content-id='${CSS.escape(currentContentId)}']`);
								items.forEach((item) => {
									const row = item.closest("li");
									if (row) row.remove();
								});
							}
						} catch (error) {
							setError(error instanceof Error ? error.message : "Löschen fehlgeschlagen.");
						}
					});
				}
			})();
		</script>
		{{- end -}}
	</form>
</div>
</div>
</almanach-edit-page>
