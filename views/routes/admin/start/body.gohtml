{{ $model := . }}
{{ $request := $model.request }}

<div class="admin-page-shell block">
	<header class="admin-page-header">
		<div class="admin-page-heading">
			<div>
				<h1 class="admin-page-title">Willkommen{{ if $request.user }}, {{ $request.user.Name }}{{ end }}</h1>
				{{/* Session expiry indicator */}}
				{{ $mins := $model.session_minutes_left }}
				{{ if gt $mins 120 }}
				<p class="admin-page-description text-slate-500 text-xs">
					Sitzung gültig bis <span class="ml-1 px-2 rounded-sm bg-slate-200 text-slate-900 px-2
																	 py-1 border border-slate-400">{{ GermanDate $model.session_expires_at
																	 }}</span>
				</p>
				{{ else if gt $mins 30 }}
				<p class="admin-page-description text-amber-600 text-xs font-medium">
					Sitzung läuft in <span class="px-2 rounded-sm bg-amber-100 text-amber-900 px-2
																				py-1">{{ $mins }} Minuten</span> ab
					<a href="/login" class="ml-2">Logout</a>
				</p>
				{{ else }}
				<p class="admin-page-description text-red-600 text-xs font-semibold">
					Sitzung läuft bald ab &ndash; noch <span class="ml-1 px-2 rounded-sm bg-red-100
																													text-red-900 px-2
																													py-1 border border-red-300">{{ $mins
																													}}&nbsp;Minuten</span>
					<a href="/login" class="ml-2">Logout</a>
				</p>
				{{ end }}
			</div>
		</div>
	</header>

	<div class="admin-page-body admin-page-body-simple">

		{{/* Stats row */}}
		{{ $stats := $model.stats }}
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-6">
			<a href="/admin/reihen/" class="bg-slate-50 rounded-xs border border-slate-200 px-4 py-3 flex flex-col gap-1 hover:bg-slate-100 transition-colors no-underline">
				<span class="text-2xl font-semibold text-slate-900 tabular-nums">{{ GermanInt $stats.Reihen }}</span>
				<span class="text-sm text-slate-500 flex items-center gap-1"><i class="ri-book-shelf-fill" aria-hidden="true"></i> Reihen</span>
			</a>
			<a href="/admin/baende/" class="bg-slate-50 rounded-xs border border-slate-200 px-4 py-3 flex flex-col gap-1 hover:bg-slate-100 transition-colors no-underline">
				<span class="text-2xl font-semibold text-slate-900 tabular-nums">{{ GermanInt $stats.Baende }}</span>
				<span class="text-sm text-slate-500 flex items-center gap-1"><i class="ri-book-line" aria-hidden="true"></i> Bände</span>
			</a>
			<a href="/admin/beitraege/" class="bg-slate-50 rounded-xs border border-slate-200 px-4 py-3 flex flex-col gap-1 hover:bg-slate-100 transition-colors no-underline">
				<span class="text-2xl font-semibold text-slate-900 tabular-nums">{{ GermanInt $stats.Inhalte }}</span>
				<span class="text-sm text-slate-500 flex items-center gap-1"><i
						class="ri-article-line" aria-hidden="true"></i> Beiträge</span>
			</a>
			<a href="/admin/beitraege/?offset=0&scans=with" class="bg-slate-50 rounded-xs border border-slate-200 px-4 py-3 flex flex-col gap-1 hover:bg-slate-100 transition-colors no-underline">
				<span class="text-2xl font-semibold text-slate-900 tabular-nums">{{ GermanInt $stats.Scans }}</span>
				<span class="text-sm text-slate-500 flex items-center gap-1"><i class="ri-image-line" aria-hidden="true"></i> Scans</span>
			</a>
			<a href="/admin/personen/" class="bg-slate-50 rounded-xs border border-slate-200 px-4 py-3 flex flex-col gap-1 hover:bg-slate-100 transition-colors no-underline">
				<span class="text-2xl font-semibold text-slate-900 tabular-nums">{{ GermanInt $stats.Persons }}</span>
				<span class="text-sm text-slate-500 flex items-center gap-1"><i class="ri-user-line" aria-hidden="true"></i> Personen</span>
			</a>
		</div>

		{{/* Recently edited */}}
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">

			{{/* Bände */}}
			<div id="baende-list-card" class="bg-slate-50 rounded-xs border border-slate-200">
				<div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
					<h2 class="text-sm font-semibold text-slate-900">Zuletzt bearbeitete Bände</h2>
					<div class="inline-flex gap-0.5">
						<button type="button" hx-get="/admin/start/baende/" hx-target="#baende-list-card" hx-swap="outerHTML" class="text-xs px-2 py-0.5 rounded bg-slate-200 text-slate-800 font-medium">Zuletzt bearbeitet</button>
						<button type="button" hx-get="/admin/start/baende/?mode=todo" hx-target="#baende-list-card" hx-swap="outerHTML" class="text-xs px-2 py-0.5 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-100">ToDo</button>
					</div>
				</div>
				{{ if $model.recent_baende }}
				<ul class="divide-y divide-slate-100 list-none my-0 overflow-y-auto" style="max-height:25rem">
					{{ range $model.recent_baende }}
						<li class="ml-0 list-none min-h-10 px-4 py-1.5 flex items-center gap-2 hover:bg-slate-100 transition-colors">
						<span class="shrink-0 inline-flex items-center {{ if eq .EditState "Edited" }}text-emerald-600{{ else if eq .EditState "Seen" }}text-blue-500{{ else if eq .EditState "Review" }}text-amber-500{{ else if eq .EditState "ToDo" }}text-orange-400{{ else }}text-slate-300{{ end }}" title="{{ if eq .EditState "Edited" }}Status: Vollständig Erfasst{{ else if eq .EditState "Seen" }}Status: Autopsiert{{ else if eq .EditState "Review" }}Status: Überprüfen{{ else if eq .EditState "ToDo" }}Status: Zu erledigen{{ else }}Status: Gesucht{{ end }}"><i class="text-xs {{ if eq .EditState "Edited" }}ri-checkbox-circle-line{{ else if eq .EditState "Seen" }}ri-information-line{{ else if eq .EditState "Review" }}ri-search-line{{ else if eq .EditState "ToDo" }}ri-list-check{{ else }}ri-forbid-2-line{{ end }}" aria-hidden="true"></i></span>
						<span class="text-[0.8rem] text-slate-500 bg-slate-100 border border-slate-200 rounded px-1.5 shrink-0 tabular-nums leading-5">{{ .MusenalmId }}</span>
						<span class="text-sm font-semibold text-slate-800 truncate min-w-0 flex-1">{{ if .PreferredTitle }}{{ .PreferredTitle }}{{ else }}<em class="font-normal text-slate-400">Kein Titel</em>{{ end }}</span>
						<span class="text-[0.7rem] text-slate-400 shrink-0 whitespace-nowrap">{{ GermanDate .Updated }}</span>
						<span class="inline-flex items-center gap-0.5 shrink-0">
							<a href="{{ .ViewURL }}" hx-boost="false" class="no-underline inline-flex items-center justify-center h-6 w-6 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors" title="Anzeigen" aria-label="Anzeigen">
								<i class="ri-eye-line text-xs" aria-hidden="true"></i>
							</a>
							<a href="{{ .EditURL }}" class="no-underline inline-flex items-center justify-center h-6 w-6 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors" title="Bearbeiten" aria-label="Bearbeiten">
								<i class="ri-edit-line text-xs" aria-hidden="true"></i>
							</a>
						</span>
					</li>
					{{ end }}
				</ul>
				{{ else }}
				<p class="px-4 py-3 text-sm text-slate-500">Keine Bände vorhanden.</p>
				{{ end }}
			</div>

			{{/* Inhalte */}}
			<div id="inhalte-list-card" class="bg-slate-50 rounded-xs border border-slate-200">
				<div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
					<h2 class="text-sm font-semibold text-slate-900">Zuletzt bearbeitete Beiträge</h2>
					<div class="inline-flex gap-0.5">
						<button type="button" hx-get="/admin/start/inhalte/" hx-target="#inhalte-list-card" hx-swap="outerHTML" class="text-xs px-2 py-0.5 rounded bg-slate-200 text-slate-800 font-medium">Zuletzt bearbeitet</button>
						<button type="button" hx-get="/admin/start/inhalte/?mode=todo" hx-target="#inhalte-list-card" hx-swap="outerHTML" class="text-xs px-2 py-0.5 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-100">ToDo</button>
					</div>
				</div>
				{{ if $model.recent_inhalte }}
				<ul class="divide-y divide-slate-100 list-none my-0 overflow-y-auto" style="max-height:25rem">
					{{ range $model.recent_inhalte }}
					<li class="ml-0 list-none min-h-10 px-4 py-1.5 flex items-center gap-2 hover:bg-slate-100 transition-colors">
						<span class="shrink-0 inline-flex items-center {{ if eq .EditState "Edited" }}text-emerald-600{{ else if eq .EditState "Seen" }}text-blue-500{{ else if eq .EditState "Review" }}text-amber-500{{ else if eq .EditState "ToDo" }}text-orange-400{{ else }}text-slate-300{{ end }}" title="{{ if eq .EditState "Edited" }}Status: Erfasst{{ else if eq .EditState "Seen" }}Status: Gesichtet{{ else if eq .EditState "Review" }}Status: Überprüfen{{ else if eq .EditState "ToDo" }}Status: Zu erledigen{{ else }}Status: Unbekannt{{ end }}"><i class="text-xs {{ if eq .EditState "Edited" }}ri-checkbox-circle-line{{ else if eq .EditState "Seen" }}ri-information-line{{ else if eq .EditState "Review" }}ri-search-line{{ else if eq .EditState "ToDo" }}ri-list-check{{ else }}ri-forbid-2-line{{ end }}" aria-hidden="true"></i></span>
						<span class="text-[0.8rem] text-slate-500 bg-slate-100 border border-slate-200 rounded px-1.5 shrink-0 tabular-nums leading-5">{{ .MusenalmId }}</span>
						<span class="text-sm font-semibold text-slate-800 truncate min-w-0 flex-1">{{ if .PreferredTitle }}{{ .PreferredTitle }}{{ else }}<em class="font-normal text-slate-400">Kein Titel</em>{{ end }}</span>
						{{- if .ImagePaths -}}
						<span class="inline-flex items-center gap-0.5 shrink-0">
							{{- range $i, $src := .ImagePaths -}}
							{{- if lt $i 3 -}}
							<popup-image data-image-url="{{ $src }}?thumb=0x300" data-full-image-url="{{ $src }}" class="inline-flex items-center">
								<img src="{{ $src }}?thumb=0x300" alt="Scan" class="h-5 w-5 rounded-full border border-slate-400 object-cover" />
							</popup-image>
							{{- end -}}
							{{- end -}}
						</span>
						{{- end -}}
						<span class="text-[0.7rem] text-slate-400 shrink-0 whitespace-nowrap">{{ GermanDate .Updated }}</span>
						<span class="inline-flex items-center gap-0.5 shrink-0">
							<a href="{{ .ViewURL }}" hx-boost="false" class="no-underline inline-flex items-center justify-center h-6 w-6 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors" title="Anzeigen" aria-label="Anzeigen">
								<i class="ri-eye-line text-xs" aria-hidden="true"></i>
							</a>
							<a href="{{ .EditURL }}" class="no-underline inline-flex items-center justify-center h-6 w-6 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors" title="Bearbeiten" aria-label="Bearbeiten">
								<i class="ri-edit-line text-xs" aria-hidden="true"></i>
							</a>
						</span>
					</li>
					{{ end }}
				</ul>
				{{ else }}
				<p class="px-4 py-3 text-sm text-slate-500">Keine Einträge vorhanden.</p>
				{{ end }}
			</div>
		</div>

		{{/* Recent scans strip */}}
		{{ if $model.recent_scan_paths }}
		<div id="scan-strip" class="bg-slate-50 rounded-xs border border-slate-200 px-4 py-3 flex items-center gap-4 mb-6 overflow-hidden">
			<div class="flex items-center gap-2 shrink-0">
				<span class="font-serif font-bold text-base text-slate-800 whitespace-nowrap">Letzte Scans</span>
				<button
					type="button"
					hx-get="/admin/start/scans/?random=1"
					hx-target="#scan-strip"
					hx-swap="outerHTML"
					class="group inline-flex items-center justify-center h-6 w-6 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors"
					title="Zufällige Scans laden"
					aria-label="Zufällige Scans laden">
					<i class="ri-dice-line text-sm group-hover:animate-dice-roll" aria-hidden="true"></i>
				</button>
			</div>
			<div class="w-px self-stretch bg-slate-300 shrink-0"></div>
			<div class="flex items-center gap-1 flex-wrap overflow-hidden" style="max-height:1.75rem">
				{{- range $model.recent_scan_paths -}}
				<popup-image data-image-url="{{ . }}?thumb=0x300" data-full-image-url="{{ . }}" class="inline-flex items-center shrink-0">
					<img src="{{ . }}?thumb=0x300" alt="Scan" class="h-7 w-7 rounded-full border border-slate-300 object-cover" />
				</popup-image>
				{{- end -}}
			</div>
		</div>
		{{ end }}

		{{/* System status — Admin only */}}
		{{- if (IsAdmin $request.user) -}}
		<div class="bg-slate-50 rounded-xs border border-slate-200 p-6">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

				{{/* Backup */}}
				<div>
					<div class="flex items-center gap-2 mb-2">
						<i class="ri-archive-line text-slate-500"></i>
						<h3 class="text-sm font-medium text-slate-700">Letztes Backup</h3>
					</div>
					{{ if $model.latest_export }}
					{{ $export := $model.latest_export }}
					<div class="text-sm text-slate-800">
						<p class="font-medium">{{ $export.Name }}</p>
						<p class="text-xs text-slate-500 mt-0.5">
							Erstellt: {{ GermanDate $export.Created }}&ensp;{{ GermanTime $export.Created }}
							{{ if $export.SizeLabel }}&ensp;&bull;&ensp;{{ $export.SizeLabel }}{{ end }}
						</p>
						<div class="mt-2 flex items-center gap-3">
							{{ if eq $export.Status "complete" }}
							<span class="inline-flex items-center gap-1 text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-2 py-0.5">
								<i class="ri-checkbox-circle-line"></i> Fertig
							</span>
							<a href="/admin/exports/download/{{ $export.Id }}" hx-boost="false" class="inline-flex
								items-center gap-1 text-xs text-slate-700 bg-white border border-slate-300
								rounded-sm px-2 py-0.5 hover:bg-slate-100 transition-colors no-underline">
								<i class="ri-download-line"></i> Herunterladen
							</a>
							{{ else if eq $export.Status "running" }}
							<span class="inline-flex items-center gap-1 text-xs text-blue-700 bg-blue-50 border border-blue-200 rounded-full px-2 py-0.5">
								<i class="ri-loader-4-line animate-spin"></i> Läuft&hellip;
							</span>
							{{ else if eq $export.Status "queued" }}
							<span class="inline-flex items-center gap-1 text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5">
								<i class="ri-time-line"></i> Warteschlange
							</span>
							{{ else if eq $export.Status "failed" }}
							<span class="inline-flex items-center gap-1 text-xs text-red-700 bg-red-50 border border-red-200 rounded-full px-2 py-0.5">
								<i class="ri-close-circle-line"></i> Fehler
							</span>
							{{ else }}
							<span class="text-xs text-slate-500">{{ $export.Status }}</span>
							{{ end }}
							<a href="/admin/exports/" class="text-xs text-slate-500 hover:text-slate-800 hover:underline">Alle Exporte</a>
						</div>
					</div>
					{{ else }}
					<p class="text-sm text-slate-500">Noch kein Backup vorhanden.</p>
					<a href="/admin/exports/" class="mt-2 inline-block text-xs text-slate-500 hover:text-slate-800 hover:underline">Backup starten</a>
					{{ end }}
				</div>

				{{/* Search index */}}
				<div>
					<div class="flex items-center gap-2 mb-2">
						<i class="ri-search-line text-slate-500"></i>
						<h3 class="text-sm font-medium text-slate-700">Suchindex</h3>
					</div>
					<div class="text-sm text-slate-800">
						{{ $status := $model.fts5_status }}
						{{ if or (eq $status "idle") (eq $status "done") (eq $status "complete") (eq $status "") }}
						<span class="inline-flex items-center gap-1 text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-2 py-0.5">
							<i class="ri-checkbox-circle-line"></i> Fertig
						</span>
						{{ else if or (eq $status "running") (eq $status "restarting") }}
						<span class="inline-flex items-center gap-1 text-xs text-blue-700 bg-blue-50 border border-blue-200 rounded-full px-2 py-0.5">
							<i class="ri-loader-4-line animate-spin"></i> Wird aufgebaut&hellip;
						</span>
						{{ else }}
						<span class="inline-flex items-center gap-1 text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5">
							<i class="ri-alert-line"></i> {{ $status }}
						</span>
						{{ end }}
						{{ if $model.fts5_last_rebuild_dt.IsZero | not }}
						<p class="text-xs text-slate-500 mt-1.5">Zuletzt aufgebaut: {{ GermanDate $model.fts5_last_rebuild_dt }}&ensp;{{ GermanTime $model.fts5_last_rebuild_dt }}</p>
						{{ else }}
						<p class="text-xs text-slate-500 mt-1.5">Noch nicht aufgebaut.</p>
						{{ end }}
						<a href="/admin/settings/" class="mt-2 inline-block text-xs text-slate-500 hover:text-slate-800 hover:underline">Index verwalten</a>
					</div>
				</div>

			</div>
		</div>
		{{- end -}}

	</div>
</div>
