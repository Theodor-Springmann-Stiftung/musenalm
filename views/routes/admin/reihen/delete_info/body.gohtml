{{ $series := .series }}
{{ $entries := .entries }}

<div>
	<div class="text-sm text-gray-700">
		Die Reihe wird dauerhaft gelöscht. Verknüpfungen werden entfernt; bevorzugt zugeordnete Bände werden mitgelöscht.
	</div>

	<div class="mt-3">
		<div class="text-sm font-semibold text-gray-700">Betroffene Bände ({{ len $entries }})</div>
		<div class="mt-2 max-h-40 overflow-auto pr-1">
			{{- if $entries -}}
				<ul class="m-0 flex list-none flex-col gap-2 pl-0 pr-0">
					{{- range $entry := $entries -}}
						<li class="ml-0 flex items-baseline justify-between gap-3 pl-0 text-sm text-gray-700">
							<span>
								{{- if $entry.PreferredTitle -}}
									{{ $entry.PreferredTitle }}
								{{- else if ne $entry.Year 0 -}}
									{{ $entry.Year }}
								{{- else -}}
									[Ohne Titel]
								{{- end -}}
							</span>
							<span class="text-xs text-gray-500">Alm {{ $entry.MusenalmID }}</span>
						</li>
					{{- end -}}
				</ul>
			{{- else -}}
				<div class="italic text-gray-500">Keine Bände betroffen.</div>
			{{- end -}}
		</div>
	</div>
</div>
