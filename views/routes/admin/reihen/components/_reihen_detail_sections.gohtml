{{ $series := .series }}
{{ $bandLinks := .band_links }}
{{ $canEdit := .can_edit }}

<div class="admin-list-detail-panel">
	{{- if $bandLinks -}}
		<div class="w-full pt-0">
			<div class="flex flex-col gap-1">
				{{- range $_, $link := $bandLinks -}}
					<div class="admin-list-detail-row">
						<div class="min-w-0">
							<a href="/almanach/{{ $link.Entry.MusenalmID }}/" target="_blank" rel="noopener" onclick="event.stopPropagation();" class="no-underline">
								<div class="{{- if eq $link.Entry.EditState "Edited" -}}font-bold{{- end -}}">
									{{- if $link.Entry.PreferredTitle -}}
										{{ $link.Entry.PreferredTitle }}
									{{- else if ne $link.Entry.Year 0 -}}
										{{ $link.Entry.Year }}
									{{- else -}}
										[o.J.]
									{{- end -}}
									<tool-tip position="right" class="inline">
										<i class="status-icon ml-1 align-middle {{- if eq $link.Entry.EditState "Edited" }} ri-checkbox-circle-line{{- else if eq $link.Entry.EditState "Seen" }} ri-information-line{{- else if eq $link.Entry.EditState "Review" }} ri-search-line{{- else if eq $link.Entry.EditState "ToDo" }} ri-list-check{{- else }} ri-forbid-2-line{{- end }}" data-status="{{ $link.Entry.EditState }}"></i>
										<div class="data-tip">
											{{- if eq $link.Entry.EditState "Unknown" -}}
												Gesucht
											{{- else if eq $link.Entry.EditState "ToDo" -}}
												Zu erledigen
											{{- else if eq $link.Entry.EditState "Review" -}}
												Überprüfen
											{{- else if eq $link.Entry.EditState "Seen" -}}
												Autopsiert
											{{- else if eq $link.Entry.EditState "Edited" -}}
												Vollständig Erfasst
											{{- else -}}
												{{ $link.Entry.EditState }}
											{{- end -}}
										</div>
									</tool-tip>
								</div>
							</a>
							{{- if and $link.Relation (not (eq $link.Relation.Type "Bevorzugter Reihentitel")) -}}
								<div class="admin-list-inline-meta mt-1 whitespace-nowrap">
									{{- if eq $link.Relation.Type "Früherer Reihentitel" -}}
										Titelauflage aus einer anderen Reihe
									{{- else if eq $link.Relation.Type "Späterer Reihentitel" -}}
										Titelauflage
									{{- else if eq $link.Relation.Type "In anderer Sprache" -}}
										{{- if Contains $link.Entry.Language "ger" -}}
											In deutscher Sprache
										{{- else -}}
											In französischer Sprache
										{{- end -}}
									{{- else -}}
										{{ $link.Relation.Type }}
									{{- end -}}
								</div>
							{{- end -}}
						</div>
						<div class="admin-list-detail-meta">
							<span class="admin-list-inline-stat bg-transparent px-0 text-black">Alm {{ $link.Entry.MusenalmID }}</span>
							<tool-tip position="top" class="inline">
								<a href="/almanach/{{ $link.Entry.MusenalmID }}/" target="_blank" rel="noopener" onclick="event.stopPropagation();" class="admin-list-chip no-underline">
									<i class="ri-external-link-line"></i>
								</a>
								<div class="data-tip">In neuem Tab öffnen</div>
							</tool-tip>
							{{- if $canEdit -}}
								<tool-tip position="top" class="inline">
									<a href="/admin/almanach/{{ $link.Entry.MusenalmID }}/edit/" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip no-underline">
										<i class="ri-edit-line"></i>
									</a>
									<div class="data-tip">Bearbeiten</div>
								</tool-tip>
							{{- end -}}
						</div>
					</div>
				{{- end -}}
			</div>
		</div>
	{{- else -}}
		<div class="w-full pt-0 text-sm text-gray-500">Keine Bände zugeordnet.</div>
	{{- end -}}
</div>
