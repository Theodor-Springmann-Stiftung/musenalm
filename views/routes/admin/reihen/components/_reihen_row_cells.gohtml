{{ $series := .series }}
<td class="col-reference pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 pl-4 admin-col-nachweis-reihen admin-col-wrap{{ if eq $series.EditState "ToDo" }} border-l-4 border-red-500{{ else if eq $series.EditState "Review" }} border-l-4 border-amber-500{{ end }}">
		<div class="flex flex-col">
			<div class="px-2.5 text-base font-semibold leading-snug text-slate-900">Nr {{ $series.MusenalmID }}</div>
			{{- if $series.References -}}
				<div class="reihen-admin-text mt-1 px-2.5 font-sans text-base leading-snug text-gray-700" title="{{ $series.References }}">{{ $series.References }}</div>
			{{- end -}}
		</div>
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 col-title">
	<div class="reihen-admin-text text-base font-semibold leading-snug text-slate-900">{{ $series.Title }}</div>
	{{- if $series.Annotation -}}
		<div class="reihen-admin-text annotation-content mt-1 font-sans text-base leading-snug text-gray-700">{{- Safe (ReplaceSlashParen $series.Annotation) -}}</div>
	{{- end -}}
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 col-modified admin-col-modified-reihen">
	{{ template "_modified_notes_cell" (Dict
		"updated" $series.Updated
		"editor_user" .editor_user
		"comment" $series.Comment
	) }}
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 col-verweise whitespace-nowrap text-right w-px">
	<div class="admin-list-count flex justify-end whitespace-nowrap">
		{{- if gt (len .band_links) 0 -}}
			<tool-tip position="top" class="inline">
				<a
					href="/admin/baende/?offset=0&sort=title&order=asc&series={{ $series.Id }}"
					onclick="event.stopPropagation();"
					hx-target="#admin-main-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					hx-indicator="#admin-main-loading"
					hx-headers='{"X-Admin-Main-Nav":"true"}'
					class="admin-list-chip">
					<i class="ri-book-line"></i>
					<span>{{ len .band_links }}</span>
				</a>
				<div class="data-tip">Bände anzeigen</div>
			</tool-tip>
		{{- else -}}
			<tool-tip position="top" class="inline">
				<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60">
					<i class="ri-book-line"></i>
					<span>0</span>
				</span>
				<div class="data-tip">Keine Bände verknüpft</div>
			</tool-tip>
		{{- end -}}
	</div>
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4">
	<div class="admin-list-actions">
		<div class="admin-list-action-stack">
			<tool-tip position="top" class="inline">
				<a href="/reihe/{{ $series.MusenalmID }}/" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip">
					<i class="ri-eye-line"></i>
				</a>
				<div class="data-tip">Anzeigen</div>
			</tool-tip>
			<tool-tip position="top" class="inline">
				<a href="/reihe/{{ $series.MusenalmID }}/" target="_blank" rel="noopener" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip">
					<i class="ri-external-link-line"></i>
				</a>
				<div class="data-tip">In neuem Tab öffnen</div>
			</tool-tip>
			{{- if .can_edit -}}
				<tool-tip position="top" class="inline">
					<a href="/admin/reihe/{{ $series.MusenalmID }}/edit" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip">
						<i class="ri-edit-line"></i>
					</a>
					<div class="data-tip">Bearbeiten</div>
				</tool-tip>
				<tool-tip position="top" class="inline">
					<button
						type="button"
						onclick="event.stopPropagation();"
						data-role="reihen-delete"
						data-series-id="{{ $series.MusenalmID }}"
						data-series-title="{{ $series.Title }}"
						data-last-edited="{{ $series.Updated }}"
						data-delete-endpoint="/admin/reihe/{{ $series.MusenalmID }}/edit/delete"
						class="admin-list-chip-danger">
						<i class="ri-delete-bin-line"></i>
					</button>
					<div class="data-tip">Löschen</div>
				</tool-tip>
			{{- end -}}
		</div>
	</div>
</td>
