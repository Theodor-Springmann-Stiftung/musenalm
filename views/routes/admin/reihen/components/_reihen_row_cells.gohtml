{{ $series := .series }}
<td class="col-reference pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 pl-4 admin-col-nachweis-reihen admin-col-wrap{{ if eq $series.EditState "ToDo" }} border-l-4 border-red-500{{ else if eq $series.EditState "Review" }} border-l-4 border-amber-500{{ end }}">
		<div class="flex flex-col">
			<div class="px-2.5 text-base font-semibold leading-snug text-slate-900">Nr {{ $series.MusenalmID }}</div>
			{{- if $series.References -}}
				<div class="reihen-admin-text mt-1 px-2.5 font-sans text-base leading-snug text-gray-700" title="{{ $series.References }}">{{ $series.References }}</div>
			{{- end -}}
		</div>
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 col-title">
	<div class="reihen-admin-text text-base font-semibold leading-snug text-slate-900">{{ $series.Title }}</div>
	{{- if $series.Annotation -}}
		<div class="reihen-admin-text annotation-content mt-1 font-sans text-base leading-snug text-gray-700">{{- Safe (ReplaceSlashParen $series.Annotation) -}}</div>
	{{- end -}}
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 col-modified admin-col-modified-reihen">
	{{ template "_modified_notes_cell" (Dict
		"updated" $series.Updated
		"editor_user" .editor_user
		"comment" $series.Comment
	) }}
</td>
	<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 whitespace-nowrap text-right w-px">
		<div class="admin-list-actions items-center gap-3">
			<div class="admin-list-count flex justify-end whitespace-nowrap">
				{{- if gt (len .band_links) 0 -}}
					<a
						href="/admin/baende/?offset=0&sort=title&order=asc&series={{ $series.Id }}"
						onclick="event.stopPropagation();"
						hx-target="#admin-main-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						hx-indicator="#admin-main-loading"
						hx-headers='{"X-Admin-Main-Nav":"true"}'
						class="admin-list-chip"
						title="Bände anzeigen"
						aria-label="Bände anzeigen">
						<i class="ri-book-line"></i>
						<span>{{ len .band_links }}</span>
					</a>
				{{- else -}}
					<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60" title="Keine Bände verknüpft" aria-label="Keine Bände verknüpft">
						<i class="ri-book-line"></i>
						<span>0</span>
					</span>
				{{- end -}}
			</div>
			<span
				class="col-status inline-flex"
				title="{{- if eq $series.EditState "Unknown" -}}Unbekannt{{- else if eq $series.EditState "ToDo" -}}Zu erledigen{{- else if eq $series.EditState "Review" -}}Überprüfen{{- else if eq $series.EditState "Seen" -}}Gesichtet{{- else if eq $series.EditState "Edited" -}}Erfasst{{- else -}}{{ $series.EditState }}{{- end -}}"
				aria-label="{{- if eq $series.EditState "Unknown" -}}Unbekannt{{- else if eq $series.EditState "ToDo" -}}Zu erledigen{{- else if eq $series.EditState "Review" -}}Überprüfen{{- else if eq $series.EditState "Seen" -}}Gesichtet{{- else if eq $series.EditState "Edited" -}}Erfasst{{- else -}}{{ $series.EditState }}{{- end -}}">
				<span class="status-badge admin-status-chip" data-status="{{ $series.EditState }}">
					<i class="status-icon {{- if eq $series.EditState "Edited" }} ri-checkbox-circle-line{{- else if eq $series.EditState "Seen" }} ri-information-line{{- else if eq $series.EditState "Review" }} ri-search-line{{- else if eq $series.EditState "ToDo" }} ri-list-check{{- else }} ri-forbid-2-line{{- end }}"></i>
				</span>
			</span>
			<div class="admin-list-action-stack">
				<div class="admin-list-chip-pair">
					<a href="/reihe/{{ $series.MusenalmID }}/" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip" title="Anzeigen" aria-label="Anzeigen">
						<i class="ri-eye-line"></i>
					</a>
					<a href="/reihe/{{ $series.MusenalmID }}/" target="_blank" rel="noopener" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip" title="In neuem Tab öffnen" aria-label="In neuem Tab öffnen">
						<i class="ri-external-link-line"></i>
					</a>
				</div>
				{{- if .can_edit -}}
					<a href="/admin/reihe/{{ $series.MusenalmID }}/edit" onclick="event.stopPropagation();" hx-target="body" class="admin-list-chip admin-list-chip-edit" title="Bearbeiten" aria-label="Bearbeiten">
						<i class="ri-edit-line"></i>
					</a>
					<button
						type="button"
						onclick="event.stopPropagation();"
						data-role="reihen-delete"
						data-series-id="{{ $series.MusenalmID }}"
						data-series-title="{{ $series.Title }}"
						data-last-edited="{{ $series.Updated }}"
						data-delete-endpoint="/admin/reihe/{{ $series.MusenalmID }}/edit/delete"
						class="admin-list-chip-danger"
						title="Löschen"
						aria-label="Löschen">
						<i class="ri-delete-bin-line"></i>
					</button>
				{{- end -}}
			</div>
		</div>
	</td>
