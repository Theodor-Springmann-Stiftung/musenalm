{{ $series := .series }}
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 pl-4 whitespace-nowrap w-[6.5rem]">
	<div class="flex flex-col gap-1">
		<span class="inline-flex w-full items-center px-2.5 py-0 text-sm font-semibold text-black">Nr {{ $series.MusenalmID }}</span>
		{{- if $series.References -}}
			<span class="reihen-admin-text inline-flex w-full items-center rounded-xs bg-stone-100 px-2.5 py-0.5 text-sm leading-snug text-slate-700 whitespace-normal break-words" title="{{ $series.References }}">{{ $series.References }}</span>
		{{- end -}}
	</div>
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 col-title w-[28rem]">
	<div class="reihen-admin-text text-base font-semibold leading-snug text-slate-900">{{ $series.Title }}</div>
	{{- if $series.Annotation -}}
		<div class="reihen-admin-text annotation-content mt-1 font-sans text-base leading-snug text-gray-700">{{- Safe (ReplaceSlashParen $series.Annotation) -}}</div>
	{{- end -}}
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-4 col-band-count whitespace-nowrap">
	<div class="text-sm text-stone-700">
		<tool-tip position="top" class="inline">
			<span class="inline-flex items-center gap-1">
				<i class="ri-book-line"></i>
				<span>{{ len .band_links }}</span>
			</span>
			<div class="data-tip">Bände</div>
		</tool-tip>
	</div>
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-8 col-modified w-[11.5rem]">
	{{ template "_modified_notes_cell" (Dict
		"updated" $series.Updated
		"editor_user" .editor_user
		"comment" $series.Comment
	) }}
</td>
<td class="pt-2 {{ if .expanded }}pb-0{{ else }}pb-2{{ end }} pr-8">
	<div class="flex items-start justify-end">
		<div class="flex items-center justify-end gap-1.5 whitespace-nowrap">
			<tool-tip position="top" class="inline">
				<a href="/reihe/{{ $series.MusenalmID }}/" target="_blank" rel="noopener" onclick="event.stopPropagation();" hx-target="body" class="no-underline inline-flex items-center gap-1 rounded-xs bg-stone-100 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-stone-200 hover:text-slate-900">
					<i class="ri-external-link-line"></i>
				</a>
				<div class="data-tip">In neuem Tab öffnen</div>
			</tool-tip>
			{{- if .can_edit -}}
				<tool-tip position="top" class="inline">
					<a href="/admin/reihe/{{ $series.MusenalmID }}/edit" onclick="event.stopPropagation();" hx-target="body" class="no-underline inline-flex items-center gap-1 rounded-xs bg-stone-100 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-stone-200 hover:text-slate-900">
						<i class="ri-edit-line"></i>
					</a>
					<div class="data-tip">Bearbeiten</div>
				</tool-tip>
				<tool-tip position="top" class="inline">
					<button
						type="button"
						onclick="event.stopPropagation();"
						data-role="reihen-delete"
						data-series-id="{{ $series.MusenalmID }}"
						data-series-title="{{ $series.Title }}"
						data-last-edited="{{ $series.Updated }}"
						data-delete-endpoint="/admin/reihe/{{ $series.MusenalmID }}/edit/delete"
						class="inline-flex items-center gap-1 rounded-xs bg-red-50 px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-100 hover:text-red-900">
						<i class="ri-delete-bin-line"></i>
					</button>
					<div class="data-tip">Löschen</div>
				</tool-tip>
			{{- end -}}
		</div>
	</div>
</td>
