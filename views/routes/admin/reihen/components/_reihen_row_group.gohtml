{{ $series := .series }}
<tbody data-role="reihen-row-group" data-series-id="{{ $series.MusenalmID }}">
	<tr
		class="admin-list-row admin-list-row-static{{ if eq $series.EditState "Unknown" }} bg-stone-100/70{{ else if eq $series.EditState "ToDo" }} bg-red-50{{ else if eq $series.EditState "Review" }} bg-amber-50{{ end }}"
		data-role="reihen-row"
		data-series-id="{{ $series.MusenalmID }}">
		{{ template "_reihen_row_cells" . }}
	</tr>
</tbody>
