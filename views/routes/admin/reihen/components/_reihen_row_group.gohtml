{{ $series := .series }}
<tbody data-role="reihen-row-group" data-series-id="{{ $series.MusenalmID }}">
	<tr
		class="align-top cursor-pointer transition-colors {{ if .expanded }}bg-slate-100 hover:bg-slate-100{{ else }}bg-slate-50 hover:bg-slate-100{{ end }}{{ if .expanded }} border-b-0{{ else }} border-b{{ end }}"
		data-role="reihen-row"
		data-series-id="{{ $series.MusenalmID }}"
		{{- if .expanded -}}
		hx-get="/admin/reihen/row/{{ $series.MusenalmID }}"
		{{- else -}}
		@click="closeExpandedRows('{{ $series.MusenalmID }}')"
		hx-get="/admin/reihen/details/{{ $series.MusenalmID }}"
		{{- end -}}
		hx-target="closest tbody"
		hx-swap="outerHTML">
		{{ template "_reihen_row_cells" . }}
	</tr>
	{{- if .expanded -}}
		<tr class="border-b bg-slate-100" data-role="reihen-details" data-series-id="{{ $series.MusenalmID }}">
			<td class="w-[6.5rem] py-0 pr-4 pl-4"></td>
			<td class="py-0 pr-4 pb-2 align-top">
				{{ template "_reihen_detail_sections" (Dict
					"series" $series
					"band_links" .band_links
					"can_edit" .can_edit
				) }}
			</td>
			<td class="py-0 pr-4 pb-2"></td>
			<td class="py-0 pr-8 pb-2"></td>
			<td class="py-0 pr-8 pb-2"></td>
		</tr>
	{{- end -}}
</tbody>
