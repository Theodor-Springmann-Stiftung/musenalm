{{ $group := . }}
{{ $entry := $group.Entry }}

<section
	class="rounded-b-xs border-x border-b border-stone-200 bg-white shadow-sm"
	data-role="beitraege-group"
	data-band-id="{{ $entry.MusenalmID }}"
	data-collapsed="false">
	<div
		class="flex items-center justify-between gap-4 border-b border-stone-400 bg-stone-200/60 px-4 py-2.5"
		data-role="beitraege-group-header">
		<div class="min-w-0 flex items-center gap-3">
				<button
					type="button"
					class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-xs text-slate-700 transition-colors hover:bg-stone-100 hover:text-slate-900"
					data-role="beitraege-group-toggle"
					aria-expanded="true"
					aria-label="Band einklappen"
				title="Band einklappen">
				<i class="ri-arrow-down-s-line text-lg" data-role="beitraege-group-toggle-icon"></i>
			</button>
			<button
				type="button"
				data-role="beitraege-group-toggle"
				aria-expanded="true"
				aria-label="Band einklappen"
				title="Band einklappen"
				class="beitraege-admin-search-text min-w-0 truncate font-serif text-left text-lg font-semibold text-slate-900 transition-colors hover:text-slate-700">
				{{- if $entry.PreferredTitle -}}
					{{- $entry.PreferredTitle -}}
				{{- else -}}
					Band {{ $entry.MusenalmID }}
				{{- end -}}
			</button>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			<span class="inline-flex h-8 items-center rounded-xs border border-stone-300 bg-white px-2.5 py-0 text-sm font-semibold text-slate-700">
				Alm {{ $entry.MusenalmID }}
			</span>
			<span class="inline-flex h-8 items-center rounded-xs border border-stone-300 bg-white px-2.5 py-0 text-sm font-semibold text-slate-700">
				{{ len $group.Rows }} {{ if eq (len $group.Rows) 1 }}Beitrag{{ else }}Beiträge{{ end }}
			</span>
				<a href="/admin/almanach/{{ $entry.MusenalmID }}/contents/edit" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}' data-admin-main-link class="admin-list-chip" title="Beiträge des Bandes" aria-label="Beiträge des Bandes">
					<i class="ri-article-line"></i>
				</a>
				<a href="/admin/almanach/{{ $entry.MusenalmID }}/edit/" class="admin-list-chip" title="Band bearbeiten" aria-label="Band bearbeiten">
					<i class="ri-book-line"></i>
				</a>
		</div>
	</div>

	<div class="divide-y divide-stone-200" data-role="beitraege-group-body">
		{{- range $_, $row := $group.Rows -}}
			{{ $content := $row.Content }}
			<div data-role="beitraege-row" class="grid grid-cols-[5.5rem_3.5rem_8rem_minmax(0,1fr)_5.5rem_auto_auto] gap-x-3 transition-colors odd:bg-white even:bg-stone-50/50 hover:bg-stone-50">
				<div data-role="beitraege-status-reference-cell" class="flex min-w-0 items-start pl-4 py-2.5 text-sm leading-snug text-slate-700">
					<div data-role="beitraege-ref-number" class="inline-flex w-[4.5rem] items-center justify-center rounded-xs border border-stone-200 bg-white px-1.5 py-0 text-[0.9rem] font-semibold text-slate-700">
						{{ $content.MusenalmID }}
					</div>
				</div>

				<div data-role="beitraege-col-page" class="mt-0.5 flex w-[3.5rem] min-w-0 items-start justify-center py-2.5">
					{{- if $content.Extent -}}
						<span data-role="beitraege-page-pill" class="inline-flex w-[3.5rem] items-center justify-center rounded-xs border border-blue-900 bg-blue-900 px-1 py-0.5 text-[0.9rem] font-semibold leading-none text-white">
							S.&thinsp;{{ $content.Extent }}
						</span>
					{{- end -}}
				</div>

				<div data-role="beitraege-col-type" class="beitraege-admin-search-text min-w-0 py-2.5 text-sm leading-snug text-slate-700">
					{{- if $content.MusenalmType -}}
						<div data-role="beitraege-type-group" class="flex flex-wrap items-start gap-1">
							{{- range $_, $type := $content.MusenalmType -}}
								<span class="rounded-xs bg-slate-200 px-1.5 py-0.5 text-[0.72rem] font-semibold text-slate-800">{{ $type }}</span>
							{{- end -}}
						</div>
					{{- end -}}
				</div>

				<div class="min-w-0 py-2.5">
					<div class="beitraege-admin-search-text min-w-0 text-[1rem] leading-snug text-slate-900">
						<a href="/beitrag/{{ $content.MusenalmID }}" class="font-semibold no-underline hover:text-slate-700">
							{{- if $content.PreferredTitle -}}
								{{- $content.PreferredTitle -}}
							{{- else if $content.TitleStmt -}}
								<span class="italic font-normal">{{ $content.TitleStmt }}</span>
							{{- else -}}
								Beitrag {{ $content.MusenalmID }}
							{{- end -}}
						</a>
						{{- if $content.ResponsibilityStmt -}}
							<span data-role="beitraege-content-responsibility" class="text-slate-700 italic">
								<span class="mx-1.5 font-semibold not-italic">&middot;</span>{{ $content.ResponsibilityStmt }}
								{{- if $content.Pseudonym -}}
									{{- template "_pseudonym_pill" $content -}}
								{{- end -}}
							</span>
						{{- end -}}
						{{- if $row.AgentDisplays -}}
							<span data-role="beitraege-content-linked-agents" class="text-slate-700">
								<span class="mx-1.5 font-semibold">&middot;</span>
								{{- range $i, $agent := $row.AgentDisplays -}}
									{{- if $i }}, {{ end -}}
									<a href="/admin/beitraege/?person={{ $agent.ID }}" class="underline decoration-dotted underline-offset-3 hover:text-slate-900 hover:decoration-solid">{{ $agent.Name }}</a>
								{{- end -}}
							</span>
						{{- end -}}
					</div>

					{{- if and $content.TitleStmt $content.IncipitStmt -}}
						<div data-role="beitraege-content-incipit" class="mt-1 flex items-start gap-2 text-sm leading-snug text-slate-700">
							<span class="inline-flex shrink-0 items-center rounded-xs bg-stone-100 px-1.5 py-0.5 text-[0.72rem] font-semibold leading-none text-slate-700">Incipit</span>
							<div class="beitraege-admin-search-text min-w-0 italic">{{ $content.IncipitStmt }}</div>
						</div>
					{{- end -}}
					{{- if $row.AnnotationPreview -}}
						<div data-role="beitraege-content-annotation" class="mt-1 flex items-start gap-2 text-sm leading-snug text-slate-700">
							<span class="inline-flex shrink-0 items-center rounded-xs bg-stone-100 px-1.5 py-0.5 text-[0.72rem] font-semibold leading-none text-slate-700">Anm.</span>
							<div class="beitraege-admin-search-text min-w-0">{{ $row.AnnotationPreview }}</div>
						</div>
					{{- end -}}
				</div>

				<div data-role="beitraege-col-scans" class="mt-1 flex min-w-0 items-start justify-end py-2.5">
					{{- $scans := $content.ImagePaths -}}
					{{- if $scans -}}
						<span class="inline-flex items-center justify-end gap-1">
							{{- range $i, $scan := $scans -}}
								{{- if lt $i 3 -}}
									<popup-image
										data-image-url="{{- $scan -}}?thumb=0x300"
										data-full-image-url="{{- $scan -}}"
										class="inline-flex items-center">
										<img
											src="{{- $scan -}}?thumb=0x300"
											alt="Scan Vorschau"
											class="h-5 w-5 rounded-full border border-slate-500 object-cover shadow-sm" />
									</popup-image>
								{{- end -}}
							{{- end -}}
						</span>
					{{- end -}}
				</div>

				<div data-role="beitraege-col-status" class="flex shrink-0 items-start py-2.5">
					{{- template "_status_picker" (Dict
						"status" $content.EditState
						"endpoint" (printf "/admin/almanach/%v/contents/status/%v" $entry.MusenalmID $content.MusenalmID)
						"last_edited" $content.Updated
						"picker_class" ""
						"toggle_class" "admin-list-status-trigger"
					) -}}
				</div>

					<div class="flex shrink-0 items-start gap-2 pr-4 py-2.5">
						<div class="admin-list-chip-pair" data-content-musenalm-id="{{ $content.MusenalmID }}">
							{{- if eq $content.EditState "ToDo" -}}
								<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60" title="Anzeigen (nicht öffentlich)" aria-label="Anzeigen (nicht öffentlich)" aria-disabled="true">
									<i class="ri-eye-line"></i>
								</span>
								<span class="admin-list-chip pointer-events-none border-stone-200 bg-stone-100 text-stone-400 opacity-60" title="In neuem Tab öffnen (nicht öffentlich)" aria-label="In neuem Tab öffnen (nicht öffentlich)" aria-disabled="true">
									<i class="ri-external-link-line"></i>
								</span>
							{{- else -}}
								<a href="/beitrag/{{ $content.MusenalmID }}" class="admin-list-chip" title="Anzeigen" aria-label="Anzeigen">
									<i class="ri-eye-line"></i>
								</a>
								<a href="/beitrag/{{ $content.MusenalmID }}" target="_blank" rel="noopener" class="admin-list-chip" title="In neuem Tab öffnen" aria-label="In neuem Tab öffnen">
									<i class="ri-external-link-line"></i>
								</a>
							{{- end -}}
						</div>
						<a href="/admin/almanach/{{ $entry.MusenalmID }}/contents/edit/{{ $content.MusenalmID }}" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}' data-admin-main-link class="admin-list-chip admin-list-chip-edit" title="Beitrag bearbeiten" aria-label="Beitrag bearbeiten">
							<i class="ri-edit-line"></i>
						</a>
						<button
							type="button"
							class="admin-list-chip-danger"
							data-role="beitraege-delete"
							data-entry-musenalm-id="{{ $entry.MusenalmID }}"
							data-content-id="{{ $content.Id }}"
							data-title="{{ if $content.PreferredTitle }}{{ $content.PreferredTitle }}{{ else if $content.TitleStmt }}{{ $content.TitleStmt }}{{ else }}Beitrag {{ $content.MusenalmID }}{{ end }}"
							title="Löschen"
							aria-label="Beitrag löschen">
							<i class="ri-delete-bin-line"></i>
						</button>
					</div>
				</div>
			{{- end -}}
		</div>
	</section>
