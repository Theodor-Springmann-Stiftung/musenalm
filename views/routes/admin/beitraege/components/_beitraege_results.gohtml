{{ $model := . }}

<div id="admin-beitraege-results"
	data-search="{{ $model.search }}"
	x-data="{
		hasMore: {{ if $model.has_more }}true{{ else }}false{{ end }},
		offset: {{ if $model.next_offset }}{{ $model.next_offset }}{{ else }}0{{ end }},
		loading: false,
		totalCount: {{ $model.total_count }},
		totalGroups: {{ $model.total_groups }},
		search: {{ printf "%q" $model.search }},
		entry: {{ printf "%q" $model.entry }},
		year: {{ printf "%q" $model.year }},
		person: {{ printf "%q" $model.person }},
		type: {{ printf "%q" $model.type }},
		status: {{ printf "%q" $model.status }},
		scans: {{ printf "%q" $model.scans }},
		sortField: {{ printf "%q" $model.sort_field }},
		buildMoreVals() {
			const values = { offset: this.offset };
			if (this.search) values.search = this.search;
			if (this.entry) values.entry = this.entry;
			if (this.year) values.year = this.year;
			if (this.person) values.person = this.person;
			if (this.type) values.type = this.type;
			if (this.status) values.status = this.status;
			if (this.scans) values.scans = this.scans;
			if (this.sortField) values.sort = this.sortField;
			return JSON.stringify(values);
		}
	}">

	{{- if $model.include_count_oob -}}
		<span id="admin-beitraege-count"
			hx-swap-oob="outerHTML"
			class="whitespace-nowrap text-lg font-semibold font-sans text-gray-600">
			{{- if $model.current_count -}}
				{{- GermanInt $model.current_count }}&thinsp;/&thinsp;
			{{- end -}}
			{{- GermanInt $model.total_count }} {{- if eq $model.total_count 1 }} Beitrag{{ else }} Beiträge{{ end }}{{ if $model.total_groups }} in {{ GermanInt $model.total_groups }} Bänden{{ end }}
		</span>
	{{- end -}}

	{{- if $model.result.Groups -}}
		<div id="admin-beitraege-groups" class="">
			{{ template "_beitraege_groups" $model }}
		</div>
	{{- else -}}
		<div class="rounded-xs border border-dashed border-stone-300 bg-stone-50 px-6 py-12 text-center text-base text-gray-600">
			Keine Beiträge gefunden.
		</div>
	{{- end -}}

	<div class="mt-6 flex justify-center" x-show="hasMore">
		<button
			type="button"
			data-role="beitraege-load-more"
			class="content-action-button"
			hx-get="/admin/beitraege/more/"
			:hx-vals="buildMoreVals()"
			hx-select="#admin-beitraege-more > *"
			hx-target="#admin-beitraege-groups"
			hx-swap="beforeend"
			hx-indicator="this"
			@htmx:before-request="loading = true"
			@htmx:after-request="
				loading = false;
				hasMore = $event.detail.xhr.getResponseHeader('X-Has-More') === 'true';
				offset = parseInt($event.detail.xhr.getResponseHeader('X-Next-Offset') || '0');
				const nextTotalCount = parseInt($event.detail.xhr.getResponseHeader('X-Total-Count') || '0');
				if (!Number.isNaN(nextTotalCount)) {
					totalCount = nextTotalCount;
				}
				const countEl = document.getElementById('admin-beitraege-count');
				if (countEl) {
					const currentCount = document.querySelectorAll('[data-role=&quot;beitraege-row&quot;]').length;
					const format = (value) => new Intl.NumberFormat('de-DE').format(value);
					const totalLabel = totalCount === 1 ? 'Beitrag' : 'Beiträge';
					const groupsLabel = totalGroups ? ` in ${format(totalGroups)} Bänden` : '';
					countEl.innerHTML = `${format(currentCount)}&thinsp;/&thinsp;${format(totalCount)} ${totalLabel}${groupsLabel}`;
				}
			"
			:disabled="loading">
			<i class="ri-arrow-down-line" :class="{ 'spinning': loading }"></i>
			<span x-text="loading ? 'Lädt...' : 'Weitere Beiträge laden'">Weitere Beiträge laden</span>
		</button>
	</div>

</div>
