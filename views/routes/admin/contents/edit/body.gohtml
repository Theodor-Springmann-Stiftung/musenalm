{{ $model := . }}
{{- $bandTitle := "Neuer Band" -}}
{{- if $model.result -}}
	{{- $bandTitle = $model.result.Entry.PreferredTitle -}}
{{- end -}}
{{- $contentCount := 0 -}}
{{- if and $model.result $model.result.Contents -}}
	{{- $contentCount = len $model.result.Contents -}}
{{- end -}}

<edit-page>
<div class="simple-entity-page">
<div class="flex h-full min-h-0 flex-1 overflow-hidden" data-role="contents-edit-layout">
<div class="flex h-full min-h-0 min-w-0 flex-1 basis-0 flex-col overflow-hidden">
<header class="admin-page-header simple-entity-header">
	<div class="simple-entity-title-row">
		<tool-tip position="top" class="inline">
			<span class="simple-entity-title-icon" aria-label="Beiträge">
				<i class="ri-article-line"></i>
			</span>
			<div class="data-tip">Beiträge</div>
		</tool-tip>
		<h1 class="simple-entity-title">{{ $bandTitle }}</h1>
	</div>

	{{- if $model.result -}}
		<div class="admin-list-toolbar">
			<div class="admin-list-toolbar-primary simple-entity-header-actions">
				<tool-tip position="top" class="inline">
					<a href="/admin/almanach/{{ $model.result.Entry.MusenalmID }}/edit/" class="simple-entity-header-button simple-entity-header-chip" aria-label="Band">
						<i class="ri-book-line"></i>
						<span>Band</span>
					</a>
					<div class="data-tip">Band bearbeiten</div>
				</tool-tip>
				<tool-tip position="top" class="inline">
					<a href="/almanach/{{ $model.result.Entry.MusenalmID }}" class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip" aria-label="Anschauen">
						<i class="ri-eye-line"></i>
					</a>
					<div class="data-tip">Anschauen</div>
				</tool-tip>
				<tool-tip position="top" class="inline">
					<a href="/almanach/{{ $model.result.Entry.MusenalmID }}" target="_blank" rel="noopener" class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip" aria-label="In neuem Tab öffnen">
						<i class="ri-external-link-line"></i>
					</a>
					<div class="data-tip">In neuem Tab öffnen</div>
				</tool-tip>
				<tool-tip position="top" class="inline">
					<a href="/admin/baende/" class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip" aria-label="Liste aller Bände">
						<i class="ri-list-check-2"></i>
					</a>
					<div class="data-tip">Liste aller Bände</div>
				</tool-tip>
				{{- if $model.result.PrevByTitle -}}
					<tool-tip position="top" class="inline">
						<a href="/admin/almanach/{{ $model.result.PrevByTitle.MusenalmID }}/contents/edit" class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip" aria-label="Vorheriger Eintrag">
							<i class="ri-arrow-left-s-line"></i>
						</a>
						<div class="data-tip">{{ $model.result.PrevByTitle.PreferredTitle }}</div>
					</tool-tip>
				{{- else -}}
					<span class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip simple-entity-header-chip-disabled" aria-hidden="true">
						<i class="ri-arrow-left-s-line"></i>
					</span>
				{{- end -}}
				<span class="simple-entity-header-az">A&thinsp;&ndash;&thinsp;Z</span>
				{{- if $model.result.NextByTitle -}}
					<tool-tip position="top" class="inline">
						<a href="/admin/almanach/{{ $model.result.NextByTitle.MusenalmID }}/contents/edit" class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip" aria-label="Nächster Eintrag">
							<i class="ri-arrow-right-s-line"></i>
						</a>
						<div class="data-tip">{{ $model.result.NextByTitle.PreferredTitle }}</div>
					</tool-tip>
				{{- else -}}
					<span class="simple-entity-header-button simple-entity-header-button-icon simple-entity-header-chip simple-entity-header-chip-disabled" aria-hidden="true">
						<i class="ri-arrow-right-s-line"></i>
					</span>
				{{- end -}}
			</div>

			<div class="admin-list-toolbar-secondary simple-entity-meta-inline" id="contents-header-data">
				<span class="simple-entity-meta-item">
					{{- if $model.result.PrevByID -}}
						<tool-tip position="top" class="inline">
							<a href="/admin/almanach/{{ $model.result.PrevByID.MusenalmID }}/contents/edit" class="simple-entity-meta-nav" aria-label="Vorherige Musenalm-ID">
								<i class="ri-arrow-left-s-line"></i>
							</a>
							<div class="data-tip">{{ $model.result.PrevByID.MusenalmID }}: {{ $model.result.PrevByID.PreferredTitle }}</div>
						</tool-tip>
					{{- else -}}
						<span class="simple-entity-meta-nav simple-entity-meta-nav-disabled" aria-hidden="true">
							<i class="ri-arrow-left-s-line"></i>
						</span>
					{{- end -}}
					<tool-tip position="top" class="inline">
						<span class="simple-entity-meta-icon" aria-hidden="true">
							<i class="ri-fingerprint-line"></i>
						</span>
						<div class="data-tip">{{ help "entries" "musenalm_id" }}</div>
					</tool-tip>
					<span class="simple-entity-meta-item-value tabular-nums">{{ $model.result.Entry.MusenalmID }}</span>
					{{- if $model.result.NextByID -}}
						<tool-tip position="top" class="inline">
							<a href="/admin/almanach/{{ $model.result.NextByID.MusenalmID }}/contents/edit" class="simple-entity-meta-nav" aria-label="Nächste Musenalm-ID">
								<i class="ri-arrow-right-s-line"></i>
							</a>
							<div class="data-tip">{{ $model.result.NextByID.MusenalmID }}: {{ $model.result.NextByID.PreferredTitle }}</div>
						</tool-tip>
					{{- else -}}
						<span class="simple-entity-meta-nav simple-entity-meta-nav-disabled" aria-hidden="true">
							<i class="ri-arrow-right-s-line"></i>
						</span>
					{{- end -}}
				</span>
				<span class="simple-entity-meta-sep">|</span>
				<span class="simple-entity-meta-item">
					<tool-tip position="top" class="inline">
						<span class="simple-entity-meta-icon" aria-hidden="true">
							<i class="ri-database-2-line"></i>
						</span>
						<div class="data-tip">Datenbank-ID</div>
					</tool-tip>
					<span class="simple-entity-meta-item-value tabular-nums">{{ $model.result.Entry.Id }}</span>
				</span>
				<span class="simple-entity-meta-sep">|</span>
				<span class="simple-entity-meta-item">
					<tool-tip position="top" class="inline">
						<span class="simple-entity-meta-icon" aria-hidden="true">
							<i class="ri-calendar-line"></i>
						</span>
						<div class="data-tip">Zuletzt bearbeitet</div>
					</tool-tip>
					<span class="simple-entity-meta-item-value tabular-nums">{{ GermanShortDateTime $model.result.Entry.Updated }}</span>
				</span>
				{{- if $model.result.User -}}
					<span class="simple-entity-meta-sep">|</span>
					<span class="simple-entity-meta-item">
						<tool-tip position="top" class="inline">
							<span class="simple-entity-meta-icon" aria-hidden="true">
								<i class="ri-user-line"></i>
							</span>
							<div class="data-tip">Zuletzt bearbeitet von</div>
						</tool-tip>
						<span class="simple-entity-meta-item-value">{{ $model.result.User.Name }}</span>
					</span>
				{{- end -}}
			</div>
		</div>
	{{- end -}}
</header>

<div class="admin-page-body admin-page-body-wide admin-page-body-flush admin-page-body-tight-top flex h-full min-h-0 flex-1 flex-col overflow-hidden">
	{{ template "_usermessage" $model }}
	<div class="flex items-center gap-3 hidden">
		<form
			method="POST"
			action="/admin/almanach/{{ $model.result.Entry.MusenalmID }}/contents/edit/extent"
			class="extent-inline flex-1 grid grid-cols-[max-content_minmax(12rem,1fr)_max-content] items-center gap-2">
			<input type="hidden" name="csrf_token" value="{{ $model.csrf_token }}" />
			<label for="contents-extent" class="text-base font-bold text-gray-700">Struktur</label>
			<input
				id="contents-extent"
				name="extent"
				type="text"
				class="min-w-[10rem] w-full max-w-none flex-1 border border-slate-300 rounded-xs bg-white px-3 py-1.5 text-base leading-6 text-gray-800 focus:outline-none focus:ring-2 focus:ring-slate-400/30"
				placeholder="z. B. 12 Bl., 3 Taf."
				value="{{- $model.result.Entry.Extent -}}" />
			<button type="submit" class="rounded-xs border border-slate-300 bg-stone-50 px-3 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-stone-100">
				Struktur speichern
			</button>
		</form>
	</div>
	<div class="flex h-full min-h-0 flex-1 basis-0 flex-col overflow-hidden" data-role="contents-edit-workspace">
		{{ template "_workspace" $model }}
	</div>
</div>
	</div>
	{{- if $model.open -}}
		{{ template "_editor_panel" $model }}
	{{- else -}}
		{{ template "_editor_panel" (Dict "open" false) }}
	{{- end -}}
</div>

<dialog id="content-delete-dialog" class="dbform fixed inset-0 m-auto rounded-md border border-slate-200 p-0 shadow-xl backdrop:bg-black/40">
	<div class="p-5 w-[22rem]">
		<div class="text-base font-bold text-gray-900">Eintrag löschen?</div>
		<div id="content-delete-dialog-title" class="text-sm font-bold text-gray-900 mt-1"></div>
		<p class="text-sm text-gray-700 mt-2">
			Der Eintrag wird dauerhaft gelöscht. Verknüpfungen, Exemplare und Beiträge werden entfernt.
		</p>
		<div class="flex items-center justify-end gap-3 mt-4">
			<button type="button" class="resetbutton w-auto px-3 py-1 text-sm" data-role="content-delete-cancel">Abbrechen</button>
			<button type="button" class="submitbutton w-auto bg-red-700 hover:bg-red-800 px-3 py-1 text-sm" data-role="content-delete-confirm">
				Löschen
			</button>
		</div>
	</div>
</dialog>

<dialog id="content-renumber-dialog" class="dbform fixed inset-0 m-auto rounded-md border border-slate-200 p-0 shadow-xl backdrop:bg-black/40">
	<div class="p-5 w-[32rem] max-w-[calc(100vw-2rem)]">
		<div class="text-base font-bold text-gray-900">Beiträge neu nummerieren?</div>
		<div id="content-renumber-dialog-title" class="text-sm font-bold text-gray-900 mt-1"></div>
		<p class="text-sm text-gray-700 mt-3">
			Achtung: Durch das Neu-Nummerieren können Verweise auf Beitragsnummern auf der Musenalm ungültig werden, insb. in Anmerkungen von Beiträgen oder Bänden.
		</p>
		<p id="content-renumber-dialog-warning" class="hidden text-sm font-bold text-gray-900 mt-3">
			Achtung! Bisherige URLs werden invalidiert, oder können zu anderen Beiträgen führen!
		</p>
		<div class="flex items-center justify-end gap-3 mt-5">
			<button type="button" class="resetbutton w-auto px-3 py-1 text-sm" data-role="content-renumber-cancel">Abbrechen</button>
			<button type="button" class="submitbutton w-auto bg-orange-700 hover:bg-orange-800 px-3 py-1 text-sm" data-role="content-renumber-confirm">
				Bestätigen
			</button>
		</div>
	</div>
</dialog>
</edit-page>

<script>
	// Search index: object keyed by content ID with all searchable fields
	window.contentsSearchIndex = {
		{{- range $i, $content := $model.result.Contents -}}
		{{- if $i }},{{ end }}
		"{{ $content.Id }}": {
			extent: "{{ $content.Extent }}",
			musenalmType: [{{- range $j, $t := $content.MusenalmType -}}{{- if $j }},{{ end }}"{{ $t }}"{{- end -}}],
			preferredTitle: "{{ $content.PreferredTitle }}",
			titleStmt: "{{ $content.TitleStmt }}",
			status: "{{ $content.EditState }}",
			subtitleStmt: "{{ $content.SubtitleStmt }}",
			incipitStmt: "{{ $content.IncipitStmt }}",
			responsibilityStmt: "{{ $content.ResponsibilityStmt }}",
			parallelTitle: "{{ $content.ParallelTitle }}",
			variantTitle: "{{ $content.VariantTitle }}",
			placeStmt: "{{ $content.PlaceStmt }}",
			language: [{{- range $j, $lang := $content.Language -}}{{- if $j }},{{ end }}"{{ $lang }}"{{- end -}}],
			contentType: [{{- range $j, $ct := $content.ContentType -}}{{- if $j }},{{ end }}"{{ $ct }}"{{- end -}}],
			comment: "{{ $content.Comment }}",
			agents: [
				{{- $contentAgentDisplays := index $model.result.ContentAgentDisplays $content.Id -}}
				{{- range $j, $agent := $contentAgentDisplays -}}
					{{- if $j }},{{ end }}{name: "{{ $agent.Name }}", bio: "{{ $agent.LifeDates }}"}
				{{- end -}}
			],
			annotation: {{ SafeJS $content.Annotation }}
		}
		{{- end -}}
	};
</script>
</div>

<script type="module">
	let list = null;
	const contentsBasePath = "/admin/almanach/{{ $model.result.Entry.MusenalmID }}/contents/edit";
	const closedEditorPanelMarkup = '<div id="contents-editor-panel-shell" data-role="contents-editor-panel-shell" data-open="false" class="hidden"></div>';
	const contentsEditorSidebarLockId = "contents-editor-panel";
	const scrollLockCache = new Map();
	const trimTrailingSlash = (value) => {
		if (!value) {
			return "/";
		}
		const trimmed = value.replace(/\/+$/, "");
		return trimmed || "/";
	};
	const buildContentsPanelPath = (contentMusenalmId) => `${contentsBasePath}/${contentMusenalmId}`;
	const getPanelMusenalmIdFromPath = (path = window.location.pathname) => {
		const normalizedPath = trimTrailingSlash(path);
		const normalizedBase = trimTrailingSlash(contentsBasePath);
		if (!normalizedPath.startsWith(normalizedBase + "/")) {
			return "";
		}
		return normalizedPath.slice(normalizedBase.length + 1).split("/")[0] || "";
	};
	const setContentsHistoryPath = (path, replace = true) => {
		const normalizedTarget = trimTrailingSlash(path);
		const normalizedCurrent = trimTrailingSlash(window.location.pathname);
		if (normalizedTarget === normalizedCurrent) {
			return;
		}
		window.history[replace ? "replaceState" : "pushState"](null, "", normalizedTarget);
	};
	const getOrderedContentItems = () => {
		const currentList = list || document.querySelector("[data-role='contents-list']");
		if (!currentList) {
			return [];
		}
		return Array.from(currentList.querySelectorAll("[data-role='content-item'][data-content-musenalm-id]"));
	};
	const getAdjacentContentMusenalmIds = (contentMusenalmId) => {
		const items = getOrderedContentItems();
		const currentIndex = items.findIndex((item) => item.dataset.contentMusenalmId === contentMusenalmId);
		if (currentIndex === -1) {
			return { prev: "", next: "" };
		}
		return {
			prev: items[currentIndex - 1]?.dataset.contentMusenalmId || "",
			next: items[currentIndex + 1]?.dataset.contentMusenalmId || "",
		};
	};
	const openEditorPanelForContent = async (contentMusenalmId, { replaceUrl = false } = {}) => {
		if (!contentMusenalmId) {
			return false;
		}
		const path = buildContentsPanelPath(contentMusenalmId);
		const loaded = await loadEditorPanelForPath(path);
		if (loaded) {
			setContentsHistoryPath(path, replaceUrl);
		}
		return loaded;
	};
	const getOpenPanelMusenalmId = () => {
		const panelShell = document.querySelector("[data-role='contents-editor-panel-shell']");
		return panelShell?.dataset.contentMusenalmId || "";
	};
	const lockAdminSidebarForEditor = () => {
		window.__adminSidebarController?.lock?.(contentsEditorSidebarLockId);
	};
	const unlockAdminSidebarForEditor = () => {
		window.__adminSidebarController?.unlock?.(contentsEditorSidebarLockId);
	};
	const contentStatusMeta = {
		Unknown: { label: "Unbekannt", icon: "ri-forbid-2-line" },
		ToDo: { label: "Zu erledigen", icon: "ri-list-check" },
		Review: { label: "Überprüfen", icon: "ri-search-line" },
		Edited: { label: "Erfasst", icon: "ri-checkbox-circle-line" },
	};

	const updateContentStatusIcon = (iconEl, iconClass) => {
		if (!iconEl) {
			return;
		}
		iconEl.classList.remove(
			"ri-checkbox-circle-line",
			"ri-information-line",
			"ri-search-line",
			"ri-list-check",
			"ri-forbid-2-line",
		);
		iconEl.classList.add(iconClass);
	};

	const applyContentStatusPickerState = (picker, status) => {
		if (!picker) {
			return;
		}
		const next = contentStatusMeta[status] ? status : "Unknown";
		const meta = contentStatusMeta[next];
		const toggle = picker.querySelector("[data-role='content-status-toggle']");
		const icon = toggle?.querySelector("i");
		if (toggle) {
			toggle.dataset.status = next;
			toggle.setAttribute("aria-label", `Status: ${meta.label}`);
			toggle.setAttribute("title", `Status: ${meta.label}`);
		}
		updateContentStatusIcon(icon, meta.icon);
	};

	const initContentStatusPicker = (picker, onChange) => {
		if (!picker || picker.dataset.init === "true") {
			return;
		}
		const toggle = picker.querySelector("[data-role='content-status-toggle']");
		const menu = picker.querySelector("[data-role='content-status-menu']");
		if (!toggle || !menu) {
			return;
		}
		picker.dataset.init = "true";

		const closeMenu = () => {
			menu.classList.add("hidden");
		};

		toggle.addEventListener("click", (event) => {
			event.preventDefault();
			event.stopPropagation();
			menu.classList.toggle("hidden");
		});

		menu.querySelectorAll("[data-role='content-status-option']").forEach((option) => {
			option.addEventListener("click", async (event) => {
				event.preventDefault();
				event.stopPropagation();
				const status = option.getAttribute("data-status") || "Unknown";
				if (typeof onChange === "function") {
					await onChange(status, picker);
				} else {
					applyContentStatusPickerState(picker, status);
				}
				closeMenu();
			});
		});

		document.addEventListener("click", (event) => {
			if (!picker.contains(event.target)) {
				closeMenu();
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				closeMenu();
			}
		});
	};

	const rememberAndSetStyles = (el, styles) => {
		if (!el) return;
		if (!scrollLockCache.has(el)) {
			scrollLockCache.set(el, el.getAttribute("style"));
		}
		Object.entries(styles).forEach(([key, value]) => {
			el.style[key] = value;
		});
	};

	const lockContentsWorkspaceLayout = () => {
		const workspace = document.querySelector("[data-role='contents-edit-workspace']");
		if (!workspace) return;
		[
			document.documentElement,
			document.body,
			document.querySelector(".admin-layout-main"),
			document.querySelector(".admin-main"),
			document.querySelector(".admin-main-shell"),
			document.querySelector(".admin-main-content"),
		].forEach((el) => rememberAndSetStyles(el, {
			height: "100%",
			minHeight: "0",
			overflow: "hidden",
		}));
	};

	const unlockContentsWorkspaceLayout = () => {
		scrollLockCache.forEach((previousStyle, el) => {
			if (previousStyle === null) {
				el.removeAttribute("style");
			} else {
				el.setAttribute("style", previousStyle);
			}
		});
		scrollLockCache.clear();
	};

	const applyMultiSelectInit = (el) => {
		if (!el) return;
		const optionsRaw = el.getAttribute("data-initial-options") || "[]";
		const valuesRaw = el.getAttribute("data-initial-values") || "[]";
		let options = [];
		let values = [];
		try {
			options = JSON.parse(optionsRaw);
			values = JSON.parse(valuesRaw);
		} catch {
			return;
		}
		if (options.length && typeof el.setOptions === "function") {
			el.setOptions(options);
		}
		if (values.length) {
			el.value = values;
			if (typeof el.captureInitialSelection === "function") {
				el.captureInitialSelection();
			}
		}
	};

	const isEditorOpen = () => {
		const panelShell = document.querySelector("[data-role='contents-editor-panel-shell']");
		return panelShell?.dataset.open === "true";
	};

	const syncEditorState = () => {
		const workspace = document.querySelector("[data-role='contents-edit-workspace']");
		const editorOpen = isEditorOpen();
		if (!workspace) {
			if (!editorOpen) {
				unlockAdminSidebarForEditor();
			}
			return;
		}
		if (editorOpen) {
			workspace.dataset.panelOpen = "true";
			lockAdminSidebarForEditor();
		} else {
			delete workspace.dataset.panelOpen;
			unlockAdminSidebarForEditor();
		}
		window.__contentsApplyViewState?.();
	};

	const replacePanelShell = (html) => {
		const panelShell = document.querySelector("[data-role='contents-editor-panel-shell']");
		if (!panelShell) {
			return;
		}
		const markup = (html || "").trim();
		panelShell.outerHTML = markup || closedEditorPanelMarkup;
		if (window.htmx?.process) {
			window.htmx.process(document.body);
		}
		initFilter();
		initViewOptions();
		initEditorPanel();
		initPage();
	};

	const loadEditorPanelForPath = async (path) => {
		const response = await fetch(path, {
			credentials: "same-origin",
			headers: {
				"HX-Request": "true",
				"HX-Target": "contents-editor-panel-shell",
			},
		});
		if (!response.ok) {
			return false;
		}
		replacePanelShell(await response.text());
		return true;
	};

	const closeEditorPanel = ({ syncUrl = true, replaceUrl = true } = {}) => {
		const panelShell = document.querySelector("[data-role='contents-editor-panel-shell']");
		if (!panelShell) {
			return;
		}
		if (window.__contentsEditorPanelController) {
			window.__contentsEditorPanelController.abort();
			window.__contentsEditorPanelController = null;
		}
		panelShell.outerHTML = closedEditorPanelMarkup;
		if (syncUrl) {
			setContentsHistoryPath(contentsBasePath, replaceUrl);
		}
		syncEditorState();
	};
	window.__closeContentsEditorPanel = closeEditorPanel;

	const initEditorPanel = () => {
		const panelShell = document.querySelector("[data-role='contents-editor-panel-shell']");
		if (!panelShell || panelShell.dataset.open !== "true") {
			if (window.__contentsEditorPanelController) {
				window.__contentsEditorPanelController.abort();
				window.__contentsEditorPanelController = null;
			}
			syncEditorState();
			return;
		}

		if (window.__contentsEditorPanelController) {
			window.__contentsEditorPanelController.abort();
		}
		const panelController = new AbortController();
		window.__contentsEditorPanelController = panelController;

		panelShell.querySelectorAll("[data-role='contents-editor-close']").forEach((button) => {
			if (button.dataset.init === "true") {
				return;
			}
			button.dataset.init = "true";
			button.addEventListener("click", (event) => {
				event.preventDefault();
				closeEditorPanel();
			}, { signal: panelController.signal });
		});

		const currentContentMusenalmId = panelShell.dataset.contentMusenalmId || "";
		const adjacentIds = getAdjacentContentMusenalmIds(currentContentMusenalmId);
		panelShell.querySelectorAll("[data-role='contents-editor-prev'], [data-role='contents-editor-next']").forEach((button) => {
			if (button.dataset.init === "true") {
				return;
			}
			button.dataset.init = "true";
			const isPrev = button.dataset.role === "contents-editor-prev";
			const targetContentMusenalmId = isPrev ? adjacentIds.prev : adjacentIds.next;
			if (!targetContentMusenalmId) {
				button.disabled = true;
				button.classList.add("simple-entity-header-chip-disabled");
				button.setAttribute("aria-disabled", "true");
				return;
			}
			button.disabled = false;
			button.classList.remove("simple-entity-header-chip-disabled");
			button.removeAttribute("aria-disabled");
			button.addEventListener("click", async (event) => {
				event.preventDefault();
				button.disabled = true;
				try {
					await openEditorPanelForContent(targetContentMusenalmId, { replaceUrl: false });
				} finally {
					button.disabled = false;
				}
			}, { signal: panelController.signal });
		});

		const initMultiSelects = () => {
			panelShell.querySelectorAll("multi-select-simple[data-initial-options], multi-select-simple[data-initial-values]").forEach((el) => {
				applyMultiSelectInit(el);
			});
			panelShell.querySelectorAll("[data-role='contents-editor-page-input']").forEach((el) => {
				if (el.dataset.init === "true") {
					return;
				}
				el.dataset.init = "true";
				el.addEventListener("input", () => {
					el.value = el.value.replace(/[^0-9]/g, "");
				});
			});
		};

		const appendPendingScansToPayload = (form, payload) => {
			if (!form || !payload) {
				return;
			}
			if (payload.has("scans")) {
				payload.delete("scans");
			}
			const imagesComponent = form.querySelector("content-images");
			if (!imagesComponent || typeof imagesComponent.getPendingFiles !== "function") {
				return;
			}
			const pendingFiles = imagesComponent.getPendingFiles();
			const pendingIds = typeof imagesComponent.getPendingIds === "function" ? imagesComponent.getPendingIds() : [];
			const scanOrder = typeof imagesComponent.getScanOrder === "function" ? imagesComponent.getScanOrder() : [];
			const pendingDeletes = typeof imagesComponent.getPendingDeletes === "function" ? imagesComponent.getPendingDeletes() : [];

			pendingFiles.forEach((file, index) => {
				payload.append("scans", file);
				if (pendingIds[index]) {
					payload.append("scans_pending_ids[]", pendingIds[index]);
				}
			});
			if (Array.isArray(scanOrder) && scanOrder.length > 0) {
				scanOrder.forEach((token) => {
					payload.append("scans_order[]", token);
				});
			}
			if (Array.isArray(pendingDeletes) && pendingDeletes.length > 0) {
				pendingDeletes.forEach((fileName) => {
					payload.append("scans_delete[]", fileName);
				});
			}
		};

		const errorBox = panelShell.querySelector("[data-role='contents-editor-error']");

		const setEditorError = (message) => {
			if (!errorBox) {
				return;
			}
			const text = (message || "").trim();
			errorBox.textContent = text;
			errorBox.classList.toggle("hidden", !text);
		};

		const setEditorSaving = (saving) => {
			if (!form) {
				return;
			}
			form.querySelectorAll("button[type='submit'], button[data-role='contents-editor-close']").forEach((el) => {
				el.disabled = !!saving;
			});
		};

		const applyOobNode = (node) => {
			const swapRaw = node.getAttribute("hx-swap-oob") || "";
			const [swapTypeRaw, selector] = swapRaw.split(":");
			const swapType = swapTypeRaw || "outerHTML";
			const target = selector ? document.querySelector(selector) : (node.id ? document.getElementById(node.id) : null);
			if (!target) {
				return;
			}
			if (swapType === "innerHTML") {
				target.innerHTML = node.innerHTML;
			} else {
				target.outerHTML = node.outerHTML;
			}
		};

		const applySaveSuccessResponse = (html) => {
			const template = document.createElement("template");
			template.innerHTML = (html || "").trim();
			const nextPanel = template.content.querySelector("#contents-editor-panel-shell");
			const oobNodes = Array.from(template.content.querySelectorAll("[hx-swap-oob]"));
			oobNodes.forEach((node) => {
				applyOobNode(node);
				node.remove();
			});
			if (nextPanel) {
				panelShell.outerHTML = nextPanel.outerHTML;
			}
			if (window.htmx?.process) {
				window.htmx.process(document.body);
			}
			initFilter();
			initViewOptions();
			initEditorPanel();
			initPage();
			setContentsHistoryPath(contentsBasePath, true);
		};

		const form = panelShell.querySelector("form.dbform");
		if (form) {
			form.addEventListener("submit", async (event) => {
				event.preventDefault();
				event.stopPropagation();
				event.stopImmediatePropagation();

				const submitter = event.submitter || document.activeElement;
				const payload = new FormData(form);
				if (submitter?.name) {
					payload.set(submitter.name, submitter.value || "");
				}
				appendPendingScansToPayload(form, payload);
				setEditorError("");
				setEditorSaving(true);

				try {
					const response = await fetch(form.action, {
						method: form.method || "POST",
						body: payload,
						credentials: "same-origin",
						headers: {
							"HX-Request": "true",
						},
					});
					const html = await response.text();
					if (!response.ok) {
						const template = document.createElement("template");
						template.innerHTML = (html || "").trim();
						const message = template.content.querySelector("[data-role='contents-editor-error-message']")?.textContent || "Speichern fehlgeschlagen.";
						setEditorError(message);
						return;
					}
					applySaveSuccessResponse(html);
				} catch {
					setEditorError("Speichern fehlgeschlagen.");
				} finally {
					setEditorSaving(false);
				}
			}, { signal: panelController.signal, capture: true });
		}

		const statePicker = panelShell.querySelector("[data-role='content-status-picker']");
		const footerStateSelect = panelShell.querySelector("[data-role='contents-editor-footer-state']");
		const footerStateIcon = panelShell.querySelector("[data-role='contents-editor-footer-state-icon']");

		const applyStatus = (status) => {
			const next = contentStatusMeta[status] ? status : "Unknown";
			const meta = contentStatusMeta[next];

			if (footerStateSelect) {
				footerStateSelect.value = next;
				footerStateSelect.setAttribute("data-status", next);
			}
			updateContentStatusIcon(footerStateIcon, meta.icon);
			applyContentStatusPickerState(statePicker, next);
		};

		if (statePicker && footerStateSelect) {
			initContentStatusPicker(statePicker, (status) => {
				applyStatus(status);
			});
			footerStateSelect.addEventListener("change", () => {
				applyStatus(footerStateSelect.value || "Unknown");
			}, { signal: panelController.signal });
			applyStatus(footerStateSelect.value || "Unknown");
		}

		if (window.customElements?.whenDefined) {
			window.customElements.whenDefined("multi-select-simple").then(() => {
				requestAnimationFrame(initMultiSelects);
			});
		} else {
			initMultiSelects();
		}

		syncEditorState();
	};

	// Normalize function for accent-insensitive matching
	const normalizeText = (text) => {
		if (!text) return '';
		return text
			.toString()
			.toLowerCase()
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '') // Remove diacritics
			.trim();
	};

	const formatContentCount = (count) => `${count} ${count === 1 ? "Eintrag" : "Einträge"}`;

	// Filter functionality
	const initFilter = () => {
		const filterInput = document.querySelector("[data-role='content-filter-input']");
		const filterPage = document.querySelector("[data-role='content-filter-page']");
		const filterType = document.querySelector("[data-role='content-filter-type']");
		const filterCount = document.querySelector("[data-role='content-filter-count']");
		const list = document.querySelector("[data-role='contents-list']");
		const toolbar = document.querySelector("[data-role='content-filter-toolbar']");
		const pageShell = document.querySelector("[data-role='content-page-shell']");
		const searchShell = document.querySelector("[data-role='content-search-shell']");
		const searchClear = document.querySelector("[data-role='content-search-clear']");
		const pageClear = document.querySelector("[data-role='content-page-clear']");
		const typeToggle = document.querySelector("[data-role='content-type-toggle']");
		const typeTrigger = document.querySelector("[data-role='content-type-trigger']");
		const typeLabel = document.querySelector("[data-role='content-type-label']");
		const typeList = document.querySelector("[data-role='content-filter-type-list']");

		if (!filterInput || !list) return;
		if (filterInput.dataset.init === "true") return;
		filterInput.dataset.init = "true";

		const setTriggerActive = (trigger, active) => {
			trigger?.classList.toggle("admin-list-filter-trigger-active", !!active);
		};

		const renderTypeList = () => {
			if (!filterType || !typeList) {
				return;
			}

			typeList.innerHTML = "";

			const createButton = (value, label) => {
				const button = document.createElement("button");
				button.type = "button";
				button.dataset.value = value;
				button.textContent = label;
				button.className = "filter-list-row w-full px-2 py-1 rounded-sm text-left hover:bg-stone-100 no-underline transition-colors";
				if (filterType.value === value) {
					button.classList.add("bg-stone-100", "font-semibold");
				}
				button.addEventListener("click", () => {
					filterType.value = value;
					typeToggle?.removeAttribute("open");
					performFilter();
				});
				typeList.appendChild(button);
			};

			createButton("", "Alle Typen");
			Array.from(filterType.options)
				.slice(1)
				.forEach((option) => {
					createButton(option.value, option.textContent || option.value);
				});
		};

		const updateFilterUi = () => {
			const rawQuery = (filterInput.value || "").trim();
			const rawPage = (filterPage?.value || "").trim();
			const rawType = (filterType?.value || "").trim();
			if (typeLabel) {
				typeLabel.textContent = rawType ? `Typ: ${rawType}` : "Typen";
			}

			setTriggerActive(searchShell, !!rawQuery);
			setTriggerActive(pageShell, !!rawPage);
			setTriggerActive(typeTrigger, !!rawType);
			searchClear?.classList.toggle("hidden", !rawQuery);
			pageClear?.classList.toggle("hidden", !rawPage);

			if (typeList) {
				typeList.querySelectorAll("[data-value]").forEach((button) => {
					const isActive = button.dataset.value === rawType;
					button.classList.toggle("bg-stone-100", isActive);
					button.classList.toggle("font-semibold", isActive);
				});
			}
		};

		// Populate type select from search index
		if (filterType && window.contentsSearchIndex) {
			const types = new Set();
			Object.values(window.contentsSearchIndex).forEach(content => {
				(content.musenalmType || []).forEach(t => types.add(t));
			});
			Array.from(types).sort().forEach(type => {
				const option = document.createElement('option');
				option.value = type;
				option.textContent = type;
				filterType.appendChild(option);
			});
			renderTypeList();
		}

		let filterTimeout = null;
		const totalCount = list.querySelectorAll("[data-role='content-item']").length;

		// Field labels for display
		const fieldLabels = {
			extent: 'Seite',
			musenalmType: 'Typ',
			titleStmt: 'Titel',
			subtitleStmt: 'Untertitel',
			incipitStmt: 'Incipit',
			responsibilityStmt: 'Autorangabe',
			parallelTitle: 'Paralleltitel',
			variantTitle: 'Titelvarianten',
			placeStmt: 'Ortsangabe',
			contentType: 'Beitragstyp',
			comment: 'Kommentar',
			agents: 'Personen',
			annotation: 'Anmerkung'
		};

		const getMarkTargets = () => {
			if (!list) {
				return [];
			}
			const visibleItems = Array.from(list.querySelectorAll("[data-role='content-item']")).filter((item) => item.style.display !== "none");
			const targets = [];
			visibleItems.forEach((item) => {
				targets.push(...item.querySelectorAll(".content-search-text"));
			});
			return targets;
		};

					const updateMarks = () => {
						if (typeof Mark !== "function") {
							return;
						}
						const terms = [];
						const rawQuery = (filterInput.value || "").trim();
						if (rawQuery) {
							terms.push(rawQuery);
						}
						const targets = getMarkTargets();
						if (targets.length === 0) {
							return;
						}
			const markInstance = new Mark(targets);
			markInstance.unmark({
				done: () => {
					if (terms.length > 0) {
						markInstance.mark(terms, {
							separateWordSearch: true,
						});
					}
				},
			});
		};

		const performFilter = () => {
			const query = normalizeText(filterInput.value);
			const pageQuery = normalizeText(filterPage?.value || '');
			const typeQuery = filterType?.value || '';
			const items = list.querySelectorAll("[data-role='content-item']");
			let visibleCount = 0;

			const hasAnyFilter = query || pageQuery || typeQuery;

			if (!hasAnyFilter) {
				list.removeAttribute('data-filtering');
				items.forEach(item => {
					item.style.display = '';
					const matchDisplay = item.querySelector('[data-role="content-match-display"]');
					if (matchDisplay) {
						matchDisplay.classList.add('hidden');
						matchDisplay.innerHTML = '';
					}
				});
				visibleCount = totalCount;
			} else {
				list.setAttribute('data-filtering', 'true');
				items.forEach(item => {
					const contentId = item.dataset.contentId;
					const contentData = window.contentsSearchIndex[contentId];
					const matchDisplay = item.querySelector('[data-role="content-match-display"]');

					if (!contentData) {
						item.style.display = 'none';
						if (matchDisplay) {
							matchDisplay.classList.add('hidden');
							matchDisplay.innerHTML = '';
						}
						return;
					}

					// Check type filter (exact match)
					if (typeQuery && !(contentData.musenalmType || []).includes(typeQuery)) {
						item.style.display = 'none';
						if (matchDisplay) {
							matchDisplay.classList.add('hidden');
							matchDisplay.innerHTML = '';
						}
						return;
					}

					// Check page filter (substring match on extent)
					if (pageQuery) {
						const extentMatch = normalizeText(contentData.extent || '').includes(pageQuery);
						if (!extentMatch) {
							item.style.display = 'none';
							if (matchDisplay) {
								matchDisplay.classList.add('hidden');
								matchDisplay.innerHTML = '';
							}
							return;
						}
					}

					// If only type/page filters are active (no text query), show item without match display
					if (!query) {
						item.style.display = '';
						if (matchDisplay) {
							matchDisplay.classList.add('hidden');
							matchDisplay.innerHTML = '';
						}
						visibleCount++;
						return;
					}

					// Check each field individually and collect matches for text query
					const matchedFields = [];

					const checkField = (key, value, label) => {
						if (!value) return;
						const normalizedValue = normalizeText(String(value));
						if (normalizedValue.includes(query)) {
							matchedFields.push({ label, value: String(value) });
						}
					};

					const checkArrayField = (key, values, label) => {
						if (!values || !values.length) return;
						const matchingValues = values.filter(v => normalizeText(String(v)).includes(query));
						if (matchingValues.length > 0) {
							matchedFields.push({ label, value: matchingValues.join(', ') });
						}
					};

					// Check text search fields (excluding language, status, preferredTitle)
					checkArrayField('musenalmType', contentData.musenalmType, fieldLabels.musenalmType);
					checkField('titleStmt', contentData.titleStmt, fieldLabels.titleStmt);
					checkField('subtitleStmt', contentData.subtitleStmt, fieldLabels.subtitleStmt);
					checkField('incipitStmt', contentData.incipitStmt, fieldLabels.incipitStmt);
					checkField('responsibilityStmt', contentData.responsibilityStmt, fieldLabels.responsibilityStmt);
					checkField('parallelTitle', contentData.parallelTitle, fieldLabels.parallelTitle);
					checkField('variantTitle', contentData.variantTitle, fieldLabels.variantTitle);
					checkField('placeStmt', contentData.placeStmt, fieldLabels.placeStmt);
					checkArrayField('contentType', contentData.contentType, fieldLabels.contentType);
					checkField('comment', contentData.comment, fieldLabels.comment);

					// Check agents
					if (contentData.agents && contentData.agents.length > 0) {
						const matchingAgents = contentData.agents.filter(a => {
							const agentText = normalizeText(`${a.name} ${a.bio}`);
							return agentText.includes(query);
						});
						if (matchingAgents.length > 0) {
							matchedFields.push({
								label: fieldLabels.agents,
								value: matchingAgents.map(a => a.bio ? `${a.name} (${a.bio})` : a.name).join(', ')
							});
						}
					}

					// Check annotation (strip HTML for display)
					if (contentData.annotation) {
						const plainAnnotation = contentData.annotation.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
						if (normalizeText(plainAnnotation).includes(query)) {
							const displayValue = plainAnnotation.length > 100
								? plainAnnotation.substring(0, 100) + '…'
								: plainAnnotation;
							matchedFields.push({ label: fieldLabels.annotation, value: displayValue });
						}
					}

					const hasMatch = matchedFields.length > 0;
					item.style.display = hasMatch ? '' : 'none';

					if (matchDisplay) {
						if (hasMatch) {
							matchDisplay.classList.remove('hidden');
							matchDisplay.innerHTML = matchedFields
								.map(f => `<span class="inline-block mr-3"><strong>${f.label}:</strong> ${f.value}</span>`)
								.join('');
						} else {
							matchDisplay.classList.add('hidden');
							matchDisplay.innerHTML = '';
						}
					}

					if (hasMatch) visibleCount++;
				});
			}

			if (filterCount) {
				filterCount.textContent = !hasAnyFilter
					? formatContentCount(totalCount)
					: `${visibleCount} von ${formatContentCount(totalCount)}`;
			}

			window.__contentsApplyViewState?.();
			updateFilterUi();
			updateMarks();
		};

		const debounceFilter = () => {
			if (filterTimeout) clearTimeout(filterTimeout);
			filterTimeout = setTimeout(performFilter, 150);
		};

		filterInput.addEventListener('input', debounceFilter);
		filterPage?.addEventListener('input', debounceFilter);
		filterType?.addEventListener('change', performFilter);

		searchClear?.addEventListener('click', () => {
			filterInput.value = '';
			performFilter();
			filterInput.focus();
		});

		pageClear?.addEventListener('click', () => {
			if (!filterPage) {
				return;
			}
			filterPage.value = '';
			performFilter();
			filterPage.focus();
		});

		typeToggle?.addEventListener('toggle', () => {
			if (!typeToggle.open) {
				return;
			}
		});

		// Clear all filters on Escape
		const clearFilters = () => {
			filterInput.value = '';
			if (filterPage) filterPage.value = '';
			if (filterType) filterType.value = '';
			performFilter();
		};

		filterInput.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				clearFilters();
				filterInput.blur();
			}
		});

		filterPage?.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				clearFilters();
				filterPage.blur();
			}
		});

		if (window.__contentsFilterDocClickHandler) {
			document.removeEventListener('click', window.__contentsFilterDocClickHandler, true);
		}

		window.__contentsFilterDocClickHandler = (event) => {
			if (toolbar && toolbar.contains(event.target)) {
				return;
			}
			typeToggle?.removeAttribute('open');
		};

		document.addEventListener('click', window.__contentsFilterDocClickHandler, true);
		updateFilterUi();
	};

	const initViewOptions = () => {
		const toggle = document.querySelector("[data-role='contents-column-toggle']");
		const toggleIcon = document.querySelector("[data-role='contents-column-toggle-icon']");
		const list = document.querySelector("[data-role='contents-list']");
		if (!toggle || toggle.dataset.init === "true") {
			return;
		}
		toggle.dataset.init = "true";

		const storageKey = "admin-contents-view-options";
		const defaults = {
			"move-controls": true,
			"alm-number": true,
			"type": true,
			"annotation": false,
			"responsibility": true,
			"linked-agents": true,
			"scans": true,
			"extended-info": false,
		};

		let state = { ...defaults };
		try {
			const raw = window.localStorage.getItem(storageKey);
			if (raw) {
				const parsed = JSON.parse(raw);
				state = { ...defaults, ...parsed };
			}
		} catch {}

		const selectors = {
			"move-controls": "[data-role='content-move-controls']",
			"alm-number": "[data-role='content-alm-number']",
			"type": "[data-role='content-type-group']",
			"annotation": "[data-role='content-annotation']",
			"responsibility": "[data-role='content-responsibility']",
			"linked-agents": "[data-role='content-linked-agents']",
			"scans": "[data-role='content-scans']",
			"extended-info": "[data-role='content-extended-info']",
		};
		const columnSelectors = {
			"move-controls": ["[data-role='content-col-move']", "[data-role='content-cell-move']"],
			"alm-number": ["[data-role='content-col-alm']", "[data-role='content-cell-alm']"],
		};
		const temporaryFilterHiddenColumns = new Set(["move-controls", "annotation", "extended-info"]);
		const getColumnVisibility = (key, filtering, editorOpen) => {
			if (!state[key]) {
				return false;
			}
			if (temporaryFilterHiddenColumns.has(key) && filtering) {
				return false;
			}
			if (key === "move-controls" && editorOpen) {
				return false;
			}
			return true;
		};

		const applyState = () => {
			const filtering = !!list?.hasAttribute("data-filtering");
			const editorOpen = isEditorOpen();
			Object.entries(selectors).forEach(([key, selector]) => {
				const isVisible = getColumnVisibility(key, filtering, editorOpen);
				document.querySelectorAll(selector).forEach((el) => {
					el.style.display = isVisible ? "" : "none";
				});
			});
			Object.entries(columnSelectors).forEach(([key, selectorList]) => {
				const isVisible = getColumnVisibility(key, filtering, editorOpen);
				selectorList.forEach((selector) => {
					document.querySelectorAll(selector).forEach((el) => {
						el.style.display = isVisible ? "" : "none";
					});
				});
			});
			document.querySelectorAll("[data-role='contents-view-option'][data-col-option]").forEach((el) => {
				const key = el.dataset.colOption;
				const hideWhileFiltering = temporaryFilterHiddenColumns.has(key);
				el.style.display = filtering && hideWhileFiltering ? "none" : "";
			});
			document.querySelectorAll("[data-role='content-col-actions']").forEach((el) => {
				el.style.width = editorOpen ? "0.5rem" : "";
				el.style.minWidth = editorOpen ? "0.5rem" : "";
			});
			document.querySelectorAll("[data-role='content-cell-actions']").forEach((el) => {
				el.style.width = editorOpen ? "0.5rem" : "";
				el.style.minWidth = editorOpen ? "0.5rem" : "";
				el.style.paddingLeft = editorOpen ? "0" : "";
				el.style.paddingRight = editorOpen ? "0" : "";
			});
			document.querySelectorAll("[data-role='content-cell-actions-inner']").forEach((el) => {
				el.style.display = editorOpen ? "none" : "";
			});
		};
		window.__contentsApplyViewState = applyState;

		toggle.querySelectorAll("input[data-col]").forEach((input) => {
			const key = input.dataset.col;
			input.checked = !!state[key];
			input.addEventListener("change", () => {
				state[key] = input.checked;
				applyState();
				try {
					window.localStorage.setItem(storageKey, JSON.stringify(state));
				} catch {}
			});
		});

		const syncToggleIcon = () => {
			toggleIcon?.classList.toggle("rotate-180", toggle.open);
		};

		toggle.addEventListener("toggle", () => {
			syncToggleIcon();
		});

		if (window.__contentsViewDocClickHandler) {
			document.removeEventListener("click", window.__contentsViewDocClickHandler, true);
		}
		window.__contentsViewDocClickHandler = (event) => {
			if (toggle.contains(event.target)) {
				return;
			}
			toggle.removeAttribute("open");
		};
		document.addEventListener("click", window.__contentsViewDocClickHandler, true);

		syncToggleIcon();
		applyState();
	};

	const initPage = () => {
		lockContentsWorkspaceLayout();
		list = document.querySelector("[data-role='contents-list']");
		syncEditorState();
		if (!list) {
			return;
		}

		const getItems = () => Array.from(list.querySelectorAll("[data-role='content-item']"));
		if (getItems().length === 0) {
			return;
		}

		const orderEndpoint = list.dataset.orderEndpoint || getItems()[0]?.querySelector("form")?.getAttribute("action") || "";
		const deleteEndpoint = "/admin/almanach/{{ $model.result.Entry.MusenalmID }}/contents/delete";
		const csrfToken = document.querySelector("input[name='csrf_token']")?.value || "";
		const syncIndicator = document.querySelector("#contents-sync-indicator");
		let orderSyncTimer = null;
		let isOrderSyncing = false;
		let pendingOrderSync = false;
		if (list.__contentsDragController) {
			list.__contentsDragController.abort();
		}
		list.__contentsDragController = new AbortController();
		const { signal: dragSignal } = list.__contentsDragController;

		const setSyncIndicator = (active) => {
			if (!syncIndicator) {
				return;
			}
			syncIndicator.classList.toggle("hidden", !active);
		};
		const setDraggingState = (active) => {
			if (active) {
				document.body.dataset.dragging = "true";
			} else {
				delete document.body.dataset.dragging;
			}
			window.__toolTipDragging = active;
			window.dispatchEvent(new CustomEvent("contentsdragging", { detail: { active } }));
		};
		// Shared delete dialog
		const deleteDialog = document.getElementById("content-delete-dialog");
		const deleteDialogTitle = document.getElementById("content-delete-dialog-title");
		const deleteConfirmBtn = deleteDialog?.querySelector("[data-role='content-delete-confirm']");
		const deleteCancelBtn = deleteDialog?.querySelector("[data-role='content-delete-cancel']");
		let itemToDelete = null;
		const renumberDialog = document.getElementById("content-renumber-dialog");
		const renumberDialogTitle = document.getElementById("content-renumber-dialog-title");
		const renumberDialogWarning = document.getElementById("content-renumber-dialog-warning");
		const renumberConfirmBtn = renumberDialog?.querySelector("[data-role='content-renumber-confirm']");
		const renumberCancelBtn = renumberDialog?.querySelector("[data-role='content-renumber-cancel']");
		const renumberPreserveEndpoint = "/admin/almanach/{{ $model.result.Entry.MusenalmID }}/contents/renumber/preserve";
		const renumberNewEndpoint = "/admin/almanach/{{ $model.result.Entry.MusenalmID }}/contents/renumber/new";
		let renumberMode = "";

		const deleteContent = (item) => {
			if (!item) {
				return;
			}
			const contentId = item.dataset.contentId || "";
			if (!contentId || !csrfToken) {
				return;
			}
			const payload = new URLSearchParams();
			payload.set("csrf_token", csrfToken);
			payload.set("content_id", contentId);
			fetch(deleteEndpoint, {
				method: "POST",
				headers: {
					"Content-Type": "application/x-www-form-urlencoded",
					"HX-Request": "true",
				},
				body: payload.toString(),
			})
				.then(async (response) => {
					const html = await response.text();
					if (!response.ok) {
						return;
					}
					if (html) {
						const template = document.createElement("template");
						template.innerHTML = html.trim();
						Array.from(template.content.querySelectorAll("[hx-swap-oob]")).forEach((node) => {
							const swapRaw = node.getAttribute("hx-swap-oob") || "";
							const [swapTypeRaw, selector] = swapRaw.split(":");
							const swapType = swapTypeRaw || "outerHTML";
							const target = selector ? document.querySelector(selector) : (node.id ? document.getElementById(node.id) : null);
							if (!target) {
								return;
							}
							if (swapType === "innerHTML") {
								target.innerHTML = node.innerHTML;
							} else {
								target.outerHTML = node.outerHTML;
							}
						});
						if (window.htmx?.process) {
							window.htmx.process(document.body);
						}
						initFilter();
						initViewOptions();
						initEditorPanel();
						initPage();
						setContentsHistoryPath(contentsBasePath, true);
						return;
					}
					removeItem(item);
				})
				.catch(() => null)
				.finally(() => {
					deleteDialog?.close();
				});
		};

		// Setup shared delete dialog events
		if (deleteDialog && deleteDialog.dataset.init !== "true") {
			deleteDialog.dataset.init = "true";
			deleteCancelBtn?.addEventListener("click", () => deleteDialog.close());
			deleteDialog.addEventListener("cancel", (e) => {
				e.preventDefault();
				deleteDialog.close();
			});
			deleteConfirmBtn?.addEventListener("click", () => {
				if (itemToDelete) {
					deleteContent(itemToDelete);
					itemToDelete = null;
				}
			});
		}

		if (renumberDialog && renumberDialog.dataset.init !== "true") {
			renumberDialog.dataset.init = "true";
			renumberCancelBtn?.addEventListener("click", () => renumberDialog.close());
			renumberDialog.addEventListener("cancel", (event) => {
				event.preventDefault();
				renumberDialog.close();
			});
			renumberConfirmBtn?.addEventListener("click", () => {
				if (!csrfToken || !renumberMode) {
					renumberDialog?.close();
					return;
				}
				const form = document.createElement("form");
				form.method = "POST";
				form.action = renumberMode === "preserve" ? renumberPreserveEndpoint : renumberNewEndpoint;

				const csrfField = document.createElement("input");
				csrfField.type = "hidden";
				csrfField.name = "csrf_token";
				csrfField.value = csrfToken;
				form.appendChild(csrfField);

				document.body.appendChild(form);
				form.submit();
			});
		}

		const performOrderSync = () => {
			if (!list || !orderEndpoint || !csrfToken || isOrderSyncing) {
				pendingOrderSync = true;
				return;
			}
			isOrderSyncing = true;
			pendingOrderSync = false;
			setSyncIndicator(true);
			const payload = new URLSearchParams();
			payload.set("csrf_token", csrfToken);
			list.querySelectorAll("[data-role='content-item']").forEach((card) => {
				// Skip filtered-out items during reorder
				if (card.style.display === 'none') return;

				const contentId = card.dataset.contentId;
				if (!contentId) {
					return;
				}
				payload.append("content_order[]", contentId);
			});
			fetch(orderEndpoint, {
				method: "POST",
				headers: {
					"Content-Type": "application/x-www-form-urlencoded",
				},
				body: payload.toString(),
			})
				.catch(() => null)
				.finally(() => {
					isOrderSyncing = false;
					setSyncIndicator(false);
					if (pendingOrderSync) {
						performOrderSync();
					}
				});
		};

		const syncOrder = () => {
			if (orderSyncTimer) {
				clearTimeout(orderSyncTimer);
			}
			orderSyncTimer = setTimeout(() => {
				performOrderSync();
			}, 300);
		};

		const removeItem = (item) => {
			item.remove();
		};

		const replaceWorkspaceFromResponse = (html) => {
			if (!html) {
				return false;
			}
			const template = document.createElement("template");
			template.innerHTML = html.trim();
			const nextWorkspace = template.content.querySelector("#contents-workspace-left");
			const currentWorkspace = document.querySelector("#contents-workspace-left");
			if (!nextWorkspace || !currentWorkspace) {
				return false;
			}
			currentWorkspace.outerHTML = nextWorkspace.outerHTML;
			const nextMessage = template.content.querySelector("#user-message");
			const currentMessage = document.querySelector("#user-message");
			if (nextMessage && currentMessage) {
				currentMessage.outerHTML = nextMessage.outerHTML;
			}
			if (window.htmx?.process) {
				window.htmx.process(document.body);
			}
			initFilter();
			initViewOptions();
			initEditorPanel();
			initPage();
			window.initAdminStatusPickers?.(document);
			return true;
		};

		const saveItemStatus = async (item, status, picker) => {
			const endpoint = picker?.dataset.statusEndpoint || "";
			const lastEdited = picker?.dataset.lastEdited || item?.dataset.lastEdited || "";
			if (!endpoint || !csrfToken) {
				return;
			}
			const toggle = picker?.querySelector("[data-role='content-status-toggle']");
			const previousStatus = toggle?.dataset.status || "Unknown";
			applyContentStatusPickerState(picker, status);
			if (toggle) {
				toggle.disabled = true;
				toggle.classList.add("opacity-70", "pointer-events-none");
			}

			const payload = new URLSearchParams();
			payload.set("csrf_token", csrfToken);
			payload.set("last_edited", lastEdited);
			payload.set("status", status);

			try {
				const response = await fetch(endpoint, {
					method: "POST",
					headers: {
						"Content-Type": "application/x-www-form-urlencoded",
					},
					body: payload.toString(),
				});
				const result = await response.json().catch(() => null);
				if (!response.ok || !result?.success) {
					throw new Error("status save failed");
				}
				if (result.last_edited) {
					picker.dataset.lastEdited = result.last_edited;
					if (item) {
						item.dataset.lastEdited = result.last_edited;
					}
				}
				if (result.status) {
					applyContentStatusPickerState(picker, result.status);
				}
			} catch {
				applyContentStatusPickerState(picker, previousStatus);
			} finally {
				if (toggle) {
					toggle.disabled = false;
					toggle.classList.remove("opacity-70", "pointer-events-none");
				}
			}
		};

		const setupItem = (item) => {
			if (!item || item.dataset.init === "true") {
				return;
			}
			item.dataset.init = "true";

			const deleteButtonView = item.querySelector("[data-role='content-delete-view']");

			if (deleteButtonView && deleteDialog) {
				deleteButtonView.addEventListener("click", () => {
					itemToDelete = item;
					// Get title from search index for the dialog
					const contentId = item.dataset.contentId;
					const contentData = window.contentsSearchIndex?.[contentId];
					const title = contentData?.titleStmt || contentData?.preferredTitle || '';
					if (deleteDialogTitle) {
						deleteDialogTitle.textContent = title;
						deleteDialogTitle.style.display = title ? '' : 'none';
					}
					deleteDialog.showModal();
				});
			}

			const statusPicker = item.querySelector("[data-role='content-status-picker']");
			if (statusPicker && !statusPicker.dataset.statusEndpoint) {
				initContentStatusPicker(statusPicker, (status, picker) => saveItemStatus(item, status, picker));
			}
		};

		document.querySelectorAll("[data-role='content-renumber-open']").forEach((button) => {
			button.addEventListener("click", () => {
				if (button.disabled || !renumberDialog) {
					return;
				}
				renumberMode = button.dataset.renumberMode || "";
				if (!renumberMode) {
					return;
				}
				if (renumberDialogTitle) {
					renumberDialogTitle.textContent = renumberMode === "preserve"
						? "Nummern werden beibehalten, aber die Zuordnung ändert sich."
						: "Permalinks bleiben erhalten und leiten auf die jeweils neue Nummer weiter.";
				}
				if (renumberDialogWarning) {
					renumberDialogWarning.classList.toggle("hidden", renumberMode !== "preserve");
				}
				if (renumberConfirmBtn) {
					renumberConfirmBtn.textContent = renumberMode === "preserve"
						? "Nummern neu zuordnen"
						: "Neue Nummern vergeben";
				}
				renumberDialog.showModal();
			});
		});

		getItems().forEach((item) => {
			setupItem(item);
		});

		list.dataset.pageInit = "true";
		let draggedItem = null;
		let pointerDrag = null;
		let lastDragOverTime = 0;
		const DRAG_THROTTLE_MS = 100;
		const startPointerDrag = (event) => {
			if (isEditorOpen()) {
				return;
			}
			const handle = event.target.closest("[data-role='content-drag-handle']");
			if (!handle || event.button !== 0) {
				return;
			}
			const item = handle.closest("[data-role='content-item']");
			if (!item) {
				return;
			}
			event.preventDefault();
			pointerDrag = {
				item,
				pointerId: event.pointerId,
			};
			item.dataset.dragging = "true";
			item.classList.add("opacity-60");
			setDraggingState(true);
			if (handle.setPointerCapture) {
				handle.setPointerCapture(event.pointerId);
			}
		};

		const movePointerDrag = (event) => {
			if (isEditorOpen()) {
				return;
			}
			if (!pointerDrag || event.pointerId !== pointerDrag.pointerId) {
				return;
			}
			const now = Date.now();
			if (now - lastDragOverTime < DRAG_THROTTLE_MS) {
				return;
			}
			lastDragOverTime = now;
			const item = pointerDrag.item;
			const targetItem = document.elementFromPoint(event.clientX, event.clientY)?.closest("[data-role='content-item']");
			if (!targetItem || targetItem === item) {
				return;
			}
			const rect = targetItem.getBoundingClientRect();
			const before = event.clientY - rect.top < rect.height / 2;
			if (before) {
				targetItem.before(item);
			} else {
				targetItem.after(item);
			}
		};

		const endPointerDrag = (event) => {
			if (!pointerDrag || event.pointerId !== pointerDrag.pointerId) {
				return;
			}
			pointerDrag.item.classList.remove("opacity-60");
			pointerDrag.item.dataset.dragging = "";
			pointerDrag = null;
			setDraggingState(false);
			syncOrder();
		};
		list.addEventListener("click", (event) => {
			if (isEditorOpen()) {
				return;
			}
			const moveUp = event.target.closest("[data-role='content-move-up']");
			const moveDown = event.target.closest("[data-role='content-move-down']");
			if (!moveUp && !moveDown) {
				return;
			}
			event.preventDefault();
			const item = event.target.closest("[data-role='content-item']");
			if (!item) {
				return;
			}
			if (moveUp) {
				let prev = item.previousElementSibling;
				while (prev && !prev.matches("[data-role='content-item']")) {
					prev = prev.previousElementSibling;
				}
				if (prev) {
					prev.before(item);
				}
			} else {
				let next = item.nextElementSibling;
				while (next && !next.matches("[data-role='content-item']")) {
					next = next.nextElementSibling;
				}
				if (next) {
					next.after(item);
				}
			}
			syncOrder();
		}, { signal: dragSignal });

		list.addEventListener("dragstart", (event) => {
			if (isEditorOpen()) {
				event.preventDefault();
				return;
			}
			if (pointerDrag) {
				event.preventDefault();
				return;
			}
			if (event.target.closest("[data-role='content-move-up']") || event.target.closest("[data-role='content-move-down']")) {
				return;
			}
			if (event.target.closest("[data-role='content-status-picker']") || event.target.closest(".status-badge") || event.target.closest("multi-select-simple") || event.target.closest("select")) {
				return;
			}
			const handle = event.target.closest("[data-role='content-drag-handle']");
			if (!handle) {
				event.preventDefault();
				return;
			}
			const item = handle.closest("[data-role='content-item']");
			if (!item) {
				return;
			}
			draggedItem = item;
			item.dataset.dragging = "true";
			draggedItem.classList.add("opacity-60");
			setDraggingState(true);
			event.dataTransfer.effectAllowed = "move";
			event.dataTransfer.setData("text/plain", "move");
		}, { signal: dragSignal });

		list.addEventListener("dragover", (event) => {
			if (isEditorOpen()) {
				return;
			}
			if (!draggedItem) {
				return;
			}
			event.preventDefault();
			const targetItem = event.target.closest("[data-role='content-item']");
			if (!targetItem || targetItem === draggedItem) {
				return;
			}
			const rect = targetItem.getBoundingClientRect();
			const before = event.clientY - rect.top < rect.height / 2;
			if (before) {
				targetItem.before(draggedItem);
			} else {
				targetItem.after(draggedItem);
			}
		}, { signal: dragSignal });

		list.addEventListener("dragend", () => {
			if (draggedItem) {
				draggedItem.classList.remove("opacity-60");
				draggedItem.dataset.dragging = "";
			}
			draggedItem = null;
			setDraggingState(false);
			syncOrder();
		}, { signal: dragSignal });

		list.addEventListener("pointerdown", startPointerDrag, { signal: dragSignal });
		list.addEventListener("pointermove", movePointerDrag, { signal: dragSignal });
		list.addEventListener("pointerup", endPointerDrag, { signal: dragSignal });
		list.addEventListener("pointercancel", endPointerDrag, { signal: dragSignal });
	};

	initFilter();
	initViewOptions();
	initEditorPanel();
	initPage();
	document.body.addEventListener("htmx:beforeRequest", (event) => {
		if (!isEditorOpen()) {
			return;
		}
		const target = event.detail?.target;
		const staysInsideContentsWorkspace =
			target?.id === "contents-editor-panel-shell" ||
			target?.id === "contents-workspace-left" ||
			!!target?.closest?.("[data-role='contents-edit-workspace']") ||
			!!target?.closest?.("[data-role='contents-editor-panel-shell']");
		if (!staysInsideContentsWorkspace) {
			unlockAdminSidebarForEditor();
		}
	});
	document.body.addEventListener("htmx:beforeSwap", (event) => {
		if (event.detail.target?.id === "admin-main-content") {
			unlockContentsWorkspaceLayout();
			unlockAdminSidebarForEditor();
		}
	});
	document.body.addEventListener("htmx:afterSwap", (event) => {
		if (event.target?.closest?.("[data-role='contents-edit-workspace']") || event.target?.id === "contents-editor-panel-shell" || event.target?.id === "contents-workspace-left") {
			initFilter();
			initViewOptions();
			initEditorPanel();
			initPage();
		}
	});
	window.addEventListener("pageshow", (event) => {
		if (event.persisted) {
			initFilter();
			initViewOptions();
			initEditorPanel();
			initPage();
		}
	});
	window.addEventListener("popstate", () => {
		const contentMusenalmId = getPanelMusenalmIdFromPath();
		if (!contentMusenalmId) {
			closeEditorPanel({ syncUrl: false });
			return;
		}
		if (isEditorOpen() && getOpenPanelMusenalmId() === contentMusenalmId) {
			return;
		}
		openEditorPanelForContent(contentMusenalmId, { replaceUrl: true }).catch(() => null);
	});
	window.addEventListener("admin-sidebar-controller-ready", () => {
		syncEditorState();
	});
window.addEventListener("beforeunload", () => {
		unlockContentsWorkspaceLayout();
		unlockAdminSidebarForEditor();
	});
</script>
<script>
	(() => {
		if (window.__contentsEditorCloseFallbackBound) {
			return;
		}
		window.__contentsEditorCloseFallbackBound = true;

		const fallbackClosedMarkup = '<div id="contents-editor-panel-shell" data-role="contents-editor-panel-shell" data-open="false" class="hidden"></div>';

		const closePanelFallback = () => {
			if (typeof window.__closeContentsEditorPanel === "function") {
				window.__closeContentsEditorPanel();
				return;
			}
			const panelShell = document.querySelector("[data-role='contents-editor-panel-shell']");
			if (panelShell) {
				panelShell.outerHTML = fallbackClosedMarkup;
			}
			const workspace = document.querySelector("[data-role='contents-edit-workspace']");
			if (workspace) {
				delete workspace.dataset.panelOpen;
			}
			window.__contentsApplyViewState?.();
		};

		document.addEventListener("click", (event) => {
			const button = event.target.closest("[data-role='contents-editor-close']");
			if (!button) {
				return;
			}
			event.preventDefault();
			closePanelFallback();
		}, true);
	})();
</script>
