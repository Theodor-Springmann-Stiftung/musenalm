{{ $model := . }}

<div class="admin-list-table-shell">
	<table id="orte-table" class="admin-list-table table-fixed">
		<colgroup>
			<col />
			<col style="width: 9rem;" />
			<col style="width: 8rem;" />
			<col style="width: 8.5rem;" />
		</colgroup>
		<thead class="admin-list-head">
			<tr>
				<th class="py-2 pr-4 pl-4 align-bottom text-base font-semibold tracking-wide">Ort</th>
				<th class="py-2 pr-4 align-bottom text-base font-semibold tracking-wide">Fiktional</th>
				<th class="py-2 pr-4 align-bottom text-base font-semibold tracking-wide">Bände</th>
				<th class="py-2 pr-8 text-right align-bottom text-base font-semibold tracking-wide">Aktionen</th>
			</tr>
		</thead>
		<tbody id="orte-table-body">
			{{ template "_orte_rows" $model }}
		</tbody>
	</table>
</div>
