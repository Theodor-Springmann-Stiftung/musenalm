{{ $model := . }}

<div
	class="admin-page-shell"
	x-data="{
		search: '',
		searchOpen: false,
		alphabetOpen: false,
		selectedLetter: '',
		letters: ['A','Ä','B','C','D','E','F','G','H','I','J','K','L','M','N','O','Ö','P','Q','R','S','T','U','Ü','V','W','X','Y','Z'],
		fictionalFilter: '',
		fictionalOpen: false,
		totalCount: {{ if $model.result.Places }}{{ len $model.result.Places }}{{ else }}0{{ end }},
		visibleCount: {{ if $model.result.Places }}{{ len $model.result.Places }}{{ else }}0{{ end }},
		openSearch() {
			this.searchOpen = true;
			this.$nextTick(() => this.$refs.orteSearchInput?.focus());
		},
		closeSearch() {
			this.searchOpen = false;
		},
		clearSearch() {
			this.search = '';
			this.searchOpen = false;
			this.filterRows();
		},
		clearFictionalFilter() {
			this.fictionalFilter = '';
			this.fictionalOpen = false;
			this.filterRows();
		},
		filterRows() {
			const query = this.search.trim().toLowerCase();
			const rows = Array.from(this.$refs.orteTableBody?.querySelectorAll('[data-role=\'orte-row\']') || []);
			let visible = 0;
			rows.forEach((row) => {
				const haystack = (row.dataset.search || '').toLowerCase();
				const matchesQuery = !query || haystack.includes(query);
				const matchesLetter = !this.selectedLetter || row.dataset.letter === this.selectedLetter;
				const fictional = row.dataset.fictional === 'true';
				const matchesFictional = !this.fictionalFilter
					|| (this.fictionalFilter === 'fictional' && fictional)
					|| (this.fictionalFilter === 'nonfictional' && !fictional);
				const matches = matchesQuery && matchesLetter && matchesFictional;
				row.hidden = !matches;
				if (matches) visible += 1;
			});
			this.visibleCount = visible;
			this.highlightMatches();
		},
		highlightMatches() {
			if (!this.$refs.orteTableBody || typeof Mark === 'undefined') return;
			const targets = this.$refs.orteTableBody.querySelectorAll('.orte-search-text');
			const marker = new Mark(targets);
			marker.unmark({
				done: () => {
					const query = this.search.trim();
					if (!query) return;
					const visibleTargets = this.$refs.orteTableBody.querySelectorAll('[data-role=\'orte-row\']:not([hidden]) .orte-search-text');
					const visibleMarker = new Mark(visibleTargets);
					visibleMarker.mark(query, {
						separateWordSearch: true,
					});
				},
			});
		},
		removeRow(placeId) {
			const row = this.$refs.orteTableBody?.querySelector(`[data-place-id='${CSS.escape(placeId)}']`);
			if (row) {
				row.remove();
			}
			this.totalCount = Math.max(0, this.totalCount - 1);
			this.filterRows();
		},
		init() {
			this.filterRows();
		},
	}"
	x-init="init()">
	<header class="admin-page-header">
		<div class="admin-page-heading">
			<div class="flex w-full items-end justify-between gap-4">
				<div>
					<h1 class="admin-page-title">Orte</h1>
				</div>
				{{- if (IsAdminOrEditor $model.request.user) -}}
					<a href="/admin/orte/new/" class="inline-flex items-center gap-1.5 rounded-xs bg-slate-800 px-3 py-1.5 font-sans text-[0.98rem] font-semibold text-stone-50 no-underline transition-colors hover:bg-slate-900 hover:text-white">
						<i class="ri-add-line"></i>
						<span>Neu</span>
					</a>
				{{- end -}}
			</div>
		</div>
		<div class="mt-5 flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
			<div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-2 gap-y-3">
				<div class="relative">
					<details class="font-sans text-base list-none" @toggle="alphabetOpen = $el.open">
						<summary class="cursor-pointer select-none text-gray-700 hover:text-slate-900 bg-gray-100 px-3 py-1.5 rounded-md flex items-center gap-2"
							:class="selectedLetter ? 'font-semibold text-slate-900 ring-1 ring-slate-300' : ''">
							<span x-text="selectedLetter ? `Alphabet: ${selectedLetter}` : 'Alphabet'"></span>
							<i class="ri-arrow-down-s-line transform origin-center transition-transform" :class="{ 'rotate-180': alphabetOpen }"></i>
						</summary>
						<div class="absolute left-0 mt-2 z-10 bg-white rounded-md shadow-lg border border-gray-200">
							<div class="p-2 w-[26rem]">
								<button
									type="button"
									x-show="selectedLetter"
									@click="selectedLetter = ''; alphabetOpen = false; $el.closest('details').open = false; filterRows()"
									class="mb-2 inline-flex w-full items-center justify-center gap-2 rounded bg-orange-100 px-2 py-1 text-sm font-semibold text-orange-800 hover:bg-orange-200 no-underline transition-colors">
									<i class="ri-filter-off-line text-base"></i>
									<span>Alle</span>
								</button>
								<div class="grid grid-cols-13 gap-1 text-sm text-gray-700">
									<template x-for="letter in letters" :key="letter">
										<button
											type="button"
											@click="selectedLetter = letter; alphabetOpen = false; $el.closest('details').open = false; filterRows()"
											:class="selectedLetter === letter ? 'bg-stone-200 font-bold' : ''"
											class="rounded px-2 py-1 text-center hover:bg-gray-100">
											<span x-text="letter"></span>
										</button>
									</template>
								</div>
							</div>
						</div>
					</details>
				</div>
				<div class="relative" @click.outside="fictionalOpen = false">
					<details class="font-sans text-base list-none" @toggle="fictionalOpen = $el.open">
						<summary class="cursor-pointer select-none text-gray-700 hover:text-slate-900 bg-gray-100 px-3 py-1.5 rounded-md flex items-center gap-2"
							:class="fictionalFilter ? 'font-semibold text-slate-900 ring-1 ring-slate-300' : ''">
							<span x-text="fictionalFilter === 'fictional' ? 'Fiktional' : fictionalFilter === 'nonfictional' ? 'Nicht fiktional' : 'Fiktional'"></span>
							<i class="ri-arrow-down-s-line transform origin-center transition-transform" :class="{ 'rotate-180': fictionalOpen }"></i>
						</summary>
						<div class="absolute left-0 mt-2 z-10 w-56 rounded-md border border-gray-200 bg-white shadow-lg">
							<div class="p-3 flex flex-col gap-1 text-sm text-gray-700">
								<button
									type="button"
									x-show="fictionalFilter"
									@click="clearFictionalFilter(); $el.closest('details').open = false"
									class="mb-2 inline-flex w-full items-center justify-center gap-2 rounded bg-orange-100 px-2 py-1 text-sm font-semibold text-orange-800 hover:bg-orange-200 no-underline transition-colors">
									<i class="ri-filter-off-line text-base"></i>
									<span>Alle</span>
								</button>
								<button
									type="button"
									@click="fictionalFilter = 'fictional'; fictionalOpen = false; $el.closest('details').open = false; filterRows()"
									:class="fictionalFilter === 'fictional' ? 'bg-stone-100 font-semibold' : ''"
									class="rounded-sm px-2 py-1 text-left hover:bg-stone-100">
									Nur fiktional
								</button>
								<button
									type="button"
									@click="fictionalFilter = 'nonfictional'; fictionalOpen = false; $el.closest('details').open = false; filterRows()"
									:class="fictionalFilter === 'nonfictional' ? 'bg-stone-100 font-semibold' : ''"
									class="rounded-sm px-2 py-1 text-left hover:bg-stone-100">
									Nur real
								</button>
							</div>
						</div>
					</details>
				</div>
				<div class="relative" @click.outside="if (searchOpen) closeSearch()">
					<button
						type="button"
						x-cloak
						x-show="!searchOpen"
						@click="openSearch()"
						class="cursor-pointer select-none text-gray-700 hover:text-slate-900 bg-gray-100 px-3 py-1.5 rounded-md flex items-center gap-2"
						:class="search ? 'font-semibold text-slate-900 ring-1 ring-slate-300' : ''">
						<span x-text="search ? `Suche: ${search}` : 'Suche'"></span>
						<i class="ri-search-line"></i>
					</button>
					<form
						x-cloak
						x-show="searchOpen"
						@submit.prevent
						class="flex items-center gap-2 rounded-md bg-gray-100 px-3 py-1.5 ring-1 ring-slate-300">
						<input
							x-ref="orteSearchInput"
							x-model="search"
							@input.debounce.120ms="filterRows()"
							type="search"
							class="search-input-no-native-clear min-w-[15rem] bg-transparent text-sm text-slate-900 placeholder:text-slate-500 focus:outline-none"
							placeholder="Ort oder Pseudonym" />
						<button
							type="button"
							@click="clearSearch()"
							class="text-gray-500 hover:text-slate-900"
							aria-label="Suche leeren">
							<i class="ri-close-line"></i>
						</button>
						<button x-show="false">Suchen</button>
					</form>
				</div>
			</div>
			<div class="shrink-0 self-start whitespace-nowrap text-lg font-semibold font-sans text-gray-600">
				<span x-text="visibleCount"></span><span>&thinsp;/&thinsp;</span><span x-text="totalCount"></span> Orte
			</div>
		</div>
	</header>

	<div class="admin-page-body admin-page-body-wide admin-page-body-flush pt-0">
		{{- if $model.result.Places -}}
			<div class="mt-2 overflow-x-auto overflow-y-visible">
				<table class="min-w-full table-fixed text-sm font-sans">
					<colgroup>
						<col />
						<col style="width: 9rem;" />
						<col style="width: 8rem;" />
						<col style="width: 8.5rem;" />
					</colgroup>
					<thead class="border-b text-left text-gray-600">
						<tr>
							<th class="py-2 pr-4 pl-4 align-bottom text-sm font-semibold tracking-wide">Ort</th>
							<th class="py-2 pr-4 align-bottom text-sm font-semibold tracking-wide">Fiktional</th>
							<th class="py-2 pr-4 align-bottom text-sm font-semibold tracking-wide">Bände</th>
							<th class="py-2 pr-8 text-right align-bottom text-sm font-semibold tracking-wide">Aktionen</th>
						</tr>
					</thead>
					<tbody x-ref="orteTableBody">
						{{- range $place := $model.result.Places -}}
							<tr
								data-role="orte-row"
								data-place-id="{{ $place.Id }}"
								data-search="{{ $place.Name }} {{ $place.Pseudonyms }}"
								data-letter="{{ Upper (First $place.Name) }}"
								data-fictional="{{ if $place.Fictional }}true{{ else }}false{{ end }}"
								class="border-b align-top transition-colors odd:bg-white even:bg-stone-50/60 hover:bg-stone-100">
								<td class="py-2 pr-4 pl-4">
									<div class="flex flex-col">
										<span class="orte-search-text text-base font-semibold leading-snug text-slate-900">{{ $place.Name }}</span>
										{{- if $place.Pseudonyms -}}
											<span class="orte-search-text mt-1 text-sm leading-snug text-gray-700 italic">{{ $place.Pseudonyms }}</span>
										{{- end -}}
									</div>
								</td>
								<td class="py-2 pr-4 text-sm text-gray-700">
									{{- if $place.Fictional -}}
										<span class="italic">fiktional</span>
									{{- else -}}
										<span class="text-stone-400">-</span>
									{{- end -}}
								</td>
								<td class="py-2 pr-4">
									{{- if (index $model.bcount $place.Id) -}}
										<div class="text-sm text-stone-700">
											<tool-tip position="top">
												<i class="ri-book-line"></i> {{ index $model.bcount $place.Id }}
												<div class="data-tip">Bände</div>
											</tool-tip>
										</div>
									{{- else -}}
										<span class="text-sm text-stone-400">0</span>
									{{- end -}}
								</td>
								<td class="py-2 pr-8">
									<div class="flex items-end justify-end">
										<div class="flex items-center justify-end gap-1.5 whitespace-nowrap">
											{{- if (IsAdminOrEditor $model.request.user) -}}
												<tool-tip position="top" class="inline">
													<button
														type="button"
														data-role="orte-delete"
														data-place-id="{{ $place.Id }}"
														data-place-name="{{ $place.Name }}"
														data-place-updated="{{ $place.Updated }}"
														data-delete-endpoint="/admin/ort/{{ $place.Id }}/edit/delete"
														class="inline-flex items-center gap-1 rounded-xs bg-red-50 px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-100 hover:text-red-900">
														<i class="ri-delete-bin-line"></i>
													</button>
													<div class="data-tip">Löschen</div>
												</tool-tip>
												<tool-tip position="top" class="inline">
													<a href="/admin/ort/{{ $place.Id }}/edit" class="no-underline inline-flex items-center gap-1 rounded-xs bg-stone-100 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-stone-200 hover:text-slate-900">
														<i class="ri-edit-line"></i>
													</a>
													<div class="data-tip">Bearbeiten</div>
												</tool-tip>
											{{- end -}}
										</div>
									</div>
								</td>
							</tr>
						{{- end -}}
					</tbody>
				</table>
			</div>
		{{- else -}}
			<p>Keine Orte gefunden.</p>
		{{- end -}}
	</div>

	<dialog data-role="orte-delete-dialog" class="fixed inset-0 m-auto rounded-md border border-slate-200 p-0 shadow-xl backdrop:bg-black/40">
		<div class="p-5 w-[24rem]">
			<div class="text-base font-bold text-gray-900">Ort löschen?</div>
			<div data-role="orte-delete-title" class="text-sm font-bold text-gray-900 mt-1"></div>
			<p class="mt-2 text-sm text-gray-700">Der Ort wird gelöscht und aus allen verknüpften Bänden entfernt.</p>
			<div data-role="orte-delete-error" class="mt-2 text-sm text-red-700 hidden"></div>
			<div class="mt-4 flex items-center justify-end gap-3">
				<button type="button" class="resetbutton w-auto px-3 py-1 text-sm" data-role="orte-delete-cancel">Abbrechen</button>
				<button type="button" class="submitbutton w-auto bg-red-700 hover:bg-red-800 px-3 py-1 text-sm" data-role="orte-delete-confirm">Löschen</button>
			</div>
			<input type="hidden" data-role="orte-delete-csrf" value="{{ $model.csrf_token }}" />
		</div>
	</dialog>
</div>

<script>
	(() => {
		const dialog = document.querySelector("[data-role='orte-delete-dialog']");
		if (!dialog) return;
		const titleEl = dialog.querySelector("[data-role='orte-delete-title']");
		const errorEl = dialog.querySelector("[data-role='orte-delete-error']");
		const cancelBtn = dialog.querySelector("[data-role='orte-delete-cancel']");
		const confirmBtn = dialog.querySelector("[data-role='orte-delete-confirm']");
		const csrfInput = dialog.querySelector("[data-role='orte-delete-csrf']");
		const root = document.querySelector(".admin-page-shell");

		let currentPlaceId = "";
		let currentDeleteEndpoint = "";
		let currentLastEdited = "";

		const setError = (message) => {
			if (!errorEl) return;
			if (message) {
				errorEl.textContent = message;
				errorEl.classList.remove("hidden");
			} else {
				errorEl.textContent = "";
				errorEl.classList.add("hidden");
			}
		};

		const closeDialog = (event) => {
			if (event) event.preventDefault();
			if (dialog.open) dialog.close();
		};

		const openDialog = () => {
			setError("");
			if (typeof dialog.showModal === "function") {
				dialog.showModal();
			} else {
				dialog.setAttribute("open", "open");
			}
		};

		document.addEventListener("click", (event) => {
			const button = event.target.closest("[data-role='orte-delete']");
			if (!button) return;
			event.preventDefault();
			currentPlaceId = button.getAttribute("data-place-id") || "";
			currentDeleteEndpoint = button.getAttribute("data-delete-endpoint") || "";
			currentLastEdited = button.getAttribute("data-place-updated") || "";
			if (titleEl) {
				titleEl.textContent = button.getAttribute("data-place-name") || "Unbekannter Ort";
			}
			openDialog();
		});

		if (cancelBtn) cancelBtn.addEventListener("click", closeDialog);
		dialog.addEventListener("cancel", closeDialog);

		if (confirmBtn) {
			confirmBtn.addEventListener("click", async (event) => {
				event.preventDefault();
				if (!currentDeleteEndpoint || !csrfInput) return;
				setError("");
				try {
					const response = await fetch(currentDeleteEndpoint, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							Accept: "application/json",
						},
						body: JSON.stringify({
							csrf_token: csrfInput.value || "",
							last_edited: currentLastEdited,
						}),
					});
					let data = null;
					try {
						data = await response.clone().json();
					} catch {
						data = null;
					}
					if (!response.ok) {
						throw new Error(data?.error || "Löschen fehlgeschlagen.");
					}
					closeDialog();
					const alpine = root && window.Alpine ? window.Alpine.$data(root) : null;
					if (alpine && currentPlaceId) {
						alpine.removeRow(currentPlaceId);
					}
				} catch (error) {
					setError(error instanceof Error ? error.message : "Löschen fehlgeschlagen.");
				}
			});
		}
	})();
</script>
