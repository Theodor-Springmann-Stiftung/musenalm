<!doctype html>
<html class="w-full h-full" {{ if .lang }}lang="{{ .lang }}"{{ end }}>
	<head>
		<script>
			(() => {
				try {
					const storedValue = window.localStorage.getItem('admin-sidebar-collapsed');
					if (storedValue !== 'false') {
						document.documentElement.classList.add('admin-layout-sidebar-collapsed');
					}
				} catch {}
			})();
		</script>

		{{ block "head" . }}
			<!-- Default Head elements -->
		{{ end }}

		{{ template "_head" . }}
	</head>

	<body id="body" class="w-full min-h-full" hx-ext="response-targets" hx-boost="true">
		<div
			x-data="{
				sidebarCollapsed: false,
				sidebarLockStates: {},
				pendingSidebarTitle: '',
				siteTitle: {{ printf "%q" .site.title }},
				expandCollapsedSidebarSections() {
					this.$nextTick(() => {
						document.querySelectorAll('#admin-sidebar details.admin-sidebar-section-collapsible:not(.admin-sidebar-create-section):not(.admin-sidebar-public-section)').forEach((el) => {
							el.open = true;
						});
					});
				},
				publishSidebarController() {
					window.__adminSidebarController = {
						lock: (lockId) => this.lockSidebar(lockId),
						unlock: (lockId) => this.unlockSidebar(lockId),
						isLocked: () => Object.keys(this.sidebarLockStates).length > 0,
					};
					window.dispatchEvent(new CustomEvent('admin-sidebar-controller-ready'));
				},
				syncSidebarActive(pathname = window.location.pathname) {
					const sidebar = document.getElementById('admin-sidebar');
					if (!sidebar) return;
					const normalizePath = (value) => {
						if (!value) return '/';
						return value.length > 1 ? value.replace(/\/+$/, '') : value;
					};
					const currentPath = normalizePath(pathname);
						const isBandContentsPath = currentPath.startsWith('/admin/almanach/') && currentPath.includes('/contents/edit');

					sidebar.querySelectorAll('.admin-sidebar-link').forEach((link) => {
						const datasetPrefixes = (link.dataset.adminActivePrefixes || '')
							.split('|')
							.map((value) => value.trim())
							.filter(Boolean);
						let isActive = false;
						if (datasetPrefixes.length) {
							isActive = datasetPrefixes.some((prefix) => {
								const normalizedPrefix = normalizePath(prefix);
								return currentPath === normalizedPrefix || currentPath.startsWith(normalizedPrefix + '/');
							});
						} else {
							let hrefPath = '';
							try {
								hrefPath = new URL(link.href, window.location.origin).pathname;
							} catch {}
							const normalizedHrefPath = normalizePath(hrefPath);
							isActive = !!normalizedHrefPath && normalizedHrefPath !== '/logout' && currentPath === normalizedHrefPath;
						}

						let hrefPath = '';
						try {
							hrefPath = new URL(link.href, window.location.origin).pathname;
						} catch {}
						const normalizedHrefPath = normalizePath(hrefPath);
							if (normalizedHrefPath === '/admin/baende' && isBandContentsPath) {
								isActive = false;
							}
							if (normalizedHrefPath === '/admin/beitraege' && isBandContentsPath) {
								isActive = true;
							}

						if (isActive) {
							link.setAttribute('aria-current', 'page');
						} else {
							link.removeAttribute('aria-current');
						}
					});

					sidebar.querySelectorAll('.admin-sidebar-section').forEach((section) => {
						const hasActiveLink = !!section.querySelector('.admin-sidebar-link[aria-current=&quot;page&quot;]');
						if (hasActiveLink) {
							section.setAttribute('data-section-current', 'true');
						} else {
							section.removeAttribute('data-section-current');
						}
					});
					const heading = document.querySelector('#admin-main-content .simple-entity-title, #admin-main-content .admin-page-title');
					const currentHeading = heading?.textContent?.trim() || '';
							sidebar.querySelectorAll('.admin-sidebar-link').forEach((link) => {
								const detail = link.querySelector('[data-role=admin-sidebar-link-detail]');
						if (!detail) return;
						let hrefPath = '';
						try {
							hrefPath = new URL(link.href, window.location.origin).pathname;
						} catch {}
						const normalizedHrefPath = normalizePath(hrefPath);
						const showDetail = link.getAttribute('aria-current') === 'page' && currentPath !== normalizedHrefPath;
						if (showDetail && currentHeading) {
							detail.textContent = currentHeading;
							detail.style.display = 'block';
						} else {
							detail.style.display = 'none';
						}
					});
				},
				syncSidebarState() {
					document.documentElement.classList.toggle('admin-layout-sidebar-collapsed', this.sidebarCollapsed);
					document.dispatchEvent(new CustomEvent('admin-sidebar-statechange', {
						detail: { collapsed: this.sidebarCollapsed },
					}));
				},
				lockSidebar(lockId) {
					const key = (lockId || '').trim();
					if (!key) return;
					if (!Object.prototype.hasOwnProperty.call(this.sidebarLockStates, key)) {
						this.sidebarLockStates[key] = this.sidebarCollapsed;
					}
					this.sidebarCollapsed = true;
					this.syncSidebarState();
					this.expandCollapsedSidebarSections();
				},
				unlockSidebar(lockId) {
					const key = (lockId || '').trim();
					if (!key || !Object.prototype.hasOwnProperty.call(this.sidebarLockStates, key)) return;
					const previousState = this.sidebarLockStates[key];
					delete this.sidebarLockStates[key];
					if (Object.keys(this.sidebarLockStates).length > 0) {
						return;
					}
					this.sidebarCollapsed = previousState;
					this.syncSidebarState();
					if (this.sidebarCollapsed) {
						this.expandCollapsedSidebarSections();
					}
				},
				applySidebarTitle(title = '') {
					const resolvedTitle = (title || '').trim();
					if (!resolvedTitle) return;
					document.title = `${this.siteTitle} – ${resolvedTitle}`;
				},
				init() {
					this.sidebarCollapsed = document.documentElement.classList.contains('admin-layout-sidebar-collapsed');
					this.syncSidebarState();
					this.syncSidebarActive();
					this.publishSidebarController();
					if (this.sidebarCollapsed) {
						this.expandCollapsedSidebarSections();
					}
				},
				toggleSidebar() {
					this.sidebarCollapsed = !this.sidebarCollapsed;
					try {
						window.localStorage.setItem('admin-sidebar-collapsed', String(this.sidebarCollapsed));
					} catch {}
					this.syncSidebarState();
					if (this.sidebarCollapsed) {
						this.expandCollapsedSidebarSections();
					}
				}
			}"
			@htmx:before-request.window="
				const sourceLink = $event.detail.requestConfig?.elt?.closest?.('[data-admin-main-link]');
				if (sourceLink) {
					pendingSidebarTitle = sourceLink.getAttribute('title') || sourceLink.textContent || '';
				}
			"
			@htmx:after-swap.window="
				if ($event.detail.target && $event.detail.target.id === 'admin-main-content') {
					const responseUrl = $event.detail.xhr?.responseURL || window.location.href;
					syncSidebarActive(new URL(responseUrl).pathname);
					if (pendingSidebarTitle) {
						applySidebarTitle(pendingSidebarTitle);
						pendingSidebarTitle = '';
					}
				}
			"
			@htmx:history-restore.window="syncSidebarActive(window.location.pathname)"
			:class="{ 'admin-layout-sidebar-collapsed': sidebarCollapsed }"
			class="admin-layout">
			<aside class="select-none admin-sidebar-frame" id="header">
				{{ template "_admin_sidebar" . }}
			</aside>
			<div class="admin-layout-main">
				{{ template "_global_notice" . }}
				<main class="admin-main">
					<div class="admin-main-shell">
						<div id="admin-main-loading" class="admin-main-loading htmx-indicator" aria-hidden="true">
							<div class="admin-main-loading-bar"></div>
						</div>
						<div id="admin-main-content" class="admin-main-content">
							{{ block "body" . }}
								<!-- Default app body... -->
							{{ end }}
						</div>
					</div>
				</main>
			</div>

			{{ block "scripts" . }}
				<!-- Default scripts... -->
			{{ end }}

			</div>
		</body>
	</html>
