<!doctype html>
<html class="w-full h-full" {{ if .lang }}lang="{{ .lang }}"{{ end }}>
	<head>
		<script>
			(() => {
				try {
					if (window.localStorage.getItem('admin-sidebar-collapsed') === 'true') {
						document.documentElement.classList.add('admin-layout-sidebar-collapsed');
					}
				} catch {}
			})();
		</script>

		{{ block "head" . }}
			<!-- Default Head elements -->
		{{ end }}

		{{ template "_head" . }}
	</head>

	<body id="body" class="w-full min-h-full" hx-ext="response-targets" hx-boost="true">
		<div
			x-data="{
				sidebarCollapsed: false,
				syncSidebarActive(pathname = window.location.pathname) {
					const sidebar = document.getElementById('admin-sidebar');
					if (!sidebar) return;
					const normalizePath = (value) => {
						if (!value) return '/';
						return value.length > 1 ? value.replace(/\/+$/, '') : value;
					};
					const currentPath = normalizePath(pathname);

					sidebar.querySelectorAll('.admin-sidebar-link').forEach((link) => {
						const datasetPrefixes = (link.dataset.adminActivePrefixes || '')
							.split('|')
							.map((value) => value.trim())
							.filter(Boolean);
						let isActive = false;
						if (datasetPrefixes.length) {
							isActive = datasetPrefixes.some((prefix) => {
								const normalizedPrefix = normalizePath(prefix);
								return currentPath === normalizedPrefix || currentPath.startsWith(normalizedPrefix + '/');
							});
						} else {
							let hrefPath = '';
							try {
								hrefPath = new URL(link.href, window.location.origin).pathname;
							} catch {}
							const normalizedHrefPath = normalizePath(hrefPath);
							isActive = !!normalizedHrefPath && normalizedHrefPath !== '/logout' && currentPath === normalizedHrefPath;
						}
						if (isActive) {
							link.setAttribute('aria-current', 'page');
						} else {
							link.removeAttribute('aria-current');
						}
					});

					sidebar.querySelectorAll('.admin-sidebar-section').forEach((section) => {
						const hasActiveLink = !!section.querySelector('.admin-sidebar-link[aria-current=&quot;page&quot;]');
						if (hasActiveLink) {
							section.setAttribute('data-section-current', 'true');
						} else {
							section.removeAttribute('data-section-current');
						}
					});
				},
				syncSidebarState() {
					document.documentElement.classList.toggle('admin-layout-sidebar-collapsed', this.sidebarCollapsed);
				},
				init() {
					this.sidebarCollapsed = document.documentElement.classList.contains('admin-layout-sidebar-collapsed');
					this.syncSidebarState();
					this.syncSidebarActive();
					if (this.sidebarCollapsed) {
						this.$nextTick(() => {
							document.querySelectorAll('#admin-sidebar details:not(.admin-sidebar-create-section):not(.admin-sidebar-public-section)').forEach((el) => {
								el.open = true;
							});
						});
					}
				},
				toggleSidebar() {
					this.sidebarCollapsed = !this.sidebarCollapsed;
					window.localStorage.setItem('admin-sidebar-collapsed', String(this.sidebarCollapsed));
					this.syncSidebarState();
					if (this.sidebarCollapsed) {
						this.$nextTick(() => {
							document.querySelectorAll('#admin-sidebar details:not(.admin-sidebar-create-section):not(.admin-sidebar-public-section)').forEach((el) => {
								el.open = true;
							});
						});
					}
				}
			}"
			@htmx:after-swap.window="
				if ($event.detail.target && $event.detail.target.id === 'admin-main-content') {
					const responseUrl = $event.detail.xhr?.responseURL || window.location.href;
					syncSidebarActive(new URL(responseUrl).pathname);
				}
			"
			@htmx:history-restore.window="syncSidebarActive(window.location.pathname)"
			:class="{ 'admin-layout-sidebar-collapsed': sidebarCollapsed }"
			class="admin-layout">
			<aside class="admin-sidebar-frame" id="header">
				{{ template "_admin_sidebar" . }}
			</aside>
			<div class="admin-layout-main">
				{{ template "_global_notice" . }}
				<main class="admin-main">
					<div class="admin-main-shell">
						<div id="admin-main-loading" class="admin-main-loading htmx-indicator" aria-hidden="true">
							<div class="admin-main-loading-bar"></div>
						</div>
						<div id="admin-main-content">
							{{ block "body" . }}
								<!-- Default app body... -->
							{{ end }}
						</div>
					</div>
				</main>
			</div>

			{{ block "scripts" . }}
				<!-- Default scripts... -->
			{{ end }}

			{{ template "_scripts" . }}
		</div>
	</body>
</html>
