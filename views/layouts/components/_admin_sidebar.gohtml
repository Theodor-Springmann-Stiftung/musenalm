{{ $model := . }}
{{- $accountHref := "/login/" -}}
{{- $profilePathPrefix := "" -}}
{{- $canEditAccount := false -}}
{{- $isAdminUser := and $model.request $model.request.user (eq $model.request.user.Role "Admin") -}}
{{- $path := "" -}}
{{- $isVisitorSidebar := .visitor_sidebar -}}
{{- if and $model.request $model.request.user (not $model.request.user.IsSuperuser) -}}
	{{- $accountHref = (printf "/admin/user/%s/edit/" $model.request.user.Id) -}}
	{{- $profilePathPrefix = (printf "/admin/user/%s/edit" $model.request.user.Id) -}}
	{{- $canEditAccount = true -}}
{{- end -}}
{{- if and $model.request $model.request.path -}}
	{{- $path = $model.request.path -}}
{{- end -}}
{{- $isPublicReihenActive := or (eq $path "/reihen") (HasPrefix $path "/reihen/") (HasPrefix $path "/reihe/") -}}
{{- $isPublicPersonsActive := or (eq $path "/personen") (HasPrefix $path "/personen/") (HasPrefix $path "/person/") -}}
{{- $isPublicSearchActive := or (eq $path "/suche") (HasPrefix $path "/suche/") -}}
{{- $isPublicEditorialIntroActive := or (eq $path "/") (eq $path "/index") (eq $path "/index/") (eq $path "/redaktion/einleitung") (HasPrefix $path "/redaktion/einleitung/") -}}
{{- $isPublicEditorialHintsActive := or (eq $path "/redaktion/benutzerhinweise") (HasPrefix $path "/redaktion/benutzerhinweise/") -}}
{{- $isPublicEditorialLitActive := or (eq $path "/redaktion/literatur") (HasPrefix $path "/redaktion/literatur/") -}}
{{- $isPublicEditorialCabinetActive := or (eq $path "/redaktion/lesekabinett") (HasPrefix $path "/redaktion/lesekabinett/") -}}
{{- $isPublicEditorialThanksActive := or (eq $path "/redaktion/danksagungen") (HasPrefix $path "/redaktion/danksagungen/") -}}
{{- $isPublicEditorialContactActive := or (eq $path "/redaktion/kontakt") (HasPrefix $path "/redaktion/kontakt/") -}}
{{- $isNewBandActive := HasPrefix $path "/admin/almanach-new/" -}}
{{- $bandContentsPathPrefix := "" -}}
{{- if and (HasPrefix $path "/admin/almanach/") $model.result $model.result.Entry -}}
	{{- $bandContentsPathPrefix = printf "/admin/almanach/%v/contents/edit" $model.result.Entry.MusenalmID -}}
{{- end -}}
{{- $isBandContentsActive := and $bandContentsPathPrefix (HasPrefix $path $bandContentsPathPrefix) -}}
{{- $isBandsActive := or (HasPrefix $path "/admin/baende/") (and (HasPrefix $path "/admin/almanach/") (not $isBandContentsActive)) -}}
{{- $isContentsActive := or (HasPrefix $path "/admin/beitraege/") $isBandContentsActive -}}
{{- $isNewSeriesActive := HasPrefix $path "/admin/reihen/new/" -}}
{{- $isSeriesActive := or (HasPrefix $path "/admin/reihen/") (eq $path "/reihen") (HasPrefix $path "/reihen/") (HasPrefix $path "/reihe/") (HasPrefix $path "/admin/reihe/") -}}
{{- $isNewPlaceActive := HasPrefix $path "/admin/orte/new/" -}}
{{- $isPlacesActive := or (HasPrefix $path "/admin/orte/") (HasPrefix $path "/admin/ort/") -}}
{{- $isNewPersonActive := HasPrefix $path "/admin/personen/new/" -}}
{{- $isPersonsActive := or (HasPrefix $path "/admin/personen/") (HasPrefix $path "/admin/person/") (eq $path "/personen") (HasPrefix $path "/personen/") (HasPrefix $path "/person/") -}}
{{- $isAbbreviationsActive := HasPrefix $path "/admin/abkuerzungen/" -}}
{{- $isPagesActive := HasPrefix $path "/admin/seiten/" -}}
{{- $isSettingsActive := HasPrefix $path "/admin/settings/" -}}
{{- $isExportsActive := HasPrefix $path "/admin/exports/" -}}
{{- $isUserInviteActive := HasPrefix $path "/admin/user/management/access" -}}
{{- $isUserManagementActive := and (HasPrefix $path "/admin/user/management") (not $isUserInviteActive) -}}
{{- $isProfileActive := and $profilePathPrefix (HasPrefix $path $profilePathPrefix) -}}
{{- if $isVisitorSidebar -}}
	{{- $isSeriesActive = or (HasPrefix $path "/admin/reihen/") (HasPrefix $path "/admin/reihe/") -}}
	{{- $isBandsActive = or (HasPrefix $path "/admin/baende/") (HasPrefix $path "/admin/almanach/") -}}
	{{- $isContentsActive = or (HasPrefix $path "/admin/beitraege/") $isBandContentsActive -}}
	{{- $isPersonsActive = or (HasPrefix $path "/admin/personen/") (HasPrefix $path "/admin/person/") -}}
	{{- $isPlacesActive = or (HasPrefix $path "/admin/orte/") (HasPrefix $path "/admin/ort/") -}}
{{- end -}}
{{- $isPublicSectionActive := or $isPublicReihenActive $isPublicPersonsActive $isPublicSearchActive $isPublicEditorialIntroActive $isPublicEditorialHintsActive $isPublicEditorialLitActive $isPublicEditorialCabinetActive $isPublicEditorialThanksActive $isPublicEditorialContactActive -}}
{{- $isCreateSectionActive := or $isNewBandActive $isNewSeriesActive $isNewPlaceActive $isNewPersonActive -}}
{{- $isListsSectionActive := or $isBandsActive $isContentsActive $isSeriesActive $isPlacesActive $isPersonsActive $isAbbreviationsActive $isPagesActive -}}
{{- $isAdminSectionActive := or $isSettingsActive $isExportsActive $isUserInviteActive $isUserManagementActive -}}
{{- $seriesSidebarDetail := "" -}}
{{- if and (HasPrefix $path "/admin/reihe/") $model.result $model.result.Series (not $model.is_new) -}}
	{{- $seriesSidebarDetail = $model.result.Series.Title -}}
{{- end -}}
{{- $personSidebarDetail := "" -}}
{{- if and (HasPrefix $path "/admin/person/") $model.result $model.result.Agent (not $model.is_new) -}}
	{{- $personSidebarDetail = $model.result.Agent.Name -}}
{{- end -}}
{{- $placeSidebarDetail := "" -}}
{{- if and (HasPrefix $path "/admin/ort/") $model.result $model.result.Place (not $model.is_new) -}}
	{{- $placeSidebarDetail = $model.result.Place.Name -}}
{{- end -}}
{{- $bandSidebarDetail := "" -}}
{{- if and (HasPrefix $path "/admin/almanach/") $model.result $model.result.Entry (not $model.is_new) (not $isBandContentsActive) -}}
	{{- $bandSidebarDetail = $model.result.Entry.PreferredTitle -}}
{{- end -}}
{{- $contentsSidebarDetail := "" -}}
{{- if and $isBandContentsActive $model.result $model.result.Entry (not $model.is_new) -}}
	{{- $contentsSidebarDetail = $model.result.Entry.PreferredTitle -}}
{{- end -}}

<div id="admin-sidebar" class="admin-sidebar-inner">
	<div class="admin-sidebar-brand">
		<a href="/" class="no-underline admin-brand-logo-wrap" aria-label="Startseite">
			<img class="admin-brand-logo" src="/assets/favicon_transparent.png" />
		</a>
		<div class="admin-brand-copy">
			<h1 class="admin-brand-title">
				<a href="/" class="no-underline admin-brand-link">{{ .site.title }}</a>
			</h1>
			<div class="admin-mode-pill">Verwaltung</div>
		</div>
		{{- if $isVisitorSidebar -}}
			<button
				type="button"
				class="admin-sidebar-toggle"
				@click="closeVisitorSidebar()"
				aria-label="Verwaltung schließen"
				data-admin-sidebar-tooltip="Verwaltung schließen">
				<i class="ri-close-line" aria-hidden="true"></i>
			</button>
		{{- else -}}
			<button
				type="button"
				class="admin-sidebar-toggle"
				@click="toggleSidebar()"
				:aria-label="sidebarCollapsed ? 'Seitenleiste erweitern' : 'Seitenleiste einklappen'"
				:data-admin-sidebar-tooltip="sidebarCollapsed ? 'Seitenleiste erweitern' : 'Seitenleiste einklappen'">
				<i class="ri-layout-left-line" x-show="!sidebarCollapsed" aria-hidden="true"></i>
				<i class="ri-layout-right-line" x-show="sidebarCollapsed" x-cloak aria-hidden="true"></i>
			</button>
		{{- end -}}
	</div>

	{{- if not $isVisitorSidebar -}}
	<div class="admin-sidebar-collapsed-public" x-data="{ open: false, submenu: '' }" @click.outside="open = false; submenu = ''">
		<button
			type="button"
			class="admin-sidebar-collapsed-public-trigger"
			:class="{ 'is-open': open }"
			data-admin-sidebar-tooltip="Öffentliche Seiten"
			@click="if (open) { open = false; submenu = '' } else { open = true }">
			<i class="ri-global-line" aria-hidden="true"></i>
		</button>
		<div x-cloak x-show="open" class="admin-sidebar-collapsed-public-popout">
			<a href="/reihen/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Reihen</a>
			<a href="/personen/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Personen</a>
			<a href="/suche/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Suche</a>
			<button
				type="button"
				class="admin-sidebar-collapsed-public-link admin-sidebar-collapsed-public-subtrigger"
				:class="{ 'active': submenu === 'redaktion' }"
				@click.stop="submenu = submenu === 'redaktion' ? '' : 'redaktion'"
				@mouseenter="submenu = 'redaktion'"
				@focus="submenu = 'redaktion'">
				<span>Redaktion</span>
				<i class="ri-arrow-right-s-line" aria-hidden="true"></i>
			</button>
		</div>
		<div x-cloak x-show="open && submenu === 'redaktion'" class="admin-sidebar-collapsed-public-submenu">
			<a href="/redaktion/einleitung/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Einleitung</a>
			<a href="/redaktion/benutzerhinweise/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Hinweise</a>
			<a href="/redaktion/literatur/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Literatur</a>
			<a href="/redaktion/lesekabinett/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Lesekabinett</a>
			<a href="/redaktion/danksagungen/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Danksagungen</a>
			<a href="/redaktion/kontakt/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Kontakt</a>
		</div>
	</div>

	<div class="admin-sidebar-collapsed-create" x-data="{ open: false }" @click.outside="open = false">
		<button type="button" class="admin-sidebar-collapsed-create-trigger" :class="{ 'is-open': open }" data-admin-sidebar-tooltip="Neu" @click="open = !open">
			<i class="ri-add-circle-line" aria-hidden="true"></i>
		</button>
		<div x-cloak x-show="open" class="admin-sidebar-collapsed-create-popout">
			<a href="/admin/almanach-new/" class="admin-sidebar-collapsed-create-link{{ if $isNewBandActive }} active{{ end }}">Neuer Band</a>
			<a href="/admin/reihen/new/" class="admin-sidebar-collapsed-create-link{{ if $isNewSeriesActive }} active{{ end }}">Neue Reihe</a>
			<a href="/admin/orte/new/" class="admin-sidebar-collapsed-create-link{{ if $isNewPlaceActive }} active{{ end }}">Neuer Ort</a>
			<a href="/admin/personen/new/" class="admin-sidebar-collapsed-create-link{{ if $isNewPersonActive }} active{{ end }}">Neue Person</a>
		</div>
	</div>
	{{- end -}}

	<nav class="admin-sidebar-nav" aria-label="Administration Navigation">
		<details class="admin-sidebar-section admin-sidebar-section-collapsible admin-sidebar-public-section" {{ if $isPublicSectionActive }}open data-section-current="true"{{ end }}>
			<summary class="admin-sidebar-section-title">
				<span>&Ouml;ffentliche Seiten</span>
				<i class="ri-arrow-down-s-line admin-sidebar-section-state-icon" aria-hidden="true"></i>
			</summary>
			<div class="admin-sidebar-sub">
				<a href="/reihen/" hx-boost="false" data-admin-sidebar-tooltip="Reihen" class="admin-sidebar-link" {{ if $isPublicReihenActive }}aria-current="page"{{ end }}>
					<span class="admin-sidebar-link-label">
						<i class="ri-book-shelf-line admin-sidebar-link-icon" aria-hidden="true"></i>
						<span>Reihen</span>
					</span>
				</a>
				<a href="/personen/" hx-boost="false" data-admin-sidebar-tooltip="Personen" class="admin-sidebar-link" {{ if $isPublicPersonsActive }}aria-current="page"{{ end }}>
					<span class="admin-sidebar-link-label">
						<i class="ri-group-line admin-sidebar-link-icon" aria-hidden="true"></i>
						<span>Personen</span>
					</span>
				</a>
				<a href="/suche/" hx-boost="false" data-admin-sidebar-tooltip="Suche" class="admin-sidebar-link" {{ if $isPublicSearchActive }}aria-current="page"{{ end }}>
					<span class="admin-sidebar-link-label">
						<i class="ri-search-line admin-sidebar-link-icon" aria-hidden="true"></i>
						<span>Suche</span>
					</span>
				</a>
				<div class="admin-sidebar-group">
					<div class="admin-sidebar-group-title admin-sidebar-group-title-prominent">Redaktion</div>
					<div class="admin-sidebar-group-links">
						<a href="/redaktion/einleitung/" hx-boost="false" data-admin-sidebar-tooltip="Einleitung" class="admin-sidebar-link admin-sidebar-link-nested" {{ if $isPublicEditorialIntroActive }}aria-current="page"{{ end }}>
							<span class="admin-sidebar-link-label">
								<i class="ri-quill-pen-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Einleitung</span>
							</span>
						</a>
						<a href="/redaktion/benutzerhinweise/" hx-boost="false" data-admin-sidebar-tooltip="Hinweise" class="admin-sidebar-link admin-sidebar-link-nested" {{ if $isPublicEditorialHintsActive }}aria-current="page"{{ end }}>
							<span class="admin-sidebar-link-label">
								<i class="ri-information-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Hinweise</span>
							</span>
						</a>
						<a href="/redaktion/literatur/" hx-boost="false" data-admin-sidebar-tooltip="Literatur" class="admin-sidebar-link admin-sidebar-link-nested" {{ if $isPublicEditorialLitActive }}aria-current="page"{{ end }}>
							<span class="admin-sidebar-link-label">
								<i class="ri-book-open-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Literatur</span>
							</span>
						</a>
						<a href="/redaktion/lesekabinett/" hx-boost="false" data-admin-sidebar-tooltip="Lesekabinett" class="admin-sidebar-link admin-sidebar-link-nested" {{ if $isPublicEditorialCabinetActive }}aria-current="page"{{ end }}>
							<span class="admin-sidebar-link-label">
								<i class="ri-archive-drawer-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Lesekabinett</span>
							</span>
						</a>
						<a href="/redaktion/danksagungen/" hx-boost="false" data-admin-sidebar-tooltip="Danksagungen" class="admin-sidebar-link admin-sidebar-link-nested" {{ if $isPublicEditorialThanksActive }}aria-current="page"{{ end }}>
							<span class="admin-sidebar-link-label">
								<i class="ri-heart-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Danksagungen</span>
							</span>
						</a>
						<a href="/redaktion/kontakt/" hx-boost="false" data-admin-sidebar-tooltip="Kontakt" class="admin-sidebar-link admin-sidebar-link-nested" {{ if $isPublicEditorialContactActive }}aria-current="page"{{ end }}>
							<span class="admin-sidebar-link-label">
								<i class="ri-mail-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Kontakt</span>
							</span>
						</a>
					</div>
				</div>
			</div>
		</details>

		<details class="admin-sidebar-section admin-sidebar-section-collapsible admin-sidebar-create-section" {{ if $isCreateSectionActive }}open data-section-current="true"{{ end }}>
			<summary class="admin-sidebar-section-title">
				<span>Neu</span>
				<i class="ri-arrow-down-s-line admin-sidebar-section-state-icon" aria-hidden="true"></i>
			</summary>
			<div class="admin-sidebar-sub">
				<a href="/admin/almanach-new/" data-admin-sidebar-tooltip="Neuer Band" class="admin-sidebar-link" {{ if $isNewBandActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-add-circle-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Neuer Band</span></span></a>
				<a href="/admin/reihen/new/" data-admin-sidebar-tooltip="Neue Reihe" class="admin-sidebar-link" {{ if $isNewSeriesActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-add-circle-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Neue Reihe</span></span></a>
				<a href="/admin/orte/new/" data-admin-sidebar-tooltip="Neuer Ort" class="admin-sidebar-link" {{ if $isNewPlaceActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-add-circle-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Neuer Ort</span></span></a>
				<a href="/admin/personen/new/" data-admin-sidebar-tooltip="Neue Person" class="admin-sidebar-link" {{ if $isNewPersonActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-add-circle-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Neue Person</span></span></a>
			</div>
		</details>

		<details class="admin-sidebar-section admin-sidebar-section-collapsible" open {{ if $isListsSectionActive }}data-section-current="true"{{ end }}>
			<summary class="admin-sidebar-section-title">
				<span>Entitäten</span>
				<i class="ri-arrow-down-s-line admin-sidebar-section-state-icon" aria-hidden="true"></i>
			</summary>
			<div class="admin-sidebar-sub">
				<a href="/admin/reihen/" data-admin-sidebar-tooltip="Reihen" class="admin-sidebar-link" {{ if not $isVisitorSidebar }}data-admin-main-link data-admin-active-prefixes="/admin/reihen/|/reihen/|/reihe/|/admin/reihe/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}'{{ end }} {{ if $isSeriesActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-book-shelf-fill admin-sidebar-link-icon" aria-hidden="true"></i><span>Reihen</span></span><span class="admin-sidebar-link-detail" data-role="admin-sidebar-link-detail">{{ $seriesSidebarDetail }}</span></a>
				<a href="/admin/baende/" data-admin-sidebar-tooltip="Bände" class="admin-sidebar-link" {{ if not $isVisitorSidebar }}data-admin-main-link data-admin-active-prefixes="/admin/baende/|/admin/almanach/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}'{{ end }} {{ if $isBandsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-book-line admin-sidebar-link-icon" aria-hidden="true"></i><span>B&auml;nde</span></span><span class="admin-sidebar-link-detail" data-role="admin-sidebar-link-detail">{{ $bandSidebarDetail }}</span></a>
				<a href="/admin/beitraege/" data-admin-sidebar-tooltip="Beiträge" class="admin-sidebar-link" {{ if not $isVisitorSidebar }}data-admin-main-link data-admin-active-prefixes="/admin/beitraege/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}'{{ end }} {{ if $isContentsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-article-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Beitr&auml;ge</span></span><span class="admin-sidebar-link-detail" data-role="admin-sidebar-link-detail">{{ $contentsSidebarDetail }}</span></a>
				<a href="/admin/personen/" data-admin-sidebar-tooltip="Personen" class="admin-sidebar-link" {{ if not $isVisitorSidebar }}data-admin-main-link data-admin-active-prefixes="/admin/personen/|/admin/person/|/personen/|/person/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}'{{ end }} {{ if $isPersonsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-user-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Personen</span></span><span class="admin-sidebar-link-detail" data-role="admin-sidebar-link-detail">{{ $personSidebarDetail }}</span></a>
				<a href="/admin/orte/" data-admin-sidebar-tooltip="Orte" class="admin-sidebar-link" {{ if not $isVisitorSidebar }}data-admin-main-link data-admin-active-prefixes="/admin/orte/|/admin/ort/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}'{{ end }} {{ if $isPlacesActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-map-pin-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Orte</span></span><span class="admin-sidebar-link-detail" data-role="admin-sidebar-link-detail">{{ $placeSidebarDetail }}</span></a>
				<a href="/admin/abkuerzungen/" data-admin-sidebar-tooltip="Abkürzungen" class="admin-sidebar-link" {{ if $isAbbreviationsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-text admin-sidebar-link-icon" aria-hidden="true"></i><span>Abk&uuml;rzungen</span></span></a>
				<a href="/admin/seiten/" data-admin-sidebar-tooltip="Seiten" hx-boost="false" class="admin-sidebar-link" {{ if $isPagesActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-pages-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Seiten</span></span></a>
			</div>
		</details>

		{{- if $isAdminUser -}}
		<details class="admin-sidebar-section admin-sidebar-section-collapsible" open {{ if $isAdminSectionActive }}data-section-current="true"{{ end }}>
			<summary class="admin-sidebar-section-title">
				<span>Administration</span>
				<i class="ri-arrow-down-s-line admin-sidebar-section-state-icon" aria-hidden="true"></i>
			</summary>
			<div class="admin-sidebar-sub">
				<a href="/admin/settings/" data-admin-sidebar-tooltip="Einstellungen" class="admin-sidebar-link" {{ if $isSettingsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-settings-3-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Einstellungen</span></span></a>
				<a href="/admin/exports/" data-admin-sidebar-tooltip="Daten &amp; Export" class="admin-sidebar-link" {{ if $isExportsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-database-2-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Daten &amp; Export</span></span></a>
				<a href="/admin/user/management/access/User" data-admin-sidebar-tooltip="Nutzer einladen" class="admin-sidebar-link" {{ if $isUserInviteActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-key-2-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Nutzer einladen</span></span></a>
				<a href="/admin/user/management" data-admin-sidebar-tooltip="Benutzerverwaltung" class="admin-sidebar-link" {{ if $isUserManagementActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-group-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Benutzerverwaltung</span></span></a>
			</div>
		</details>
		{{- end -}}
	</nav>

	<div class="admin-sidebar-account">
		<div class="admin-sidebar-account-name">
			{{- if and $model.request $model.request.user $model.request.user.Name -}}
				{{ $model.request.user.Name }}
			{{- else -}}
				Account
			{{- end -}}
		</div>
		<div class="admin-sidebar-account-role">
			{{- if and $model.request $model.request.user -}}
				{{- if eq $model.request.user.Role "Admin" -}}
					Administrator
				{{- else if eq $model.request.user.Role "Editor" -}}
					Redaktion
				{{- else -}}
					Benutzer
				{{- end -}}
			{{- else -}}
				Nicht angemeldet
			{{- end -}}
		</div>
		<div class="admin-sidebar-account-links">
			<span class="admin-sidebar-account-icon" data-admin-sidebar-tooltip="Konto">
				<i class="ri-user-line" aria-hidden="true"></i>
			</span>
			{{- if $canEditAccount -}}
				<a href="{{ $accountHref }}" data-admin-sidebar-tooltip="Bearbeiten" class="admin-sidebar-link admin-sidebar-account-link" {{ if $isProfileActive }}aria-current="page"{{ end }}>
					<span class="admin-sidebar-link-label"><i class="ri-pencil-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Bearbeiten</span></span>
				</a>
			{{- end -}}
			<a href="/logout/?redirectTo=/reihen/" data-admin-sidebar-tooltip="Logout" class="admin-sidebar-link admin-sidebar-account-link">
				<span class="admin-sidebar-link-label"><i class="ri-logout-box-r-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Logout</span></span>
			</a>
		</div>
	</div>
</div>
