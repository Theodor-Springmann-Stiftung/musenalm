{{ $model := . }}
{{- $accountHref := "/login/" -}}
{{- $profilePathPrefix := "" -}}
{{- $canEditAccount := false -}}
{{- $isAdminUser := and $model.request $model.request.user (eq $model.request.user.Role "Admin") -}}
{{- $path := "" -}}
{{- if and $model.request $model.request.user (not $model.request.user.IsSuperuser) -}}
	{{- $accountHref = (printf "/admin/user/%s/edit/" $model.request.user.Id) -}}
	{{- $profilePathPrefix = (printf "/admin/user/%s/edit" $model.request.user.Id) -}}
	{{- $canEditAccount = true -}}
{{- end -}}
{{- if and $model.request $model.request.path -}}
	{{- $path = $model.request.path -}}
{{- end -}}
{{- $isNewBandActive := HasPrefix $path "/admin/almanach-new/" -}}
{{- $isBandsActive := or (HasPrefix $path "/admin/baende/") (HasPrefix $path "/admin/almanach/") -}}
{{- $isNewSeriesActive := HasPrefix $path "/admin/reihen/new/" -}}
{{- $isSeriesActive := or (HasPrefix $path "/admin/reihen/") (eq $path "/reihen") (HasPrefix $path "/reihen/") (HasPrefix $path "/reihe/") (HasPrefix $path "/admin/reihe/") -}}
{{- $isNewPlaceActive := HasPrefix $path "/admin/orte/new/" -}}
{{- $isPlacesActive := or (HasPrefix $path "/admin/orte/") (HasPrefix $path "/admin/ort/") -}}
{{- $isNewPersonActive := HasPrefix $path "/admin/personen/new/" -}}
{{- $isPersonsActive := or (HasPrefix $path "/admin/personen/") (HasPrefix $path "/admin/person/") (eq $path "/personen") (HasPrefix $path "/personen/") (HasPrefix $path "/person/") -}}
{{- $isAbbreviationsActive := HasPrefix $path "/admin/abkuerzungen/" -}}
{{- $isPagesActive := HasPrefix $path "/admin/seiten/" -}}
{{- $isSettingsActive := HasPrefix $path "/admin/settings/" -}}
{{- $isExportsActive := HasPrefix $path "/admin/exports/" -}}
{{- $isUserInviteActive := HasPrefix $path "/admin/user/management/access" -}}
{{- $isUserManagementActive := and (HasPrefix $path "/admin/user/management") (not $isUserInviteActive) -}}
{{- $isProfileActive := and $profilePathPrefix (HasPrefix $path $profilePathPrefix) -}}
{{- $isPublicSectionActive := false -}}
{{- $isCreateSectionActive := or $isNewBandActive $isNewSeriesActive $isNewPlaceActive $isNewPersonActive -}}
{{- $isListsSectionActive := or $isBandsActive $isSeriesActive $isPlacesActive $isPersonsActive $isAbbreviationsActive $isPagesActive -}}
{{- $isAdminSectionActive := or $isSettingsActive $isExportsActive $isUserInviteActive $isUserManagementActive -}}

<div id="admin-sidebar" class="admin-sidebar-inner">
	<div class="admin-sidebar-brand">
		<a href="/" class="no-underline admin-brand-logo-wrap" aria-label="Startseite">
			<img class="admin-brand-logo" src="/assets/favicon_transparent.png" />
		</a>
		<div class="admin-brand-copy">
			<h1 class="admin-brand-title">
				<a href="/" class="no-underline admin-brand-link">{{ .site.title }}</a>
			</h1>
			<div class="admin-mode-pill">Verwaltung</div>
		</div>
		<button
			type="button"
			class="admin-sidebar-toggle"
			@click="toggleSidebar()"
			:aria-label="sidebarCollapsed ? 'Seitenleiste erweitern' : 'Seitenleiste einklappen'"
			:title="sidebarCollapsed ? 'Seitenleiste erweitern' : 'Seitenleiste einklappen'">
			<i class="ri-layout-left-line" x-show="!sidebarCollapsed" aria-hidden="true"></i>
			<i class="ri-layout-right-line" x-show="sidebarCollapsed" x-cloak aria-hidden="true"></i>
		</button>
	</div>

	<div class="admin-sidebar-collapsed-public" x-data="{ open: false, submenu: '' }" @click.outside="open = false; submenu = ''">
		<button
			type="button"
			class="admin-sidebar-collapsed-public-trigger"
			:class="{ 'is-open': open }"
			title="Öffentliche Seiten"
			@click="if (open) { open = false; submenu = '' } else { open = true }">
			<i class="ri-global-line" aria-hidden="true"></i>
		</button>
		<div x-cloak x-show="open" class="admin-sidebar-collapsed-public-popout">
			<a href="/reihen/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Reihen</a>
			<a href="/personen/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Personen</a>
			<a href="/suche/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Suche</a>
			<button
				type="button"
				class="admin-sidebar-collapsed-public-link admin-sidebar-collapsed-public-subtrigger"
				:class="{ 'active': submenu === 'redaktion' }"
				@click.stop="submenu = submenu === 'redaktion' ? '' : 'redaktion'"
				@mouseenter="submenu = 'redaktion'"
				@focus="submenu = 'redaktion'">
				<span>Redaktion</span>
				<i class="ri-arrow-right-s-line" aria-hidden="true"></i>
			</button>
		</div>
		<div x-cloak x-show="open && submenu === 'redaktion'" class="admin-sidebar-collapsed-public-submenu">
			<a href="/redaktion/einleitung/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Einleitung</a>
			<a href="/redaktion/benutzerhinweise/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Hinweise</a>
			<a href="/redaktion/literatur/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Literatur</a>
			<a href="/redaktion/lesekabinett/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Lesekabinett</a>
			<a href="/redaktion/danksagungen/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Danksagungen</a>
			<a href="/redaktion/kontakt/" hx-boost="false" class="admin-sidebar-collapsed-public-link">Kontakt</a>
		</div>
	</div>

	<div class="admin-sidebar-collapsed-create" x-data="{ open: false }" @click.outside="open = false">
		<button type="button" class="admin-sidebar-collapsed-create-trigger" :class="{ 'is-open': open }" title="Neu" @click="open = !open">
			<i class="ri-add-circle-line" aria-hidden="true"></i>
		</button>
		<div x-cloak x-show="open" class="admin-sidebar-collapsed-create-popout">
			<a href="/admin/almanach-new/" class="admin-sidebar-collapsed-create-link{{ if $isNewBandActive }} active{{ end }}">Neuer Band</a>
			<a href="/admin/reihen/new/" class="admin-sidebar-collapsed-create-link{{ if $isNewSeriesActive }} active{{ end }}">Neue Reihe</a>
			<a href="/admin/orte/new/" class="admin-sidebar-collapsed-create-link{{ if $isNewPlaceActive }} active{{ end }}">Neuer Ort</a>
			<a href="/admin/personen/new/" class="admin-sidebar-collapsed-create-link{{ if $isNewPersonActive }} active{{ end }}">Neue Person</a>
		</div>
	</div>

	<nav class="admin-sidebar-nav" aria-label="Administration Navigation">
		<details class="admin-sidebar-section admin-sidebar-section-collapsible admin-sidebar-public-section" {{ if $isPublicSectionActive }}open data-section-current="true"{{ end }}>
			<summary class="admin-sidebar-section-title">
				<span>&Ouml;ffentliche Seiten</span>
				<i class="ri-arrow-down-s-line admin-sidebar-section-state-icon" aria-hidden="true"></i>
			</summary>
			<div class="admin-sidebar-sub">
				<a href="/reihen/" hx-boost="false" title="Reihen" class="admin-sidebar-link">
					<span class="admin-sidebar-link-label">
						<i class="ri-book-shelf-line admin-sidebar-link-icon" aria-hidden="true"></i>
						<span>Reihen</span>
					</span>
				</a>
				<a href="/personen/" hx-boost="false" title="Personen" class="admin-sidebar-link">
					<span class="admin-sidebar-link-label">
						<i class="ri-group-line admin-sidebar-link-icon" aria-hidden="true"></i>
						<span>Personen</span>
					</span>
				</a>
				<a href="/suche/" hx-boost="false" title="Suche" class="admin-sidebar-link">
					<span class="admin-sidebar-link-label">
						<i class="ri-search-line admin-sidebar-link-icon" aria-hidden="true"></i>
						<span>Suche</span>
					</span>
				</a>
				<div class="admin-sidebar-group">
					<div class="admin-sidebar-group-title admin-sidebar-group-title-prominent">Redaktion</div>
					<div class="admin-sidebar-group-links">
						<a href="/redaktion/einleitung/" hx-boost="false" title="Einleitung" class="admin-sidebar-link admin-sidebar-link-nested">
							<span class="admin-sidebar-link-label">
								<i class="ri-quill-pen-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Einleitung</span>
							</span>
						</a>
						<a href="/redaktion/benutzerhinweise/" hx-boost="false" title="Hinweise" class="admin-sidebar-link admin-sidebar-link-nested">
							<span class="admin-sidebar-link-label">
								<i class="ri-information-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Hinweise</span>
							</span>
						</a>
						<a href="/redaktion/literatur/" hx-boost="false" title="Literatur" class="admin-sidebar-link admin-sidebar-link-nested">
							<span class="admin-sidebar-link-label">
								<i class="ri-book-open-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Literatur</span>
							</span>
						</a>
						<a href="/redaktion/lesekabinett/" hx-boost="false" title="Lesekabinett" class="admin-sidebar-link admin-sidebar-link-nested">
							<span class="admin-sidebar-link-label">
								<i class="ri-archive-drawer-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Lesekabinett</span>
							</span>
						</a>
						<a href="/redaktion/danksagungen/" hx-boost="false" title="Danksagungen" class="admin-sidebar-link admin-sidebar-link-nested">
							<span class="admin-sidebar-link-label">
								<i class="ri-heart-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Danksagungen</span>
							</span>
						</a>
						<a href="/redaktion/kontakt/" hx-boost="false" title="Kontakt" class="admin-sidebar-link admin-sidebar-link-nested">
							<span class="admin-sidebar-link-label">
								<i class="ri-mail-line admin-sidebar-link-icon" aria-hidden="true"></i>
								<span>Kontakt</span>
							</span>
						</a>
					</div>
				</div>
			</div>
		</details>

		<details class="admin-sidebar-section admin-sidebar-section-collapsible admin-sidebar-create-section" {{ if $isCreateSectionActive }}open data-section-current="true"{{ end }}>
			<summary class="admin-sidebar-section-title">
				<span>Neu</span>
				<i class="ri-arrow-down-s-line admin-sidebar-section-state-icon" aria-hidden="true"></i>
			</summary>
			<div class="admin-sidebar-sub">
				<a href="/admin/almanach-new/" title="Neuer Band" class="admin-sidebar-link" {{ if $isNewBandActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-add-circle-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Neuer Band</span></span></a>
				<a href="/admin/reihen/new/" title="Neue Reihe" class="admin-sidebar-link" {{ if $isNewSeriesActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-add-circle-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Neue Reihe</span></span></a>
				<a href="/admin/orte/new/" title="Neuer Ort" class="admin-sidebar-link" {{ if $isNewPlaceActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-add-circle-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Neuer Ort</span></span></a>
				<a href="/admin/personen/new/" title="Neue Person" class="admin-sidebar-link" {{ if $isNewPersonActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-add-circle-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Neue Person</span></span></a>
			</div>
		</details>

		<details class="admin-sidebar-section" open {{ if $isListsSectionActive }}data-section-current="true"{{ end }}>
			<summary class="admin-sidebar-section-title">
				<span>Listen</span>
			</summary>
			<div class="admin-sidebar-sub">
				<a href="/admin/reihen/" title="Reihen" class="admin-sidebar-link" data-admin-main-link data-admin-active-prefixes="/admin/reihen/|/reihen/|/reihe/|/admin/reihe/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}' {{ if $isSeriesActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-book-shelf-fill admin-sidebar-link-icon" aria-hidden="true"></i><span>Reihen</span></span></a>
				<a href="/admin/baende/" title="Bände" class="admin-sidebar-link" data-admin-main-link data-admin-active-prefixes="/admin/baende/|/admin/almanach/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}' {{ if $isBandsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-book-line admin-sidebar-link-icon" aria-hidden="true"></i><span>B&auml;nde</span></span></a>
				<a href="/admin/personen/" title="Personen" class="admin-sidebar-link" data-admin-main-link data-admin-active-prefixes="/admin/personen/|/admin/person/|/personen/|/person/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}' {{ if $isPersonsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-user-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Personen</span></span></a>
				<a href="/admin/orte/" title="Orte" class="admin-sidebar-link" data-admin-main-link data-admin-active-prefixes="/admin/orte/|/admin/ort/" hx-target="#admin-main-content" hx-swap="innerHTML" hx-push-url="true" hx-indicator="#admin-main-loading" hx-headers='{"X-Admin-Main-Nav":"true"}' {{ if $isPlacesActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-map-pin-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Orte</span></span></a>
				<a href="/admin/abkuerzungen/" title="Abkürzungen" class="admin-sidebar-link" {{ if $isAbbreviationsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-text admin-sidebar-link-icon" aria-hidden="true"></i><span>Abk&uuml;rzungen</span></span></a>
				<a href="/admin/seiten/" title="Seiten" hx-boost="false" class="admin-sidebar-link" {{ if $isPagesActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-pages-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Seiten</span></span></a>
			</div>
		</details>

		{{- if $isAdminUser -}}
		<details class="admin-sidebar-section" open {{ if $isAdminSectionActive }}data-section-current="true"{{ end }}>
			<summary class="admin-sidebar-section-title">
				<span>Administration</span>
			</summary>
			<div class="admin-sidebar-sub">
				<a href="/admin/settings/" title="Einstellungen" class="admin-sidebar-link" {{ if $isSettingsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-settings-3-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Einstellungen</span></span></a>
				<a href="/admin/exports/" title="Daten &amp; Export" class="admin-sidebar-link" {{ if $isExportsActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-database-2-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Daten &amp; Export</span></span></a>
				<a href="/admin/user/management/access/User" title="Nutzer einladen" class="admin-sidebar-link" {{ if $isUserInviteActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-key-2-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Nutzer einladen</span></span></a>
				<a href="/admin/user/management" title="Benutzerverwaltung" class="admin-sidebar-link" {{ if $isUserManagementActive }}aria-current="page"{{ end }}><span class="admin-sidebar-link-label"><i class="ri-group-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Benutzerverwaltung</span></span></a>
			</div>
		</details>
		{{- end -}}
	</nav>

	<div class="admin-sidebar-account">
		<div class="admin-sidebar-account-name">
			{{- if and $model.request $model.request.user $model.request.user.Name -}}
				{{ $model.request.user.Name }}
			{{- else -}}
				Account
			{{- end -}}
		</div>
		<div class="admin-sidebar-account-role">
			{{- if and $model.request $model.request.user -}}
				{{- if eq $model.request.user.Role "Admin" -}}
					Administrator
				{{- else if eq $model.request.user.Role "Editor" -}}
					Redaktion
				{{- else -}}
					Benutzer
				{{- end -}}
			{{- else -}}
				Nicht angemeldet
			{{- end -}}
		</div>
		<div class="admin-sidebar-account-links">
			<span class="admin-sidebar-account-icon" title="Konto">
				<i class="ri-user-line" aria-hidden="true"></i>
			</span>
			{{- if $canEditAccount -}}
				<a href="{{ $accountHref }}" title="Bearbeiten" class="admin-sidebar-link admin-sidebar-account-link" {{ if $isProfileActive }}aria-current="page"{{ end }}>
					<span class="admin-sidebar-link-label"><i class="ri-pencil-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Bearbeiten</span></span>
				</a>
			{{- end -}}
			<a href="/logout/?redirectTo=/reihen/" title="Logout" class="admin-sidebar-link admin-sidebar-account-link">
				<span class="admin-sidebar-link-label"><i class="ri-logout-box-r-line admin-sidebar-link-icon" aria-hidden="true"></i><span>Logout</span></span>
			</a>
		</div>
	</div>
</div>
