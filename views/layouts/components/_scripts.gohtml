<script type="module">
	const hash = window.location.hash;
	if (hash) {
		const stripped = hash.slice(1);
		const element = document.getElementById(stripped);
		if (element) {
			element.setAttribute("aria-current", "location");
		}
	}

	const pruneAdminSidebarDetails = () => {
		document.querySelectorAll("[data-admin-main-link]").forEach((link) => {
			if (link.getAttribute("aria-current") === "page") {
				return;
			}
			link.querySelectorAll(".admin-sidebar-link-detail").forEach((detail) => detail.remove());
		});
	};

	const resetStuckNavigationState = () => {
		delete document.documentElement.dataset.htmxBusy;
		if (document.body) {
			delete document.body.dataset.htmxBusy;
		}

		document.querySelectorAll("[data-htmx-busy]").forEach((element) => {
			delete element.dataset.htmxBusy;
			element.removeAttribute("aria-busy");
		});

		document.querySelectorAll("[data-htmx-disabled='true']").forEach((element) => {
			if (element instanceof HTMLButtonElement) {
				element.disabled = false;
			}
			delete element.dataset.htmxDisabled;
		});
	};

	resetStuckNavigationState();
	pruneAdminSidebarDetails();
	document.body.addEventListener("htmx:afterSwap", pruneAdminSidebarDetails);

	const adminStatusOptionMeta = (picker, status) => {
		if (!picker) return null;
		return picker.querySelector(`[data-role="content-status-option"][data-status="${status}"]`);
	};

	const applyAdminStatusPickerState = (picker, status) => {
		if (!picker) return;
		const toggle = picker.querySelector('[data-role="content-status-toggle"]');
		const icon = toggle?.querySelector('i');
		const meta = adminStatusOptionMeta(picker, status) || adminStatusOptionMeta(picker, 'Unknown');
		if (!toggle || !icon || !meta) return;

		const nextStatus = meta.getAttribute('data-status') || 'Unknown';
		const nextLabel = meta.getAttribute('data-label') || 'Unbekannt';
		const nextIcon = meta.getAttribute('data-icon') || 'ri-forbid-2-line';

		toggle.dataset.status = nextStatus;
		toggle.setAttribute('aria-label', `Status: ${nextLabel}`);
		toggle.setAttribute('title', `Status: ${nextLabel}`);
		icon.className = nextIcon;
	};

	const getAdminStatusOpenPicker = () => {
		const picker = window.__adminStatusOpenPicker;
		if (picker && document.body.contains(picker)) {
			return picker;
		}
		window.__adminStatusOpenPicker = null;
		return null;
	};

	const closeAdminStatusPicker = (picker) => {
		if (!picker) return;
		picker.querySelector('[data-role="content-status-menu"]')?.classList.add('hidden');
		if (window.__adminStatusOpenPicker === picker) {
			window.__adminStatusOpenPicker = null;
		}
	};

	window.initAdminStatusPickers = (scope = document) => {
		const root = scope && scope.querySelectorAll ? scope : document;
		const pickers = [];
		if (root.matches?.('[data-role="content-status-picker"]')) {
			pickers.push(root);
		}
		pickers.push(...root.querySelectorAll('[data-role="content-status-picker"]'));
		pickers.forEach((picker) => {
			if (!picker || picker.dataset.init === 'true') {
				return;
			}

			const toggle = picker.querySelector('[data-role="content-status-toggle"]');
			const menu = picker.querySelector('[data-role="content-status-menu"]');
			const endpoint = picker.dataset.statusEndpoint || '';
			const csrfToken = picker.dataset.statusCsrfToken || '';
			if (!toggle || !menu || !endpoint || !csrfToken) {
				return;
			}

			picker.dataset.init = 'true';

			toggle.addEventListener('click', (event) => {
				event.preventDefault();
				event.stopPropagation();
				const willOpen = menu.classList.contains('hidden');
				const openPicker = getAdminStatusOpenPicker();
				if (openPicker && openPicker !== picker) {
					closeAdminStatusPicker(openPicker);
				}
				if (!willOpen) {
					closeAdminStatusPicker(picker);
					return;
				}
				menu.classList.remove('hidden');
				window.__adminStatusOpenPicker = picker;
			});

			menu.querySelectorAll('[data-role="content-status-option"]').forEach((option) => {
				option.addEventListener('click', async (event) => {
					event.preventDefault();
					event.stopPropagation();

					const nextStatus = option.getAttribute('data-status') || 'Unknown';
					const previousStatus = toggle.dataset.status || 'Unknown';
					const previousLastEdited = picker.dataset.lastEdited || '';

					applyAdminStatusPickerState(picker, nextStatus);
					closeAdminStatusPicker(picker);
					toggle.disabled = true;
					toggle.classList.add('opacity-70', 'pointer-events-none');

					const payload = new URLSearchParams();
					payload.set('csrf_token', csrfToken);
					payload.set('status', nextStatus);
					if (previousLastEdited) {
						payload.set('last_edited', previousLastEdited);
					}

					try {
						const response = await fetch(endpoint, {
							method: 'POST',
							headers: {
								'Content-Type': 'application/x-www-form-urlencoded',
							},
							body: payload.toString(),
						});
						const result = await response.json().catch(() => null);
						if (!response.ok || !result?.success) {
							throw new Error(result?.error || 'Status konnte nicht gespeichert werden.');
						}
						if (result.last_edited) {
							picker.dataset.lastEdited = result.last_edited;
						}
						applyAdminStatusPickerState(picker, result?.status || nextStatus);
					} catch {
						applyAdminStatusPickerState(picker, previousStatus);
						if (previousLastEdited) {
							picker.dataset.lastEdited = previousLastEdited;
						}
					} finally {
						toggle.disabled = false;
						toggle.classList.remove('opacity-70', 'pointer-events-none');
					}
				});
			});
		});
	};

	window.initAdminStatusPickers(document);
	document.body.addEventListener('htmx:afterSwap', (event) => {
		window.initAdminStatusPickers(event.target || document);
	});
	window.addEventListener("pageshow", () => {
		resetStuckNavigationState();
		pruneAdminSidebarDetails();
		closeAdminStatusPicker(getAdminStatusOpenPicker());
		window.initAdminStatusPickers(document);
	});

	document.addEventListener('click', (event) => {
		const openPicker = getAdminStatusOpenPicker();
		if (!openPicker || openPicker.contains(event.target)) return;
		closeAdminStatusPicker(openPicker);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		closeAdminStatusPicker(getAdminStatusOpenPicker());
	});
</script>
