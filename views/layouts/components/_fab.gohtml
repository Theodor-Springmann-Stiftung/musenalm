{{- if and .request.user (IsAdminOrEditor .request.user) -}}
{{- $displayName := .request.user.Email -}}
{{- if .request.user.Name -}}
	{{- $displayName = .request.user.Name -}}
{{- end -}}
<div
	x-data="{ open: false }"
	x-id="['visitor-admin-fab']"
	@keydown.escape.window="open = false"
	@click.outside="open = false"
	hx-boost="false"
	class="fixed bottom-6 left-6 z-40">
	<div
		x-cloak
		x-show="open"
		x-transition.opacity.scale.origin.bottom.left.duration.150ms
		class="absolute bottom-14 left-0 w-[17rem] overflow-hidden rounded-xs border border-stone-300 bg-white shadow-lg">
		<div class="border-b border-stone-200 px-3 pt-2 pb-1.5">
			<div class="leading-none text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-stone-500">Neu</div>
		</div>
		<div class="py-1">
			<a href="/admin/almanach-new/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-book-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Neuer Band</span>
			</a>
			<a href="/admin/reihen/new/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-book-shelf-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Neue Reihe</span>
			</a>
			<a href="/admin/personen/new/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-user-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Neue Person</span>
			</a>
			<a href="/admin/orte/new/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-map-pin-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Neuer Ort</span>
			</a>
		</div>

		<div class="border-b border-stone-200 px-3 pt-2 pb-1.5">
			<div class="leading-none text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-stone-500">Entitäten</div>
		</div>
		<div class="py-1">
			<a href="/admin/reihen/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-book-shelf-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Reihen</span>
			</a>
			<a href="/admin/baende/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-book-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Bände</span>
			</a>
			<a href="/admin/beitraege/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-article-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Beiträge</span>
			</a>
			<a href="/admin/personen/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-user-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Personen</span>
			</a>
			<a href="/admin/orte/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-map-pin-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Orte</span>
			</a>
			<a href="/admin/abkuerzungen/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-text text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Abkürzungen</span>
			</a>
			<a href="/admin/seiten/" class="flex items-center gap-2.5 px-3 py-2 text-[0.95rem] text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-pages-line text-[1rem] text-slate-600" aria-hidden="true"></i>
				<span>Seiten</span>
			</a>
		</div>

		<div class="border-t border-stone-200">
			<a href="/admin/" class="flex items-center gap-2.5 px-3 py-2.5 text-slate-800 no-underline transition-colors hover:bg-stone-100">
				<i class="ri-user-3-line text-[1rem] text-slate-600 shrink-0" aria-hidden="true"></i>
				<div class="flex flex-col min-w-0">
					<span class="text-[0.72rem] italic text-slate-600 truncate leading-tight">Admin-Bereich</span>
					<span class="text-[0.95rem] font-semibold leading-snug">{{ $displayName }}</span>
				</div>
			</a>
		</div>
	</div>

	<button
		type="button"
		@click="open = !open"
		:aria-expanded="open"
		:aria-label="open ? 'Admin-Menü schließen' : 'Admin-Menü öffnen'"
		:title="open ? 'Admin-Menü schließen' : 'Admin-Menü öffnen'"
		class="inline-flex h-11 w-11 items-center justify-center rounded-xs border border-stone-400 bg-white text-slate-700 shadow-sm transition-colors hover:bg-stone-100 hover:text-slate-950">
		<i class="ri-menu-line text-[1.15rem]" x-show="!open" aria-hidden="true"></i>
		<i class="ri-close-line text-[1.15rem]" x-show="open" x-cloak aria-hidden="true"></i>
	</button>
</div>
{{- end -}}
